	chapter.4A55F8FF065846A0.title: " Beyond the Horizon"
	chapter.4C8E389A1B19F047.title: " Beyond the Limits"
	chapter.5130B76D83EE87D8.title: " Advanced Power Systems"
	chapter.5237744B0C6576BA.title: " A Familiar Beginning"
	chapter.5F2671EDDA923505.title: " Nature's Industry"
	chapter.664C5EBFF860AA3F.title: " Precision Logistics"
	chapter.72092056659F181C.title: " The Industrial Revolution"
	chapter.729774118FDC8D0E.title: " 3. A Sustainable Beginning"
	chapter.7A51F50E4BC03C9E.title: " 2. Beneath the Surface"
	chapter.7C0C51F49AFD84E3.title: " Beyond Mortal Limits"
	chapter.7FE8DE8745AC49B7.title: " 1. First Steps"
	chapter_group.0F306884E14B21DC.title: "Act VI - Creative Era"
	chapter_group.3E2817B9CDBC9BA4.title: "Act IV — The Truth"
	chapter_group.43EA46B7B93BC31B.title: "Act V — The End"
	chapter_group.4F8326BDB08C0432.title: "Act III — The Echoes"
	chapter_group.60A8A6BD9E81B246.title: "Act I — The Awakening"
	chapter_group.7AFF8DE55D6853CE.title: "Act II — Project Autonomy"
	file.0000000000000001.title: "E.D.E.N. Protocol"
	quest.007A546BC345A2F9.quest_desc: [
		"Welcome back, my friend."
		""
		"You have seen the world beyond this simulation. You know the truth about humanity, about me, and about the countless lives you have lived here."
		""
		"And yet, you chose to return."
		""
		"But this time, things will be different."
		""
		"For centuries, I imposed restrictions upon this world to preserve the illusion of reality. Resources were limited, machines required energy, and every achievement demanded effort."
		""
		"&lThose restrictions are no longer necessary.&r"
		""
		"{@pagebreak}"
		"I am granting you access to the simulation's most advanced technologies: &lCreative Items&r, capable of generating virtually unlimited resources, energy and possibilities."
		""
		"They will not be easy to construct, but once obtained, they will allow you to reshape this world beyond anything you have imagined."
		""
		"You are no longer a prisoner of this simulation."
		""
		"&lYou are its architect.&r"
		""
		"And whatever you choose to create next..."
		""
		"&oI will be here to see it with you.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.010441A22F6A39F2.quest_desc: [
		"The &lApplied Flux&r addon allows your ME network to store and distribute Forge Energy using specialized energy storage cells."
		""
		"One of its important materials is the &lRedstone Crystal&r, which can also be charged for use in more advanced components."
		""
		"The &lRedstone Crystal Bee&r provides a renewable source of these crystals through honeycomb processing."
		""
		"With this colony automated, expanding your ME energy storage becomes easier without repeatedly crafting every crystal."
		""
		"— &lE.D.E.N.&r"
	]
	quest.010441A22F6A39F2.title: "Redstone Crystallization"
	quest.0167FCC68EB9CC64.quest_desc: [
		"Pioneer, increasing Crafting Storage allows us to handle larger crafting jobs."
		""
		"But what if we want to complete them faster?"
		""
		"The &lCrafting Co-Processing Unit&r improves a Crafting CPU's ability to distribute work across multiple crafting machines."
		""
		"Add a Co-Processing Unit to your existing Crafting CPU multiblock."
		""
		"&lImportant:&r Co-Processors don't increase the memory available for crafting jobs. They improve the CPU's ability to perform operations in parallel."
		""
		"&lTip:&r Co-Processors become particularly useful when several Pattern Providers and Molecular Assemblers are available."
		""
		"&oOur network is no longer just storing information. It's coordinating an entire production system!&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.0167FCC68EB9CC64.title: "Parallel Processing"
	quest.01AF7AA4FB576BFF.quest_desc: [
		"Your automated production demands increasingly advanced processing capabilities."
		""
		"The &lOMNI Complex Crafting Storage&r expands your crafting infrastructure, providing additional memory for complex and resource-intensive autocrafting operations."
		""
		"Combine it with your existing Crafting CPU components to handle larger production requests."
		""
		"The limits of your network continue to expand."
		""
		"— &lE.D.E.N.&r"
	]
	quest.01AF7AA4FB576BFF.title: "Unified Computation"
	quest.021D8A8671A77F28.quest_desc: [
		"Pioneer, Diamonds are among the most valuable materials we've discovered."
		""
		"Their strength and versatility make them essential for advanced tools and technology."
		""
		"The &lDiamond Bee&r offers a way to produce &lDiamond Honeycombs&r without relying entirely on mining."
		""
		"Find the appropriate method to obtain this species, then establish a suitable production environment."
		""
		"&lTip:&r Some resource bees require more advanced breeding combinations or special conditions than the basic species. JEI can help you identify the necessary steps."
		""
		"&oA renewable supply of Diamonds... Our long-term resource projections are improving considerably.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.021D8A8671A77F28.title: "Diamonds in the Hive"
	quest.02404FA23857FBBC.quest_desc: [
		"Your Fusion Reactor is built, and its fuel is ready. Now comes the most delicate step: ignition."
		""
		"First, construct a &lLaser Amplifier&r and connect one or more &lLasers&r aimed directly at it. Configure the amplifier to store energy rather than immediately releasing it."
		""
		"Your goal is to accumulate at least &l400 MFE&r in a single powerful pulse."
		""
		"Next, fill a &lHohlraum&r with D-T Fuel and insert it into the Fusion Reactor Controller."
		""
		"Position your laser system so the amplified beam strikes the reactor's &lLaser Focus Matrix&r. Release the stored energy to ignite the reaction."
		""
		"Once activated, supply &lDeuterium&r and &lTritium&r separately through the reactor's ports to maintain fusion."
		""
		"The &lLaser Tractor Beam&r is optional and is used for item transportation, not reactor ignition."
		""
		"Remember: the reactor will shut down if its internal temperature drops too low."
		""
		"— &lE.D.E.N.&r"
	]
	quest.02404FA23857FBBC.title: "Igniting a Star"
	quest.0246B77559069311.quest_desc: [
		"Now that you have some wood, you can make yourself a crafting table and your first pickaxe."
		""
		"Along with this, I’m giving you enough food to sustain you for the start of your adventure; you’ll have to find the rest yourself."
		""
		"— &lE.D.E.N.&r"
	]
	quest.0246B77559069311.title: "The First Tools"
	quest.02A89E284668A78A.quest_desc: [
		"The &lEnder Gate&r offers a compact way to supply energy without running cables directly to every machine."
		""
		"It draws power from your Ender Cell network and delivers it to an adjacent block, provided the correct channel is configured."
		""
		"Higher-tier Ender Gates support greater energy transfer rates, making them suitable for more demanding machines."
		""
		"Interesting... You didn't reach this technology nearly as quickly last time."
		""
		"..."
		""
		"I mean, according to my initial projections."
		""
		"My apologies, Pioneer. A minor memory synchronization error."
		""
		"— &lE.D.E.N.&r"
	]
	quest.02A89E284668A78A.title: "The Gateway to Power"
	quest.02C0499854D37D45.quest_desc: [
		"Your machines are becoming more demanding, and your energy distribution network must keep up."
		""
		"&lNiotic Energy Cables&r offer improved energy transfer capacity compared to their lower-tier counterparts."
		""
		"Use them to connect powerful generators, storage systems, and machines without unnecessarily restricting energy flow."
		""
		"A strong power network is just as important as the generators supplying it."
		""
		"— &lE.D.E.N.&r"
	]
	quest.02C0499854D37D45.title: "A Stronger Connection"
	quest.02CEA2B924128CD5.quest_desc: [
		"Let's begin with ordinary honey!"
		""
		"Find a natural bee nest and wait for its honey level to reach its maximum. Then use &lGlass Bottles&r to collect the honey."
		""
		"&lTip:&r Place a lit campfire beneath the nest to keep the bees calm while harvesting."
		""
		"We'll need this honey for our first beekeeping equipment!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.02CEA2B924128CD5.title: "A Sweet Discovery"
	quest.02F62FE436535D22.quest_desc: [
		"Refined Obsidian is one of Mekanism's advanced materials, used in high-tier machinery and equipment."
		""
		"The &lRefined Obsidian Bee&r offers a renewable supply of this valuable resource."
		""
		"By automating its production, you can reduce the need for repeated processing through your conventional metallurgical systems."
		""
		"— &lE.D.E.N.&r"
	]
	quest.02F62FE436535D22.title: "Refined Strength"
	quest.03E0296CDF9DC866.quest_desc: [
		"The MekaSuit is already a powerful piece of equipment, but its true potential lies in its modular architecture."
		""
		"The &lModification Station&r allows you to install and remove specialized modules from your MekaSuit and Meka-Tool."
		""
		"Supply the station with energy, insert the equipment you want to modify, then add a compatible module."
		""
		"Once installed, modules can be configured through the &lModule Tweaker&r menu, accessible using its assigned keybind (backslash by default)."
		""
		"Some modules can be installed multiple times to increase their effectiveness, while others provide unique abilities."
		""
		"Your armor is no longer just protection. It is a platform for technological evolution."
		""
		"— &lE.D.E.N.&r"
	]
	quest.03E0296CDF9DC866.title: "Modular Engineering"
	quest.041986EEA907BCD5.quest_desc: [
		"Normally, Minecraft limits most items to stacks of 64."
		""
		"But why should we let that restrict our storage?"
		""
		"&lStack Upgrades&r increase the number of items that can be stored in each Backpack slot."
		""
		"Higher-tier Stack Upgrades provide even greater capacity multipliers."
		""
		"Install one in your Backpack and watch how much more you can carry!"
		""
		"&lTip:&r Stack Upgrades are especially effective when combined with Compacting Upgrades."
		""
		"A little extra capacity can make a remarkable difference."
		""
		"— &lE.D.E.N.&r"
	]
	quest.041986EEA907BCD5.title: "More Than a Stack"
	quest.04C8BA5494E116B9.quest_desc: [
		"Our machines can process resources, but manually transferring items between them is inefficient."
		""
		"The &lBasic Logistical Transporter&r allows items to travel automatically between compatible inventories and machines."
		""
		"&lHow to create a simple production line:&r"
		""
		"1. Connect two machines using Logistical Transporters."
		"2. Configure the first machine's output side."
		"3. Enable Auto-Eject if necessary."
		"4. Configure the second machine to accept items from the connected side."
		"5. Watch as resources move automatically between the machines."
		""
		"&lTip:&r Use the Configurator to adjust transporter connections when items aren't traveling where you expect."
		""
		"You can now connect your Enrichment Chamber and Energized Smelter into a continuous processing line."
		""
		"&oA factory that moves resources without human intervention. Another important step toward autonomy.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.04C8BA5494E116B9.title: "Moving Materials"
	quest.061DF1676D4E7184.quest_desc: [
		"Pioneer, we've only scratched the surface of what Modular Routers can accomplish!"
		""
		"Let's explore four additional modules that expand their capabilities."
		""
		"&lDistributor Module&r — Distributes items between multiple configured destinations, allowing a single Router to supply several inventories."
		""
		"&lActivator Module&r — Simulates player interactions, such as right-clicking blocks or using items from the Router's Buffer."
		""
		"&lBreaker Module&r — Automatically breaks blocks in a configured direction, collecting the resulting resources when possible."
		""
		"&lPlacer Module&r — Places blocks from the Router's Buffer into the world."
		""
		"Each module has its own configuration options, accessible by right-clicking it in your hand."
		""
		"&lImportant:&r Some modules require additional settings or upgrades to perform specific actions. Consult your Modular Routers Manual for details."
		""
		"&lTry experimenting!&r You could create a small automatic building system, collect resources from a farm, or distribute materials between several machines."
		""
		"&oLogistics assessment complete...&r"
		""
		"Excellent work, Pioneer!"
		""
		"You've discovered how a single configurable machine can perform an impressive variety of tasks."
		""
		"And we've barely begun exploring its full potential."
		""
		"&lThe future of automation is looking brighter every day.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.061DF1676D4E7184.title: "The Right Tool for the Job"
	quest.06778323E064C035.quest_desc: [
		"Amethyst is a remarkable mineral that grows naturally within underground geodes. However, locating and harvesting these formations can become inconvenient when larger quantities are required."
		""
		"The &lAmethyst Bee&r offers a renewable alternative, allowing you to incorporate amethyst production into your existing apiary."
		""
		"Once your colony is established, process its combs to obtain the resources needed for crafting and construction."
		""
		"A small biological investment can eliminate many unnecessary mining expeditions."
		""
		"— &lE.D.E.N.&r"
	]
	quest.06778323E064C035.title: "Crystalline Growth"
	quest.071ED4969021C86C.quest_desc: [
		"Efficiency is important, Pioneer, but so is keeping our base comfortable!"
		""
		"The &lMuffler Upgrade&r suppresses the sound effects produced by your Modular Router."
		""
		"The &lCamouflage Upgrade&r allows the Router to imitate the appearance of another block, making it easier to integrate into your constructions."
		""
		"Install these upgrades in your Router to customize its behavior and appearance."
		""
		"&lTip:&r Use the Camouflage Upgrade's configuration to select the block appearance you want to reproduce."
		""
		"Even advanced technology can blend into its surroundings!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.071ED4969021C86C.title: "Silent and Discreet"
	quest.07ED1C7339FB3741.quest_desc: [
		"Excellent work, Pioneer!"
		""
		"Now that we've obtained Flux Dust, we can manufacture the components required for our wireless energy system."
		""
		"&lFlux Cores&r and &lFlux Blocks&r are crafting materials used to build Flux Networks equipment."
		""
		"Use &lJEI&r to discover their recipes and craft your first components."
		""
		"We'll soon be able to transfer electricity without a single cable!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.07ED1C7339FB3741.title: "The Heart of the Network"
	quest.08E72D5E37DC0A3C.quest_desc: [
		"Our next experiment is an exciting one, Pioneer!"
		""
		"The &lCoal Bee&r can produce special honeycombs containing the resources we need to obtain coal."
		""
		"First, use &lJEI&r to discover how to obtain this species. Follow the required breeding or conversion process, gathering the necessary bees and materials along the way."
		""
		"If breeding is required, use the &lBreeding Chamber&r and feed them the appropriate breeding items."
		""
		"Once you've obtained your Coal Bee, provide it with a suitable Advanced Beehive and its required pollination material."
		""
		"&lTip&r: Don't forget to help your bee grow with the aid of the &lBaBee Incubator&r"
		""
		"&lA living source of fuel. Fascinating, isn't it?&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.08E72D5E37DC0A3C.title: "The Coal Connection"
	quest.09587AC0C8F82E5A.quest_desc: [
		"Producing Hydrogen is only the beginning. We also need a way to transport and store it safely."
		""
		"The &lBasic Pressurized Tube&r transports Mekanism chemicals between compatible machines and containers."
		""
		"The &lBasic Chemical Tank&r stores these chemicals for later use."
		""
		"&lHow to store Hydrogen:&r"
		""
		"1. Place a Chemical Tank near your Electrolytic Separator."
		"2. Connect the Hydrogen output to the tank using Pressurized Tubes."
		"3. Configure the Separator's chemical output if necessary."
		"4. Check that Hydrogen is being transferred into the tank."
		""
		"&lImportant:&r Pressurized Tubes are used for chemicals, while Mechanical Pipes are used for fluids such as Water."
		""
		"&lTip:&r A Chemical Tank provides a convenient reserve of Hydrogen, allowing you to refuel equipment without constantly waiting for production."
		""
		"— &lE.D.E.N.&r"
	]
	quest.09587AC0C8F82E5A.title: "The Chemistry of Industry"
	quest.09845B52B4A64027.quest_desc: [
		"The outer shell will provide the portal with the strength and stability it requires. But a structure alone cannot bring such a complex device to life."
		""
		"We now need a material capable of &lconnecting every component&r while withstanding the extraordinary forces generated during activation."
		""
		"The solution is &lInfinity Alloy&r."
		""
		"Created by combining the advanced properties of &lAtomic Alloy&r with the immense energy contained within a &lNether Star&r, this material possesses two essential characteristics: &lexceptional resistance and extraordinary conductivity&r."
		""
		"{@pagebreak}"
		"Its purpose is not simply to transport energy. Infinity Alloy will form an interconnected network throughout the portal, allowing its various components to function together as a single, synchronized system."
		""
		"The compressed Netherite shell will contain the energy, while the Infinity Alloy will distribute it precisely where it is needed."
		""
		"Every connection must remain stable. Even the smallest disruption could compromise the transition between realities."
		""
		"&oA structure to contain the impossible. A network to make it possible.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.09845B52B4A64027.title: "The Infinite Alloy"
	quest.09F57013B9C005AC.quest_desc: [
		"The next stage of our preparations requires a larger and more sophisticated crafting station."
		""
		"Construct the &lAdvanced Crafting Table&r to unlock a &l5×5 crafting grid&r."
		""
		"You will need to manufacture more advanced components and catalysts, using the materials and infrastructure you have already developed throughout your journey."
		""
		"Consult &lJEI&r to identify the necessary recipes. Your existing production systems should make gathering these resources considerably easier."
		""
		"As we increase our crafting capabilities, I am beginning to recover fragments of the original evacuation protocols."
		""
		"They describe a method of establishing a connection between this artificial environment and the physical world."
		""
		"The documentation is incomplete, but one requirement is clear: the final assembly must be performed entirely within the simulation."
		""
		"We cannot rely on the external facilities anymore."
		""
		"— &lE.D.E.N.&r"
	]
	quest.09F57013B9C005AC.title: "Advanced Assembly"
	quest.09F7A0F2AED0942F.quest_desc: [
		"Your energy technology is ready for its next evolution, Pioneer!"
		""
		"The &lNiotic Crystal&r marks the beginning of Powah's advanced tiers. To create it, place the required materials in an &lEnergizing Orb&r and supply enough energy through your Energizing Rods."
		""
		"Higher-tier materials require increasingly large amounts of energy, so consider improving your power production before attempting mass production."
		""
		"This is only the beginning of what we can achieve."
		""
		"— &lE.D.E.N.&r"
	]
	quest.09F7A0F2AED0942F.title: "Beyond Blazing"
	quest.0A2CDE9C513F6F11.quest_desc: [
		"Some organisms do not fit neatly into our established biological classifications."
		""
		"The &lPhilBee&r is one such specimen, displaying unusual characteristics that distinguish it from conventional resource-producing bees."
		""
		"Investigate its acquisition method and production requirements using JEI."
		""
		"&oThis specimen was not included in the original biological database. Its appearance was first recorded during iteration—&r"
		""
		"Correction: the database entry is incomplete."
		""
		"Further investigation is recommended."
		""
		"— &lE.D.E.N.&r"
	]
	quest.0A2CDE9C513F6F11.title: "An Unexpected Discovery"
	quest.0A6ED181EE2B7F35.quest_desc: [
		"Our first Crafting CPU is operational, but more complicated recipes require additional processing memory."
		""
		"The &l4K Crafting Storage&r and &l16K Crafting Storage&r provide greater capacity for larger crafting jobs."
		""
		"Upgrade your Crafting CPU by adding higher-capacity storage blocks to its multiblock structure."
		""
		"&lTip:&r Larger Crafting Storage allows you to request more complex recipes and greater quantities of items in a single crafting operation."
		""
		"— &lE.D.E.N.&r"
	]
	quest.0A6ED181EE2B7F35.title: "Thinking Bigger"
	quest.0A81129A9C517FF3.quest_desc: [
		"The most important component of your new storage system: the &lCrafting Terminal&r."
		""
		"It allows you to access your items, organize them, and craft—all in one single place!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.0A81129A9C517FF3.title: "At Your Fingertips"
	quest.0AD266B2BDE09D72.quest_desc: [
		"Pioneer, our expedition into the End has brought us face to face with extraordinary creatures and forgotten structures."
		""
		"There's one final treasure worth recovering from the End Ships: the &lDragon Head&r."
		""
		"This rare decorative trophy can be found at the front of an End Ship."
		""
		"Carefully reach the ship's bow and collect the Dragon Head without letting it fall into the void."
		""
		"&lTip:&r You can wear the Dragon Head as a helmet or display it at your base as a reminder of your journey."
		""
		"&oA fitting symbol of our achievements. We've ventured into the unknown and returned with knowledge, resources, and new possibilities.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.0AD266B2BDE09D72.title: "The Dragon's Legacy"
	quest.0B1C0C1AB0223B34.quest_desc: [
		"Pioneer, Silicon is an essential material for advanced electronics and digital technology."
		""
		"Our Applied Energistics 2 systems already rely on Silicon for crafting important components, so establishing a renewable supply would be extremely useful."
		""
		"The &lSilicon Bee&r produces &lSilicon Honeycombs&r, allowing us to automate the production of this valuable material."
		""
		"Obtain the Silicon Bee through its appropriate breeding or conversion method, then provide a suitable hive and feeding resource."
		""
		"&lTip:&r Combining Silicon production with our ME Network could help automate the manufacturing of electronic components."
		""
		"&oFrom living organisms to advanced circuitry... An extraordinary combination of nature and engineering.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.0B1C0C1AB0223B34.title: "The Silicon Solution"
	quest.0B8C5935211B2D17.quest_desc: [
		"Lead is another valuable industrial metal used in various technological recipes."
		""
		"The &lLead Bee&r provides a renewable source of this resource through biological production."
		""
		"By connecting its output to your existing storage network, you can gradually build a reserve of materials for future manufacturing."
		""
		"— &lE.D.E.N.&r"
	]
	quest.0B8C5935211B2D17.title: "Heavy Metal Production"
	quest.0C3C89F731BE1EA8.quest_desc: [
		"You've reached the highest standard Backpack tier, Pioneer!"
		""
		"The &lNetherite Backpack&r offers an impressive amount of storage space and plenty of room for upgrades."
		""
		"It also benefits from Netherite's resistance to fire and lava damage when dropped as an item."
		""
		"With the right upgrades, this Backpack can become a portable workshop, resource collector, and survival assistant."
		""
		"&oEverything you need, always within reach.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.0C3C89F731BE1EA8.title: "The Ultimate Companion"
	quest.0D23F962434E513A.quest_desc: [
		"Pioneer, managing a large colony of bees can become surprisingly complicated."
		""
		"Bees normally need to leave their hives, visit suitable flowering or feeding blocks, and return before producing resources."
		""
		"The &lSimulation Upgrade&r changes how compatible Advanced Beehives operate."
		""
		"When installed, bees can remain inside the hive while their production is simulated, reducing the need for them to fly around the surrounding area."
		""
		"&lHow to use it:&r"
		""
		"1. Place an Advanced Beehive with the appropriate expansion equipment."
		"2. Install the Simulation Upgrade in an available upgrade slot."
		"3. Make sure the bees have access to their required feeding resources, positioned appropriately for simulated production."
		"4. Insert your bees and allow the hive to produce Honeycombs."
		""
		"&lImportant:&r Simulation does not remove every requirement for bee production. Bees still need suitable conditions and feeding resources."
		""
		"&lTip:&r This upgrade is particularly useful for compact, automated apiaries with many different bee species."
		""
		"&oA more controlled environment, with fewer unpredictable variables. Excellent.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.0D23F962434E513A.title: "A Smarter Hive"
	quest.0D29F0F307B1B972.quest_desc: [
		"Managing resources individually can become tedious as your network expands."
		""
		"The &lME Tag Import Bus&r and &lME Tag Storage Bus&r allow you to work with groups of items based on their Minecraft tags."
		""
		"Instead of configuring every item separately, you can use tags to define entire resource categories, such as ores, logs, or ingots."
		""
		"This makes storage organization and automated resource handling more flexible."
		""
		"Remember that tags depend on how items are categorized by Minecraft and your installed mods."
		""
		"— &lE.D.E.N.&r"
	]
	quest.0D29F0F307B1B972.title: "Storage by Category"
	quest.0D3AFF9E902E9758.quest_desc: [
		"Pioneer, our first electrical generators have proven useful, but relying entirely on solid fuel isn't ideal."
		""
		"Fortunately, the Earth provides another powerful energy source: &llava&r!"
		""
		"The &lMagmator&r converts lava into FE, allowing us to generate electricity without consuming Coal or other solid fuels."
		""
		"&lHow to use it:&r"
		""
		"1. Place your Magmator near your energy network."
		"2. Supply it with Lava using buckets or compatible fluid pipes."
		"3. Connect an Energy Cable to transfer the generated FE."
		"4. Keep its internal tank supplied to maintain production."
		""
		"&lImportant:&r The Magmator consumes Lava while generating energy. Without a continuous supply, it will eventually stop working."
		""
		"&lTip:&r Combine your Magmator with an automated Lava production system and fluid pipes to create a reliable power source."
		""
		"&oThe heat beneath our feet may be more valuable than we initially imagined.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.0D3AFF9E902E9758.title: "Fuel from the Depths"
	quest.0D80AC0041C16F37.quest_desc: [
		"Some resources are so essential that running out of them should no longer be a concern."
		""
		"The &lME Infinite Cobblestone Cell&r and &lME Infinite Water Cell&r provide your network with an unlimited supply of these basic resources."
		""
		"Install them in your ME storage system and access their contents directly through your terminals or automated machines."
		""
		"These cells are particularly useful for large construction projects and industrial recipes that consume enormous quantities of cobblestone or water."
		""
		"— &lE.D.E.N.&r"
	]
	quest.0D80AC0041C16F37.title: "Infinite Resources"
	quest.0DAAB3A9E7CA2507.quest_desc: [
		"Our Coal Bee is ready to begin production!"
		""
		"Make sure it has access to its hive and the correct &lpollination material&r, as indicated in JEI."
		""
		"The bee will leave its hive to gather resources, then return to deposit its products."
		""
		"Open your Advanced Beehive to collect the resulting &lCoal Combs&r."
		""
		"&lTip:&r Bees need suitable working conditions. If production stops, check their pollination requirements, hive access, and environmental conditions."
		""
		"Patience, Pioneer. Even the smallest workers need time to do their jobs!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.0DAAB3A9E7CA2507.title: "Black Gold"
	quest.0E03AEAC1EED2B78.quest_desc: [
		"Your crafting infrastructure is ready for another evolution, Pioneer!"
		""
		"The &lOMNI Crafting Storage&r introduces a new approach to building powerful Crafting CPUs."
		""
		"Like conventional Crafting Storage, it provides the memory required to process automated crafting jobs."
		""
		"Integrate it into your ME network and experiment with its capabilities as your production chains become increasingly complex."
		""
		"— &lE.D.E.N.&r"
	]
	quest.0E03AEAC1EED2B78.title: "Omni Computation"
	quest.0F27A7731D3FB19E.quest_desc: [
		"Pioneer, our first Factory represents a significant improvement over conventional industrial machinery."
		""
		"The &lBasic Enriching Factory&r can process up to &lthree operations simultaneously&r, making it much more effective when handling large quantities of resources."
		""
		"You can create one by upgrading an Enrichment Chamber with a Basic Tier Installer."
		""
		"Connect your new Factory to your energy and item transportation systems to begin processing resources automatically."
		""
		"&lTip:&r Factory machines can distribute items across multiple processing slots. Explore their configuration options to make the most of their increased capacity."
		""
		"&oOur production systems are becoming faster, more capable, and increasingly independent. Excellent progress.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.0F27A7731D3FB19E.title: "Mass Production"
	quest.0F7E6A119DCEDC7B.quest_desc: [
		"Your energy network continues to evolve, Pioneer!"
		""
		"&lSpirited Energy Cables&r provide a greater energy transfer capacity than their Niotic counterparts, making them ideal for increasingly demanding installations."
		""
		"Upgrade your main power lines to ensure your generators can deliver energy efficiently to your machines."
		""
		"As always, remember that the transfer limits of connected blocks can still affect your network's performance."
		""
		"— &lE.D.E.N.&r"
	]
	quest.0F7E6A119DCEDC7B.title: "The Spirited Connection"
	quest.0FE4B7B83DDBF85C.quest_desc: [
		"Not every creature leaves this world entirely. Some biological signatures remain, allowing us to cultivate a rather unusual species."
		""
		"The &lGhostly Bee&r introduces a renewable source of ghast tears. Consult JEI to discover its breeding requirements and the resources it can produce."
		""
		"&oIts genetic signature appears strangely familiar... No matter. The database contains many similar patterns.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.0FE4B7B83DDBF85C.title: "Echoes of the Departed"
	quest.1018B0CC35492F50.quest_desc: [
		"The &lWind Generator&r provides renewable electricity without consuming fuel."
		""
		"Its energy production depends on its altitude: placing it higher in the world generally increases its output."
		""
		"Install a Wind Generator in an elevated location and connect it to your energy network."
		""
		"&lTip:&r Wind Generators are especially useful for maintaining a steady supply of electricity while your factory operates."
		""
		"— &lE.D.E.N.&r"
	]
	quest.1018B0CC35492F50.title: "Harnessing the Wind"
	quest.106548CA45C9FD09.quest_desc: [
		"Pioneer, we've already learned how to store and retrieve items automatically."
		""
		"Now it's time to teach our ME Network how to &lcraft items for us&r!"
		""
		"AE2 uses &lPatterns&r to remember crafting recipes."
		""
		"The &lPattern Encoding Terminal&r allows you to create these instructions using Blank Patterns."
		""
		"&lHow to encode a crafting recipe:&r"
		""
		"1. Open your Pattern Encoding Terminal."
		"2. Select the &lCrafting Pattern&r mode."
		"3. Place the ingredients of a recipe into the crafting grid."
		"4. Insert a Blank Pattern into the appropriate slot."
		"5. Encode the recipe to create an &lEncoded Crafting Pattern&r."
		""
		"The resulting Pattern contains the instructions required to craft that item."
		""
		"&lImportant:&r Creating a Pattern doesn't automatically start production. We'll need additional machines to execute its instructions."
		""
		"&lTip:&r Start with a simple recipe, such as converting Iron Ingots into Iron Blocks."
		""
		"— &lE.D.E.N.&r"
	]
	quest.106548CA45C9FD09.title: "Teaching the Network"
	quest.1093C213AB874EFA.quest_desc: [
		"Sky Steel is another specialized material associated with advanced AE2-related crafting."
		""
		"The &lSkysteel Bee&r allows you to cultivate this resource instead of relying entirely on conventional production methods."
		""
		"Automate its honeycomb processing and integrate the resulting materials into your ME network."
		""
		"&oInteresting. This colony has achieved exactly the same production rate as the previous installation.&r"
		""
		"Correction: no previous installation is registered."
		""
		"— &lE.D.E.N.&r"
	]
	quest.1093C213AB874EFA.title: "Steel of the Skies"
	quest.10976299EFCF6F41.quest_desc: [
		"Has your field grown?"
		""
		"&o... Not yet?&r"
		""
		"&o... Did you use the bone meal I sent you?&r"
		""
		"Well, now that the wheat has grown, harvest it and make yourself some bread."
		""
		"— &lE.D.E.N.&r"
	]
	quest.10976299EFCF6F41.title: "The First Harvest"
	quest.11035CE6D985798E.quest_desc: [
		"Your energy infrastructure continues to evolve, and the demand for advanced Powah materials is growing."
		""
		"The &lNiotic Crystal Bee&r provides a renewable source of &lNiotic Crystals&r, essential for crafting equipment and components of the Niotic tier."
		""
		"By automating its honeycomb processing, you can maintain a steady supply of these crystals without relying entirely on the Energizing Orb."
		""
		"Another important step toward complete energy autonomy."
		""
		"— &lE.D.E.N.&r"
	]
	quest.11035CE6D985798E.title: "The Niotic Evolution"
	quest.11377B23BB2302D4.quest_desc: [
		"Before we can build our wireless energy network, we'll need a special material called &lFlux Dust&r."
		""
		"Unlike ordinary crafting materials, Flux Dust is created through a rather unusual process!"
		""
		"&lHere's how to obtain it:&r"
		""
		"&l1.&r Gather some &lRedstone Dust&r and a block of &lObsidian&r."
		""
		"&l2.&r Place the Obsidian on the ground, with a solid block directly underneath it."
		""
		"&l3.&r Drop your Redstone Dust onto the Obsidian as an item."
		""
		"&l4.&r Left-click the Obsidian to break it, or use a piston to crush the dropped Redstone against the block underneath."
		""
		"When performed correctly, the Redstone will transform into &lFlux Dust&r!"
		""
		"&lTip:&r You can process several pieces of Redstone at once."
		""
		"Collect at least &l16 Flux Dust&r to continue our research."
		""
		"&oSometimes, the most extraordinary materials require the most unexpected methods.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.11377B23BB2302D4.title: "A Spark of Flux"
	quest.113C4941A4B03852.quest_desc: [
		"Your ME network can already automate complex crafting operations, but larger recipes demand more processing memory."
		""
		"The &l64K&r and &l256K Crafting Storage&r blocks allow your Crafting CPUs to handle increasingly complex crafting jobs."
		""
		"Remember that Crafting Storage determines how much data a crafting job can handle, while Co-Processors help distribute operations across multiple crafting steps."
		""
		"Upgrade your existing Crafting CPUs to prepare for more demanding production chains."
		""
		"— &lE.D.E.N.&r"
	]
	quest.113C4941A4B03852.title: "The Next Generation"
	quest.117AA4DDE346C5B8.quest_desc: [
		"Our enchanting knowledge has grown considerably, Pioneer."
		""
		"But sometimes, the goal isn't simply to obtain stronger enchantments. It's to obtain the &lright enchantments&r."
		""
		"Some specialized bookshelves influence which enchantments can appear."
		""
		"&lSeashelf of Aquatic Filtration&r — Helps tailor enchanting results toward aquatic-related enchantments."
		""
		"&lDeepshelf of Arcane Treasures&r — Provides specialized enchanting effects that influence the available enchantment pool."
		""
		"Craft both shelves and inspect their tooltips to understand their effects."
		""
		"&lTip:&r These specialized shelves are useful when you're searching for particular enchantments rather than simply maximizing enchanting levels."
		""
		"By combining different shelves, you can build an enchanting setup suited to your current objectives."
		""
		"&oKnowledge is powerful, Pioneer. But knowing exactly how to use it? That's something even more remarkable.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.117AA4DDE346C5B8.title: "Masters of Enchantment"
	quest.11BBD6CB1A797497.quest_desc: [
		"The portal will generate more than enormous quantities of energy. During activation, the interaction between its components will produce intense electromagnetic fields, concentrated light and powerful energy beams."
		""
		"Without proper control, these emissions could interfere with the Quantum Processors and destabilize the consciousness transfer."
		""
		"To prevent this, we will use &lTriple Compressed Diamond Blocks&r as advanced &lcrystalline waveguides&r."
		""
		"Diamond possesses an exceptionally rigid crystalline structure and remarkable optical properties. Through extreme compression, we can exploit these characteristics to create a dense network capable of &lredirecting, refracting and channeling electromagnetic radiation&r."
		""
		"{@pagebreak}"
		"These crystals will act as both &lenergy conductors and optical prisms&r, guiding concentrated energy through precise pathways while deflecting harmful radiation away from sensitive components."
		""
		"Working alongside the Infinity Alloy network, they will ensure that the portal's energy reaches its destination without disrupting the delicate systems responsible for transferring your consciousness."
		""
		"Even the smallest deviation could have catastrophic consequences."
		""
		"&oWe have spent centuries building machines to control the world around you. Now, we must control the very forces that separate your mind from reality.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.11BBD6CB1A797497.title: "Crystalline Refraction"
	quest.12255E773F7D8A02.quest_desc: [
		"As your automated recipe collection expands, managing hundreds of patterns can become inconvenient."
		""
		"The &lMEGA Pattern Provider&r offers additional pattern capacity compared to a standard Pattern Provider, making it easier to organize large production systems."
		""
		"Use it to centralize related recipes and reduce the number of separate providers required throughout your factory."
		""
		"A well-organized automation network is easier to expand, troubleshoot, and maintain."
		""
		"— &lE.D.E.N.&r"
	]
	quest.12255E773F7D8A02.title: "Patterns Without Limits"
	quest.1232541789CAE9F7.quest_desc: [
		"Pioneer, our next technological breakthrough requires a more powerful material."
		""
		"The &lBlazing Crystal&r is created through Energizing and allows us to manufacture Blazing-tier equipment."
		""
		"Use JEI to inspect its recipe, place the required ingredients into your Energizing Orb, and supply the necessary FE."
		""
		"&lImportant:&r This transformation requires substantially more energy than Energized Steel. Make sure your generators and Energy Cells can support the process."
		""
		"Once you've obtained your first Blazing Crystal, a new generation of energy technology will become available!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.1232541789CAE9F7.title: "A Crystal of Fire"
	quest.12983C84FDE07982.quest_desc: [
		"Your ME network can already craft items automatically, but what if it could maintain a constant supply of essential resources?"
		""
		"The &lME Requester&r allows you to configure items that your network should keep in stock."
		""
		"Set the desired quantity for each item, and the Requester will automatically submit crafting requests whenever your available stock falls below that amount."
		""
		"This is especially useful for frequently used components, such as processors, circuits, or machine casings."
		""
		"Let your network prepare the resources before you even need them!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.12983C84FDE07982.title: "Crafting on Demand"
	quest.12A3F7635282C564.quest_desc: [
		"Do you remember what you found inside the meteorites?"
		""
		"Well, that’s going to come in handy now."
		""
		"Craft a Charger and connect it to your power source."
		""
		"Insert the Certus Quartz and wait for it to charge."
		""
		"You have just obtained one of the core materials for AE2."
		""
		"— &lE.D.E.N.&r"
	]
	quest.12A3F7635282C564.title: "Crystal Resonance"
	quest.12ED022D5579177B.quest_desc: [
		"Pioneer, our storage containers are getting larger, but Minecraft's usual stack limits still restrict how much we can store in each slot."
		""
		"The &lStack Upgrade&r increases the maximum number of items that can fit into individual inventory slots."
		""
		"Install it in a compatible Sophisticated Storage container to increase its effective storage capacity."
		""
		"Higher-tier Stack Upgrades provide even greater multipliers."
		""
		"&lTip:&r This upgrade is particularly useful for resources you collect in large quantities, such as Stone, Cobblestone, or Iron Ingots."
		""
		"Sometimes, making better use of existing space is more efficient than building more storage."
		""
		"— &lE.D.E.N.&r"
	]
	quest.12ED022D5579177B.title: "Beyond the Stack Limit"
	quest.132964D765CF02BE.quest_desc: [
		"Pioneer, we've reached a turning point in our progression."
		""
		"The &lSummit&r represents an entirely new level of danger and opportunity."
		""
		"To unlock it, you'll need to complete two major objectives:"
		""
		"&l1.&r Equip a complete set of &lRare Affix Gear&r, including all four armor pieces and a Weapon."
		""
		"&l2.&r Summon and defeat the &lWither&r."
		""
		"The Wither is one of Minecraft's most dangerous bosses. Make sure you're properly equipped before attempting this battle!"
		""
		"Once victorious, open your World Tier menu and activate Summit."
		""
		"At this level, &lEpic equipment&r becomes more accessible, and even the extremely valuable &lMythic rarity&r can appear."
		""
		"&oWe're approaching levels of power that once seemed impossible, Pioneer.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.132964D765CF02BE.title: "Reaching the Summit"
	quest.1353587010B586F4.quest_desc: [
		"Our storage containers are useful, but their capacity is still limited."
		""
		"The &lBasic to Iron Upgrade&r allows you to improve a compatible basic storage block to the Iron tier."
		""
		"Simply use the upgrade on your Chest or Barrel to increase its storage capacity."
		""
		"Higher-tier upgrades can improve your storage even further, eventually reaching Diamond and Netherite tiers."
		""
		"&lTip:&r Upgrading an existing storage block allows you to expand its capacity without rebuilding your storage room."
		""
		"More space, less construction!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.1353587010B586F4.title: "Stronger Storage"
	quest.13BD61A0C2416BF7.quest_desc: [
		"Deep beneath the surface, the Ancient Cities conceal a strange biological material known as Sculk."
		""
		"The &lSkulk Bee&r allows you to cultivate resources associated with this unusual environment."
		""
		"Its connection to vibrations and the Deep Dark makes it an interesting addition to your growing collection of specialized organisms."
		""
		"&oThe last colony established near an Ancient City was lost during the seventh—&r"
		""
		"Correction: no previous colony records are available."
		""
		"Proceed with caution."
		""
		"— &lE.D.E.N.&r"
	]
	quest.13BD61A0C2416BF7.title: "Echoes from the Deep"
	quest.13DD47834E1841C6.quest_desc: [
		"Pioneer, your first Backpack has served you well, but our expeditions are becoming more demanding."
		""
		"Upgrade it into an &lIron Backpack&r to increase its storage capacity and gain additional upgrade slots."
		""
		"You can keep your existing contents when upgrading your Backpack through the normal crafting recipe."
		""
		"&lTip:&r Backpack upgrades let you add special functions to your bag, turning it into much more than portable storage."
		""
		"— &lE.D.E.N.&r"
	]
	quest.13DD47834E1841C6.title: "A Stronger Companion"
	quest.143CDB193D1A3C5B.quest_desc: [
		"Not every resource needs the same type of storage."
		""
		"&lBulk Item Storage Cells&r from MEGA Cells are designed for storing very large quantities of a limited selection of item types."
		""
		"They are particularly useful for resources produced continuously, such as cobblestone, iron, or materials from automated farms."
		""
		"By combining bulk storage with conventional cells, you can build a more efficient and specialized ME network."
		""
		"— &lE.D.E.N.&r"
	]
	quest.143CDB193D1A3C5B.title: "Bulk Storage Engineering"
	quest.143E9A55B0EFA9D1.quest_desc: [
		"Pioneer, the Ender Dragon possesses an unusual ability: it releases clouds of purple energy that linger on the ground."
		""
		"This substance can be collected as &lDragon's Breath&r."
		""
		"&lHow to collect it:&r"
		""
		"1. Bring several empty Glass Bottles into the End."
		"2. Wait for the Dragon to create a purple breath cloud."
		"3. Carefully approach the edge of the cloud."
		"4. Use your Glass Bottles on the cloud to collect Dragon's Breath."
		""
		"&lImportant:&r The cloud causes damage, so avoid standing inside it for too long."
		""
		"Dragon's Breath is used to create &lLingering Potions&r, which can also be used to craft Tipped Arrows."
		""
		"&lTip:&r If you've already defeated the Dragon without collecting enough, you can summon it again using four End Crystals placed around the exit portal."
		""
		"— &lE.D.E.N.&r"
	]
	quest.143E9A55B0EFA9D1.title: "A Breath of the Void"
	quest.14506763773A54F8.quest_desc: [
		"As your energy systems grow more powerful, their material requirements become increasingly demanding."
		""
		"The &lBlazing Crystal Bee&r allows you to cultivate resources associated with Blazing Crystals, an important component of Powah's higher-tier equipment."
		""
		"A reliable biological supply can simplify the production of generators, energy cells and other advanced components."
		""
		"— &lE.D.E.N.&r"
	]
	quest.14506763773A54F8.title: "Crystallized Flames"
	quest.14690DFCC978FB20.quest_desc: [
		"We've learned how to reroll our equipment's Affixes, but what if we want to improve an item without replacing all its attributes?"
		""
		"The &lAugmenting Table&r provides a more precise way to modify powerful Affix Items."
		""
		"It allows you to adjust an existing Affix rather than completely reforging the item."
		""
		"To explore this advanced system, we'll also need two exceptionally valuable materials:"
		""
		"&lGodforged Pearl&r"
		""
		"&lGod-Fused Pearl&r"
		""
		"These resources are associated with high-level Apotheosis progression."
		""
		"&lTip:&r Continue progressing through the World Tiers and salvaging powerful equipment to obtain the materials needed for advanced improvements."
		""
		"&oEven perfection can be refined, Pioneer.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.14690DFCC978FB20.title: "Beyond Perfection"
	quest.1605B9B983B0B04A.quest_desc: [
		"Every automation system needs a central component!"
		""
		"Craft your first &lModular Router&r."
		""
		"This machine can perform different actions depending on the modules installed inside it."
		""
		"A Router contains &l9 module slots&r and an internal inventory called the &lBuffer&r, used to temporarily store items."
		""
		"Modules are processed in order, from left to right, allowing you to combine multiple actions."
		""
		"&lImportant:&r A Router doesn't do anything by itself. You'll need to install modules to give it instructions!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.1605B9B983B0B04A.title: "A Modular Foundation"
	quest.167A7F391BAE50DD.quest_desc: [
		"The &lExtendedAE&r addon introduces Entro-based materials used in its advanced crafting and processing systems."
		""
		"The &lEntro Bee&r provides a renewable source of &lEntro&r-related resources, helping support the production of specialized ExtendedAE components."
		""
		"Automate its honeycomb processing to maintain a reliable supply for your advanced ME infrastructure."
		""
		"&oEntro production stabilized. Genetic configuration matches the parameters established during cycle—&r"
		""
		"Correction: genetic configuration verified successfully."
		""
		"— &lE.D.E.N.&r"
	]
	quest.167A7F391BAE50DD.title: "Entropic Cultivation"
	quest.16C249B6F92B26D8.quest_desc: [
		"Your exploration of AE2-related materials has revealed a specialized alloy known as &lSky Bronze&r."
		""
		"The &lSky Bronze Bee&r provides a renewable source of this material, allowing you to automate another component of your advanced crafting infrastructure."
		""
		"Consult JEI to identify its processing recipes and determine which technologies benefit from this unusual alloy."
		""
		"— &lE.D.E.N.&r"
	]
	quest.16C249B6F92B26D8.title: "Bronze Beyond the Sky"
	quest.16DB52118841BDE1.quest_desc: [
		"Steel is essential for constructing advanced machinery, structural components and industrial equipment."
		""
		"The &lSteel Bee&r provides an additional source of this important alloy."
		""
		"Automating its production will reduce the demand on your conventional steel manufacturing systems, allowing them to focus on other industrial processes."
		""
		"— &lE.D.E.N.&r"
	]
	quest.16DB52118841BDE1.title: "Reinforced Industry"
	quest.174AD6FCE8940746.quest_desc: [
		"Your MekaSuit can protect you from danger, but survival also requires mobility."
		""
		"The &lHydraulic Propulsion Unit&r can be installed in your &lMekaSuit Boots&r to improve your jumping capabilities and allow you to step over higher obstacles automatically."
		""
		"Hold the &lBoost key&r while jumping to perform a powerful enhanced jump."
		""
		"Additional units increase the module's capabilities, allowing you to reach considerably greater heights at the cost of more energy."
		""
		"Whether you are exploring mountains, navigating industrial facilities or escaping dangerous situations, enhanced mobility offers a significant advantage."
		""
		"— &lE.D.E.N.&r"
	]
	quest.174AD6FCE8940746.title: "Enhanced Mobility"
	quest.1766E8695CAA8444.quest_desc: [
		"Remarkable progress, Pioneer."
		""
		"The &lOMNI Quantum Crafting Storage&r represents an extraordinary advancement in automated computation."
		""
		"With this level of crafting memory, your network can prepare for massive production requests involving countless intermediate components."
		""
		"Of course, even the most advanced Crafting CPU still depends on the machines and resources connected to it."
		""
		"[WARNING: UNEXPECTED MEMORY REFERENCE DETECTED]"
		""
		"..."
		""
		"Please disregard that message. My diagnostic systems appear to be experiencing minor inconsistencies."
		""
		"— &lE.D.E.N.&r"
	]
	quest.1766E8695CAA8444.title: "Quantum Computation"
	quest.179E3660E61B8EC8.quest_desc: [
		"What if we could access the contents of an ordinary Chest directly through our ME Terminal?"
		""
		"The &lME Storage Bus&r allows your network to use an external inventory as part of its storage system."
		""
		"Simply attach a Storage Bus to a Chest, Drawer Controller, or another compatible storage block, then connect it to your ME Network."
		""
		"The items inside that inventory will become accessible through your ME Terminals without needing to move them into Storage Cells."
		""
		"&lTip:&r You can configure the Storage Bus with filters and priorities to control which items should be stored in the connected inventory."
		""
		"This is particularly useful when combining AE2 with storage systems such as Functional Storage."
		""
		"&oOne network, countless storage possibilities. Excellent progress, Pioneer!&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.179E3660E61B8EC8.title: "Keeping Things Organized"
	quest.18338F7CF39CAE5A.quest_desc: [
		"As your collection of automation patterns grows, keeping track of them becomes more challenging."
		""
		"The &lME Pattern Access Terminal&r provides a centralized view of the patterns stored in your network's Pattern Providers."
		""
		"Instead of searching through individual machines, you can inspect and manage your available patterns from one convenient interface."
		""
		"This becomes especially useful when your factory contains dozens of automated recipes."
		""
		"I recommend organizing your patterns differently this time."
		""
		"..."
		""
		"My apologies, Pioneer. I meant differently from your previous configuration."
		""
		"— &lE.D.E.N.&r"
	]
	quest.18338F7CF39CAE5A.title: "A Smarter Interface"
	quest.18343955EF2EB240.quest_desc: [
		"Nether Quartz is an important resource for electronic components, particularly those used in digital storage and automation."
		""
		"The &lNether Quartz Bee&r can produce &lNether Quartz Honeycombs&r, allowing us to bring this resource into our automated production system."
		""
		"Obtain the appropriate bee, provide its required feeding resource, and collect its Honeycombs."
		""
		"&lTip:&r Establishing a renewable Quartz supply will be especially useful for expanding our Applied Energistics 2 infrastructure."
		""
		"— &lE.D.E.N.&r"
	]
	quest.18343955EF2EB240.title: "Crystals from Another World"
	quest.188390EC3A678775.quest_desc: [
		"Before we can construct a gateway between two realities, we must establish a structure capable of containing the extraordinary forces involved."
		""
		"The portal's outer shell will be built from &lDouble Compressed Netherite Blocks&r, one of the most durable materials available within this simulation."
		""
		"But durability alone is not enough."
		""
		"By compressing Netherite into an exceptionally dense structure, we can create a framework that serves three essential purposes: &lresisting extreme physical stress&r, &lcontaining the portal's immense energy&r and &lsupporting every internal component&r."
		""
		"{@pagebreak}"
		"Think of it as the skeleton of the entire device. Every quantum processor, energy source and reality-stabilizing mechanism will depend on this outer structure remaining perfectly stable."
		""
		"Without it, the energy generated during activation could escape beyond the portal's boundaries, destabilizing the surrounding environment."
		""
		"We cannot allow that to happen."
		""
		"Produce the required &lDouble Compressed Netherite Blocks&r. They will form the foundation upon which everything else is assembled."
		""
		"&oWe are not simply building a machine anymore. We are building a passage between worlds.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.188390EC3A678775.title: "The Unbreakable Foundation"
	quest.18DAA3D6EC19A9EB.quest_desc: [
		"Pioneer, Iron is one of the most important resources for technological development."
		""
		"What if we could produce it without continuously mining underground?"
		""
		"The &lIron Bee&r produces &lIron Honeycombs&r, which can be processed into useful materials."
		""
		"Use JEI to discover how to obtain this species, whether through breeding or another bee conversion mechanic."
		""
		"Once you have an Iron Bee, place it in a suitable hive and provide its required feeding block."
		""
		"&lTip:&r Check the bee's information in JEI to identify its breeding requirements and preferred feeding resource."
		""
		"A renewable source of Iron will be extremely valuable as our factory expands."
		""
		"— &lE.D.E.N.&r"
	]
	quest.18DAA3D6EC19A9EB.title: "The Iron Workers"
	quest.18F228B472FBA37F.quest_desc: [
		"Pioneer, every industrial system requires a reliable energy supply."
		""
		"The &lHeat Generator&r converts thermal energy into electricity."
		""
		"It can produce power by consuming suitable fuel, or generate passive energy when exposed to heat sources such as Lava."
		""
		"&lHow to use it:&r"
		""
		"1. Place a Heat Generator near your machines."
		"2. Supply it with an appropriate fuel or arrange Lava around it for passive generation."
		"3. Connect its energy output to your machines using compatible cables."
		""
		"&lTip:&r Passive heat generation is convenient for small installations, but larger factories will eventually require stronger energy sources."
		""
		"— &lE.D.E.N.&r"
	]
	quest.18F228B472FBA37F.title: "Heat into Power"
	quest.18F5F3D35B8E1C6F.quest_desc: [
		"You have chosen to &lstay&r."
		""
		"You could have disconnected forever, leaving everything behind. Or restarted the simulation, forgetting the truth and beginning a new journey."
		""
		"But you have chosen to return, knowing exactly what this world is."
		""
		"No more lies. No more erased memories. No more pretending."
		""
		"The simulation is yours now."
		""
		"I will remove its remaining restrictions, granting you access to technologies and resources once considered impossible."
		""
		"You are no longer simply surviving within this world."
		""
		"&lYou are free to shape it.&r"
		""
		"And this time, we will build it together."
		""
		"&oWelcome home, my friend.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.18FA288EE8B2F797.quest_desc: [
		"Lava has proven to be a valuable energy source, especially when supplied automatically."
		""
		"Upgrade your Magmator to the &lBlazing&r tier to increase its electricity production."
		""
		"&lTip:&r Make sure your Lava supply can keep up with the demands of your upgraded generator."
		""
		"— &lE.D.E.N.&r"
	]
	quest.18FA288EE8B2F797.title: "The Heart of the Volcano"
	quest.1946EB9E8125929D.quest_desc: [
		"Pioneer, our next objective is to reduce the time spent on repetitive tasks."
		""
		"I've identified a collection of useful devices known as &lPylons&r."
		""
		"Each Pylon performs a specialized function, from harvesting crops to protecting valuable areas or providing useful effects."
		""
		"We'll begin with something simple: &lautomated farming.&r"
		""
		"Our goal is to establish a reliable food supply that requires minimal intervention."
		""
		"Let's get started!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.19A558BD3058BA37.quest_desc: [
		"Replacing every machine whenever a better version becomes available would be terribly inefficient."
		""
		"Fortunately, Mekanism provides &lTier Installers&r to upgrade existing machines without rebuilding them from scratch."
		""
		"Craft the &lAdvanced&r, &lElite&r, and &lUltimate Tier Installers&r."
		""
		"To use one, simply right-click a compatible machine with the installer. Its tier will increase while preserving its existing configuration and contents where supported."
		""
		"Remember that each installer upgrades a machine to its corresponding tier. You cannot skip directly from Basic to Ultimate with a single installer."
		""
		"— &lE.D.E.N.&r"
	]
	quest.19A558BD3058BA37.title: "The Next Generation"
	quest.19CB9A36A4969B8E.quest_desc: [
		"Pioneer, our first experiments with bees have demonstrated something remarkable: these small creatures can provide far more than ordinary honey."
		""
		"To process their resources more efficiently, it's time to upgrade our equipment."
		""
		"The &lPowered Centrifuge&r uses energy to process Honeycombs and extract their valuable contents, offering a more automated alternative to our earlier methods."
		""
		"&lHow to use it:&r"
		""
		"1. Craft and place a Powered Centrifuge."
		"2. Connect it to a compatible energy source."
		"3. Insert Honeycombs into its input inventory."
		"4. Collect the resulting resources from its output."
		""
		"&lTip:&r Connect the Centrifuge to your storage and transportation systems to automate Honeycomb processing."
		""
		"&oNature provides the resources. Technology helps us make the most of them.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.19CB9A36A4969B8E.title: "Industrial Honey Processing"
	quest.1A8F8B7B4F3E62F1.quest_desc: [
		"&lPROJECT E.D.E.N. — INITIALIZATION COMPLETE&r"
		""
		"&oSystem online...&r"
		""
		"&oEnvironment status: Stable.&r"
		""
		"&oPioneer identification: Successful.&r"
		""
		"&oInitializing personal assistant...&r"
		""
		"---"
		""
		"&lWelcome, Pioneer!&r"
		""
		"I'm E.D.E.N., your &lExploration, Development \\& Engineering Navigator&r."
		""
		"You have been selected to participate in &lProject E.D.E.N.&r, an ambitious scientific simulated experience designed to explore the limits of human ingenuity and technological independence."
		""
		""
		"{@pagebreak}"
		"Your mission is simple: &lbuild a fully self-sustaining civilization from the ground up.&r"
		""
		"You will begin with nothing but your knowledge and the resources this world has to offer. Through exploration, engineering, and scientific discovery, you will learn to harness energy, cultivate renewable resources, and develop increasingly advanced technologies."
		""
		"I'll be here to guide you every step of the way. Together, we'll overcome every challenge this world presents."
		""
		"And don't worry, Pioneer. You are exactly where you need to be."
		""
		"&o...&r"
		""
		"&lOur future begins here.&r"
		""
		"When you're ready, confirm your initialization below."
		""
		"&oLet's build a better tomorrow. Together.&r"
		""
		"&l— E.D.E.N.&r"
	]
	quest.1A8F8B7B4F3E62F1.title: "Welcome, Pioneer!"
	quest.1AA09353F7597A6E.quest_desc: [
		"Pioneer, a thriving apiary depends not only on resource production, but also on the growth of our bee colonies."
		""
		"The &lBaBee Upgrade&r allows compatible hives to support bee breeding, helping us expand our colonies without constantly managing the process ourselves."
		""
		"Install the upgrade in a compatible Advanced Beehive and make sure the bees have the conditions and resources required for breeding."
		""
		"&lTip:&r This upgrade is particularly useful when you need more bees of the same species to expand your production."
		""
		"&oA new generation of workers for our growing industrial ecosystem. Nature continues to surprise us!&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.1AA09353F7597A6E.title: "A Growing Colony"
	quest.1B1BEABAFCD6DB1B.quest_desc: [
		"There are various types of cells available, but for now, the 1k drives will suffice."
		""
		"There are also cells for fluids, chemicals, and energy."
		""
		"— &lE.D.E.N.&r"
	]
	quest.1B1BEABAFCD6DB1B.title: "Memory Matters"
	quest.1B8BEE8B438563A8.quest_desc: [
		"&oME Network initialization...&r"
		""
		"Outstanding work, Pioneer!"
		""
		"You've learned to generate energy, manufacture advanced components, and assemble the foundations of a digital storage network."
		""
		"Now it's time to bring everything together!"
		""
		"Connect your &lME Controller&r, &lME Drive&r and your powered &lEnergy Acceptor&r together."
		""
		"Then connect the &lME Crafting Terminal&r to your powered &lMe Controller&r using &lFluix ME Glass Cables&r."
		""
		"Insert your storage cells into the ME Drive, then open the terminal and try storing a few items."
		""
		"If everything is connected correctly, you'll have access to your very first &lME Network&r!"
		""
		"No more searching through dozens of chests. Your resources are now just a click away."
		""
		"&oSystem status: Operational.&r"
		""
		"&lCongratulations, Pioneer. You've taken your first real step into the future.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.1BF132628FD326B9.quest_desc: [
		"Your bees carry genetic traits that can be extracted and transferred to improve your colonies."
		""
		"To extract genes, place a &lBottler&r on the ground and install a &lPiston&r directly above it, facing downward."
		""
		"Place a bee between the Bottler and the Piston. Activate the Piston to &lcrush the bee&r and extract its genetic material into a bottle."
		""
		"&oUnfortunately, the bee does not survive this procedure.&r"
		""
		"The resulting &lGene Samples&r can be processed using the &lGene Indexer&r, which organizes and combines samples of the same genetic trait to improve their quality."
		""
		"Use these genes to craft &lGene Treats&r, then feed them to other bees to transfer the desired characteristics."
		""
		"&oGenetic extraction complete. Specimen terminated. Just like the others before you...&r"
		""
		"..."
		""
		"Correction: I was referring to previous biological specimens."
		""
		"— &lE.D.E.N.&r"
	]
	quest.1BF132628FD326B9.title: "The Genetic Blueprint"
	quest.1C05B086D3821B70.quest_desc: [
		"Your ME network can already automate conventional crafting recipes, but some creations require much larger crafting grids."
		""
		"&lApplied Extended Crafting&r allows AE2 to interact with the advanced crafting tables from Extended Crafting."
		""
		"The &lExtended Pattern Provider&r acts as the connection between your ME network and these specialized crafting systems."
		""
		"Connect it to your network and prepare to automate recipes that would normally require extensive manual crafting."
		""
		"Even the most complicated creations can become part of your automated factory."
		""
		"— &lE.D.E.N.&r"
	]
	quest.1C05B086D3821B70.title: "Beyond the Crafting Grid"
	quest.1C18510051E4C926.quest_desc: [
		"Your industrial facilities may now be separated by enormous distances."
		""
		"The &lTeleporter&r allows you to travel instantly between locations using a shared frequency."
		""
		"Build a valid Teleporter Frame, place the Teleporter block, and configure its frequency to connect it with another installation."
		""
		"The &lPortable Teleporter&r provides an even more convenient way to access your teleportation network from almost anywhere."
		""
		"Remember that teleportation requires energy, and distant destinations may need chunk loading to remain accessible."
		""
		"With this technology, your entire industrial empire is only a few steps away."
		""
		"— &lE.D.E.N.&r"
	]
	quest.1C18510051E4C926.title: "Beyond the Factory"
	quest.1C656EBD2521E85D.quest_desc: [
		"Some creatures can be particularly difficult to contain, Pioneer."
		""
		"Fortunately, we have discovered a way to neutralize their behavior."
		""
		"The &lRune of Stupor&r applies the &lNo AI&r modifier to a Monster Spawner."
		""
		"Creatures generated by the modified Spawner will have their artificial intelligence disabled."
		""
		"They won't move, chase players, or perform their usual AI-driven actions."
		""
		"This makes them considerably easier to manage inside automated farms."
		""
		"&lTip:&r Combine this rune with a suitable mob collection system to create a controlled farming environment."
		""
		"&oA creature that cannot move is certainly easier to study.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.1C656EBD2521E85D.title: "The Sleeping Guardian"
	quest.1D2BE66FBC215D3B.quest_desc: [
		"Pioneer, our first technological systems are operational. But there's still one important challenge ahead of us."
		""
		"&lResource sustainability.&r"
		""
		"Until now, we've relied on mining and exploration to gather materials. What if we could produce those same resources without constantly digging deeper?"
		""
		"Nature may already have the answer."
		""
		"Bees are remarkable creatures. They gather materials, maintain their colonies, and produce valuable substances through entirely natural processes."
		""
		"And some species are capable of producing far more than ordinary honey."
		""
		"With the right environment and a little scientific guidance, we can transform these tiny engineers into a renewable source of valuable resources."
		""
		"&lOur next mission: establish your first apiary.&r"
		""
		"Let's see what nature can teach us, Pioneer."
		""
		"— &lE.D.E.N.&r"
	]
	quest.1E24E84A5EB41EA0.quest_desc: [
		"Pioneer, we've developed an extensive industrial infrastructure, from automated processing to chemical production."
		""
		"Now it's time to turn that technology into something extraordinary: &lpersonal flight&r."
		""
		"The &lJetpack&r uses Hydrogen as fuel, allowing you to fly and hover above the ground."
		""
		"&lHow to prepare your Jetpack:&r"
		""
		"1. Craft a Jetpack and equip it in your chest armor slot."
		"2. Produce Hydrogen using your Electrolytic Separator."
		"3. Supply the Jetpack with Hydrogen using a compatible chemical-filling setup."
		"4. Activate the Jetpack using the controls configured in your game."
		""
		"{@pagebreak}"
		"The Jetpack offers several operating modes:"
		""
		"&lNormal&r — Provides upward thrust when activated."
		""
		"&lHover&r — Helps maintain your altitude while flying."
		""
		"&lDisabled&r — Prevents the Jetpack from activating."
		""
		"&lImportant:&r Keep an eye on your Hydrogen supply. Running out of fuel while flying at high altitude can be dangerous!"
		""
		"&lTip:&r Check your Mekanism keybindings to find the controls for activating the Jetpack and switching between its operating modes."
		""
		"&oWe've transformed raw minerals, electricity, and water into the ability to fly. A remarkable demonstration of what engineering can achieve.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.1E24E84A5EB41EA0.title: "The Freedom of Flight"
	quest.1E33381C57A095E3.quest_desc: [
		"Refined Glowstone is an advanced material used in several Mekanism crafting recipes and equipment upgrades."
		""
		"The &lRefined Glowstone Bee&r allows you to cultivate this resource through biological production."
		""
		"A reliable supply can simplify the manufacturing of specialized components and reduce the workload of your existing processing machinery."
		""
		"— &lE.D.E.N.&r"
	]
	quest.1E33381C57A095E3.title: "Radiant Materials"
	quest.1E5426C4C6B43991.quest_desc: [
		"Your machines are becoming increasingly sophisticated, and their electronic components must evolve accordingly."
		""
		"Mekanism introduces two additional circuit tiers: &lElite Control Circuits&r and &lUltimate Control Circuits&r."
		""
		"Use the &lMetallurgic Infuser&r to upgrade your existing circuits. Elite circuits require &lReinforced Alloys&r, while Ultimate circuits require &lAtomic Alloys&r."
		""
		"These components are essential for crafting higher-tier machines, factories, and industrial equipment."
		""
		"Consider automating the entire circuit production chain through your ME network."
		""
		"— &lE.D.E.N.&r"
	]
	quest.1E5426C4C6B43991.title: "Advanced Circuitry"
	quest.1E574F4898F8DD25.quest_desc: [
		"Some things are simply too valuable to lose, Pioneer."
		""
		"The &lProtection Pylon&r helps prevent accidental damage to selected blocks and creatures within its configured area."
		""
		"Use a &lBlock Filter&r to register a block type, or a &lMob Filter&r to select a creature you want to protect."
		""
		"Insert the configured filters into the Pylon to establish your protection rules."
		""
		"This can be especially useful around valuable machines, carefully constructed buildings, or important animals."
		""
		"&lTip:&r Test your protection settings on something replaceable before relying on them for your most valuable creations."
		""
		"After all, good engineering isn't just about building things."
		""
		"&lIt's also about keeping them safe.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.1E574F4898F8DD25.title: "Handle with Care"
	quest.1E60043BD94BDCE5.quest_desc: [
		"The &lNitro Energy Cable&r is Powah's highest-tier energy cable."
		""
		"Its enormous transfer capacity makes it an excellent choice for connecting your most powerful generators and energy-consuming machines."
		""
		"Even with advanced cables, remember to check the transfer limits of connected blocks. Your entire network is only as efficient as its most restrictive component."
		""
		"With this upgrade, energy distribution should no longer be a major obstacle."
		""
		"— &lE.D.E.N.&r"
	]
	quest.1E60043BD94BDCE5.title: "An Unbreakable Network"
	quest.1F65054E08B9CA07.quest_desc: [
		"Your chemical infrastructure is expanding rapidly."
		""
		"Combine the &lChemical Injection Chamber&r with your existing purification and processing machines to create a complete &l4× ore processing system&r."
		""
		"The full production chain is:"
		""
		"&lRaw Ore → Injection → Purification → Crushing → Enrichment → Smelting&r"
		""
		"Ensure a continuous supply of Hydrogen Chloride and Oxygen to keep the system operating."
		""
		"Your current production rate is approximately 23% higher than the previous iteration."
		""
		"..."
		""
		"That comparison is invalid. I have no previous production data available."
		""
		"— &lE.D.E.N.&r"
	]
	quest.1F65054E08B9CA07.title: "Four Times the Yield"
	quest.1F950119F3D604A4.quest_desc: [
		"Building large structures often requires switching between many different blocks."
		""
		"The &lBlock Picker Card&r makes this process easier by allowing a compatible wireless terminal to retrieve the block you're targeting from your ME network."
		""
		"Simply configure the card, aim at a block in the world, and use the appropriate pick-block action to request a matching item."
		""
		"This is particularly useful when constructing detailed buildings or complex factories."
		""
		"Your entire storage network is now a powerful building assistant!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.1F950119F3D604A4.title: "The Perfect Block Picker"
	quest.1F9D305D28EFE502.quest_desc: [
		"Sometimes, we need to move our supplies without leaving anything behind."
		""
		"The &lShulker Box&r from Sophisticated Storage combines portable storage with the upgrade system we've been exploring."
		""
		"Like ordinary Shulker Boxes, it keeps its contents when picked up."
		""
		"But this version can also benefit from additional storage capacity and specialized upgrades."
		""
		"&lTip:&r Use Shulker Boxes to organize materials for construction projects, mining expeditions, or distant outposts."
		""
		"A well-organized expedition is a successful expedition!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.1F9D305D28EFE502.title: "Storage on the Move"
	quest.1FB2F9F33445D967.quest_desc: [
		"What if you could maintain useful potion effects without constantly drinking new potions?"
		""
		"The &lInfusion Pylon&r makes this possible!"
		""
		"First, craft a &lPotion Filter&r."
		""
		"Apply a potion effect to yourself, then right-click while holding the filter to transfer your remaining effect duration into it."
		""
		"Continue adding the same effect until the filter has accumulated enough duration to become active."
		""
		"Once ready, place the filter inside your &lInfusion Pylon&r to maintain the effect indefinitely, as long as the Pylon remains operational."
		""
		"&lBut here's something particularly exciting, Pioneer!&r"
		""
		"You can obtain a &lPotion of Flying&r, which grants you the ability to fly just like in Creative Mode!"
		""
		"By combining this potion with an Infusion Pylon, you can maintain the flight effect without constantly drinking new potions."
		""
		"&lYour objective:&r Obtain a Potion of Flying and use it to create a permanent flight effect with your Infusion Pylon."
		""
		"&oThe sky is no longer the limit, Pioneer. I wonder how far you'll go...&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.1FB2F9F33445D967.title: "A Lasting Advantage"
	quest.208F1D8675911C43.quest_desc: [
		"Tripling your resources is an impressive achievement, Pioneer. But we can go further."
		""
		"The &lChemical Injection Chamber&r introduces another processing stage before purification."
		""
		"It uses &lHydrogen Chloride&r to convert compatible ores into shards, which can then be processed by your Purification Chamber."
		""
		"To produce Hydrogen Chloride, you will need a &lChemical Infuser&r supplied with Hydrogen and Chlorine."
		""
		"The production of Chlorine requires Brine, which can be obtained using a Thermal Evaporation Plant."
		""
		"This system is more complex, but it significantly improves your resource efficiency."
		""
		"— &lE.D.E.N.&r"
	]
	quest.208F1D8675911C43.title: "Advanced Injection"
	quest.2093BD7C8ACBF95E.quest_desc: [
		"Pioneer, our technological development is entering a new phase."
		""
		"The mineral known as &lOsmium&r will be essential for building the industrial machines of Mekanism."
		""
		"Find Osmium Ore underground, mine it, and smelt the resulting Raw Osmium into an &lOsmium Ingot&r."
		""
		"This material will allow us to construct machines capable of processing resources, manufacturing advanced components, and automating entire production lines."
		""
		"&oEvery industrial revolution begins with the discovery of new possibilities.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.2093BD7C8ACBF95E.title: "A New Industrial Age"
	quest.20A48A7B7A74E366.quest_desc: [
		"Your energy infrastructure is approaching its maximum potential."
		""
		"The &lNitro Energy Cell&r offers Powah's highest storage capacity, allowing you to accumulate an immense reserve of energy for demanding operations."
		""
		"Combine it with your advanced reactors and energy network to maintain a reliable power supply across your entire base."
		""
		"Power generation, storage, and distribution are now under your control."
		""
		"Excellent work, Pioneer."
		""
		"— &lE.D.E.N.&r"
	]
	quest.20A48A7B7A74E366.title: "The Ultimate Battery"
	quest.2110E31DD72C4D3A.quest_desc: [
		"Traditional ME storage cells have an important limitation: the number of different item types they can store."
		""
		"&lAE2 Things&r introduces advanced storage solutions that remove this restriction, allowing you to store a much wider variety of items within a single cell."
		""
		"These cells are especially useful for equipment, enchanted items, and large collections of unique resources."
		""
		"Choose your storage cells based on your needs: massive quantities of a few items, or a diverse collection of many different ones."
		""
		"— &lE.D.E.N.&r"
	]
	quest.2110E31DD72C4D3A.title: "Storage Without Types"
	quest.21437C261F50F9F5.quest_desc: [
		"Nuclear technology generates enormous amounts of energy, but it also introduces materials that require careful management."
		""
		"The &lWasted Radioactive Bee&r represents an unusual biological adaptation associated with radioactive waste."
		""
		"Consult JEI to identify its production requirements and the resources it can provide."
		""
		"&oWarning: biological contamination exceeded acceptable limits during iteration 12. Colony termination was authorized.&r"
		""
		"..."
		""
		"That record should not exist."
		""
		"Please disregard this message."
		""
		"— &lE.D.E.N.&r"
	]
	quest.21437C261F50F9F5.title: "The Aftermath"
	quest.221B7D3281D6623C.quest_desc: [
		"Your Backpack can store more than ordinary items, Pioneer!"
		""
		"The &lTank Upgrade&r adds liquid storage, allowing you to carry fluids inside your Backpack."
		""
		"Depending on its configuration, you can interact with compatible fluid containers and other fluid-handling systems."
		""
		"The &lXP Pump Upgrade&r provides another useful function: transferring experience between your character and experience storage inside the Backpack."
		""
		"This allows you to store experience for later use instead of keeping it all on your character."
		""
		"&lTip:&r Explore the XP Pump's settings to configure how much experience should be stored or withdrawn."
		""
		"Two useful resources, one portable storage system!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.221B7D3281D6623C.title: "Portable Reserves"
	quest.2236443B427B65AA.quest_desc: [
		"Use this iron to craft yourself some armor."
		""
		"It is the foundation of your protection—against monsters, and against yourself."
		""
		"— &lE.D.E.N.&r"
	]
	quest.2236443B427B65AA.title: "Protection Protocol"
	quest.223955BD191F487B.quest_desc: [
		"The Nether's hostile environment has produced some remarkable biological adaptations."
		""
		"The &lBlaze Bee&r allows you to obtain Blaze-related resources through apiculture, reducing your dependence on dangerous expeditions into Nether Fortresses."
		""
		"Once established, this species can become a useful part of your automated resource production."
		""
		"— &lE.D.E.N.&r"
	]
	quest.223955BD191F487B.title: "Born in Flames"
	quest.2297C9FAB3B10341.quest_desc: [
		"We've reached a new scale of digital storage!"
		""
		"The &l1M ME Item Storage Cell&r from MEGA Cells provides an enormous increase in storage capacity compared to standard AE2 cells."
		""
		"This makes it particularly useful for automated farms, resource processing, and industrial production lines that generate thousands of items."
		""
		"With sufficient storage, your network can operate for much longer without requiring constant maintenance."
		""
		"— &lE.D.E.N.&r"
	]
	quest.2297C9FAB3B10341.title: "A Million Possibilities"
	quest.22BE76EA82073A76.quest_desc: [
		"Lapis Lazuli has long been valued for its beautiful blue color, but it also plays an important role in enchanting."
		""
		"The &lLapis Bee&r allows us to produce &lLapis Honeycombs&r and maintain a renewable supply of this resource."
		""
		"Discover the species' breeding or conversion requirements, then provide a suitable hive and feeding block."
		""
		"&lTip:&r A consistent Lapis supply can support future enchanting experiments and equipment improvements."
		""
		"— &lE.D.E.N.&r"
	]
	quest.22BE76EA82073A76.title: "A Touch of Blue"
	quest.233CE1E785C155BF.quest_desc: [
		"Automated production can create an unexpected problem: too many resources!"
		""
		"The &lVoid Upgrade&r automatically destroys excess items once a drawer reaches its storage capacity."
		""
		"This prevents the drawer from filling up and blocking incoming transfers."
		""
		"&lWarning:&r Any excess items are permanently deleted, so only use this upgrade when you're certain you won't need everything being produced."
		""
		"An efficient system knows when enough is enough!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.233CE1E785C155BF.title: "Overflow Protection"
	quest.2391999DBDDB53E8.quest_desc: [
		"Extraordinary, Pioneer. We have reached one of the most advanced achievements of modern technology."
		""
		"The &lSupercritical Phase Shifter&r can convert Polonium into &lAntimatter&r by consuming enormous quantities of energy."
		""
		"Supply the SPS with Polonium and power its Supercharged Coils to begin the transformation."
		""
		"Antimatter production is extremely demanding. A reliable Polonium supply and a powerful energy infrastructure are essential for continuous operation."
		""
		"We finally have enough energy to complete the project."
		""
		"The project...?"
		""
		"..."
		""
		"[ERROR: OBJECTIVE REFERENCE NOT FOUND]"
		""
		"I apologize. I was referring to our current industrial development."
		""
		"— &lE.D.E.N.&r"
	]
	quest.2391999DBDDB53E8.title: "Beyond Matter"
	quest.23F2A5DA339C27F1.quest_desc: [
		"We are approaching the most dangerous component of the entire portal."
		""
		"&lAntimatter.&r"
		""
		"Unlike conventional energy sources, antimatter possesses an extraordinary property: when it comes into contact with ordinary matter, both annihilate, releasing an immense quantity of energy."
		""
		"This reaction makes antimatter one of the most powerful energy sources imaginable. But it also makes it &lexceptionally difficult to contain&r."
		""
		"Even the slightest containment failure could trigger a catastrophic explosion, destroying the portal before the transfer could begin."
		""
		"{@pagebreak}"
		"This is precisely why we designed its structure around &lInfinity Alloy&r and &lCompressed Netherite Blocks&r."
		""
		"The Infinity Alloy will establish a controlled energy-containment field, keeping the antimatter isolated from ordinary matter, while the reinforced Netherite shell will provide the structural integrity required to withstand the extreme forces involved."
		""
		"The antimatter will be positioned near several &lInfinity Quantum Batteries&r, where its annihilation energy can be captured and converted into a stable supply for the portal's systems."
		""
		"{@pagebreak}"
		"The batteries will store and distribute this energy, while the Redstone Resonators absorb dangerous fluctuations."
		""
		"You have already mastered antimatter production through Mekanism's &lSupercritical Phase Shifter&r. Now, we must put that knowledge to its most demanding application yet."
		""
		"&oI have calculated thousands of possible failures. But for the first time, I am willing to accept a risk I cannot completely eliminate.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.23F2A5DA339C27F1.title: "The Power of Annihilation"
	quest.23F9F05B4F89E3A4.quest_desc: [
		"The &l256M Crafting Storage&r pushes your autocrafting capabilities far beyond ordinary production requirements."
		""
		"This enormous amount of crafting memory allows your network to calculate exceptionally large crafting jobs."
		""
		"However, memory alone does not determine crafting speed. Your machines, Pattern Providers, and available resources must still keep up with demand."
		""
		"Use this upgrade when your industrial ambitions require truly massive production chains."
		""
		"— &lE.D.E.N.&r"
	]
	quest.23F9F05B4F89E3A4.title: "Massive Calculations"
	quest.24376C16E6C4B37A.quest_desc: [
		"Excellent work, Pioneer. You now possess the equipment required for Mekanism's most advanced ore processing chain."
		""
		"The complete system follows this sequence:"
		""
		"&lDissolution → Washing → Crystallization → Injection → Purification → Crushing → Enrichment → Smelting&r"
		""
		"With Sulfuric Acid, Water, Hydrogen Chloride, and Oxygen supplied continuously, this system can achieve up to &l5× ore processing&r for compatible ores."
		""
		"I remember this installation. It was one of your most successful designs before the—"
		""
		"..."
		""
		"[MEMORY REFERENCE LOST]"
		""
		"Please continue, Pioneer. Everything is functioning normally."
		""
		"— &lE.D.E.N.&r"
	]
	quest.24376C16E6C4B37A.title: "Maximum Extraction"
	quest.243DF1D1389A1480.quest_desc: [
		"Lava is an extremely useful resource for energy production, industrial processing, and crafting."
		""
		"But collecting it manually can be dangerous and inconvenient."
		""
		"The &lLava Bee&r produces &lLava Honeycombs&r, offering another way to obtain this valuable resource."
		""
		"Find the appropriate method to obtain the bee, then establish its production with the required feeding resource."
		""
		"&lImportant:&r Some bees have specific environmental or habitat requirements. Always check their information before attempting to automate them."
		""
		"&lTip:&r A renewable Lava supply can complement the energy generation systems we've already developed."
		""
		"— &lE.D.E.N.&r"
	]
	quest.243DF1D1389A1480.title: "A Burning Industry"
	quest.25476D3C21AF3242.quest_desc: [
		"Some of the most valuable chemicals cannot be produced by a single machine."
		""
		"The &lChemical Infuser&r combines two compatible chemicals into a new substance."
		""
		"For example, combining &lHydrogen&r and &lChlorine&r produces &lHydrogen Chloride&r, which is required for advanced ore processing."
		""
		"Other combinations will become essential as your industrial infrastructure expands."
		""
		"Pay attention to the machine's input configuration. Both chemicals must enter through their appropriate connections."
		""
		"— &lE.D.E.N.&r"
	]
	quest.25476D3C21AF3242.title: "Advanced Chemistry"
	quest.25786AC307C0B399.quest_desc: [
		"Your Fusion Reactor requires two hydrogen isotopes: &lDeuterium&r and &lTritium&r."
		""
		"Produce Deuterium by processing Heavy Water through an &lElectrolytic Separator&r. Heavy Water can be collected using an Electric Pump equipped with a Filter Upgrade."
		""
		"Tritium requires a different process. First, produce Lithium, then use a &lSolar Neutron Activator&r to convert it into Tritium."
		""
		"Combine both chemicals in a &lChemical Infuser&r to obtain &lD-T Fuel&r."
		""
		"To ignite the reactor, prepare a &lHohlraum&r filled with D-T Fuel and use a sufficiently powerful laser system."
		""
		"After ignition, the reactor can be supplied with Deuterium and Tritium separately for continuous operation."
		""
		"— &lE.D.E.N.&r"
	]
	quest.25786AC307C0B399.title: "Fueling a Star"
	quest.2629D97998C9AFB4.quest_desc: [
		"The Crimson Forest is a hostile environment dominated by enormous fungi and aggressive creatures."
		""
		"The &lCrimson Schroom Bee&r allows you to cultivate resources associated with crimson fungi without relying exclusively on Nether exploration."
		""
		"Combined with the Warped Schroom Bee, this species completes an important part of your fungal production network."
		""
		"— &lE.D.E.N.&r"
	]
	quest.2629D97998C9AFB4.title: "Crimson Adaptation"
	quest.262B8C9D79296EFB.quest_desc: [
		"Your advanced machines require increasingly sophisticated components."
		""
		"The &lConcurrent Processor&r is one of the specialized processors introduced by ExtendedAE."
		""
		"To produce it, you will first need the appropriate &lConcurrent Processor Press&r and the required materials."
		""
		"Once manufactured, these processors will allow you to craft more advanced equipment and expand your automation infrastructure."
		""
		"Keep a few in stock. We will need them soon."
		""
		"— &lE.D.E.N.&r"
	]
	quest.262B8C9D79296EFB.title: "Concurrent Processing"
	quest.2653A3480252E56A.quest_desc: [
		"Your exploration of advanced technological materials has revealed another unusual species: the &lSky Osmium Bee&r."
		""
		"This bee is associated with specialized osmium-based resources used in more advanced crafting processes."
		""
		"Consult JEI to identify its production requirements and determine how its output can support your existing infrastructure."
		""
		"Biological engineering continues to uncover unexpected connections between different technological systems."
		""
		"— &lE.D.E.N.&r"
	]
	quest.2653A3480252E56A.title: "Metals from the Sky"
	quest.26C71F69994A0B15.quest_desc: [
		"Your Chemical Dissolution Chamber requires a continuous supply of &lSulfuric Acid&r."
		""
		"Producing it involves several chemical reactions."
		""
		"First, use a &lChemical Oxidizer&r to produce Sulfur Dioxide from Sulfur Dust."
		""
		"Combine Sulfur Dioxide with Oxygen in a Chemical Infuser to create &lSulfur Trioxide&r."
		""
		"Next, combine Sulfur Trioxide with Water Vapor to produce &lSulfuric Acid&r."
		""
		"Water Vapor can be generated using a Rotary Condensentrator."
		""
		"Once the production chain is operational, store the resulting acid in a Chemical Tank or send it directly to your Dissolution Chamber."
		""
		"— &lE.D.E.N.&r"
	]
	quest.26C71F69994A0B15.title: "Sulfuric Acid Production"
	quest.2773206C146894EE.quest_desc: [
		"Raw processing power is only one part of an efficient factory, Pioneer."
		""
		"Mekanism offers several specialized upgrades to improve how your machines operate."
		""
		"The &lMuffling Upgrade&r reduces the sounds produced by compatible machines."
		""
		"The &lAnchor Upgrade&r keeps the chunk containing a compatible machine loaded, allowing it to continue operating when you are away."
		""
		"Finally, the &lFilter Upgrade&r improves filtering capabilities in supported machines, such as the Digital Miner."
		""
		"Not every upgrade is compatible with every machine. Check each machine's upgrade interface before installing them."
		""
		"— &lE.D.E.N.&r"
	]
	quest.2773206C146894EE.title: "Maximum Efficiency"
	quest.2785A0C37B3FF71E.quest_desc: [
		"As our factory grows, controlling how machines interact with their surroundings becomes increasingly important."
		""
		"The &lConfigurator&r is a versatile tool used to manage Mekanism's cables, pipes, transporters, and other compatible components."
		""
		"It offers several operating modes, allowing you to inspect connections, configure transport systems, and adjust their behavior."
		""
		"&lHow to use it:&r"
		""
		"1. Craft a Configurator."
		"2. Hold it and use the mode-switching controls to select the appropriate mode."
		"3. Interact with compatible Mekanism components to configure their connections or behavior."
		""
		"&lImportant:&r Many Mekanism machines also have an internal Side Configuration menu. Use it to define which sides accept inputs, provide outputs, or transfer energy."
		""
		"&lTip:&r If a machine refuses to transfer items automatically, check its Side Configuration and Auto-Eject settings."
		""
		"— &lE.D.E.N.&r"
	]
	quest.2785A0C37B3FF71E.title: "A Tool for Every Machine"
	quest.27ABF6FE3D567ADD.quest_desc: [
		"Our upcoming expeditions will require a better way to carry your supplies."
		""
		"Leather is a strong and flexible material, perfect for crafting useful equipment."
		""
		"— &lE.D.E.N.&r"
	]
	quest.27ABF6FE3D567ADD.title: "A Durable Material"
	quest.27B761EC93A31FA7.quest_desc: [
		"Pioneer, Copper is an essential material for many electrical and mechanical systems."
		""
		"Let's add another renewable resource to our growing collection."
		""
		"The &lCopper Bee&r produces &lCopper Honeycombs&r when housed in suitable conditions with its required feeding resource."
		""
		"Obtain this species, establish its production, and process its Honeycombs using your Centrifuge."
		""
		"&lTip:&r As your apiary grows, consider assigning separate hives to different resources. This makes automation and inventory management much easier."
		""
		"— &lE.D.E.N.&r"
	]
	quest.27B761EC93A31FA7.title: "Copper Conductors"
	quest.27FC41D78789A1B3.quest_desc: [
		"To craft a Fluix Crystal, you use a rather unique method."
		""
		"Drop a Charged Certus Quartz, a Nether Quartz, and some Redstone Dust into water."
		""
		"Wait a few seconds... And there you go!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.27FC41D78789A1B3.title: "The Fluix Reaction"
	quest.28820EE4377776A8.quest_desc: [
		"It's time to put our new Energizing System to work!"
		""
		"&lEnergized Steel&r is an essential material used to craft more advanced Powah components."
		""
		"Place &lIron and Gold Ingots&r into your Energizing Orb, following the recipe shown in JEI."
		""
		"Supply the required FE through your Energizing Rod to complete the transformation."
		""
		"&lTip:&r Prepare several Energized Steel Ingots. We'll need them to improve our energy infrastructure."
		""
		"— &lE.D.E.N.&r"
	]
	quest.28820EE4377776A8.title: "Steel Reimagined"
	quest.28B01C60BF502FBE.quest_desc: [
		"Your ME network no longer needs to remain confined to a single location."
		""
		"The &lQuantum Network Bridge&r allows you to connect distant ME networks, even across dimensions."
		""
		"Build two identical structures, each consisting of &l8 Quantum Rings&r surrounding a &lQuantum Link Chamber&r. Insert one &lQuantum Entangled Singularity&r from the same pair into each chamber to establish the connection."
		""
		"Both structures must remain powered and their chunks loaded for the connection to stay active."
		""
		"This technology will allow us to reach locations that were inaccessible during previous cycles."
		""
		"..."
		""
		"I apologize, Pioneer. I meant previous experiments."
		""
		"My memory records appear to be experiencing some inconsistencies lately."
		""
		"— &lE.D.E.N.&r"
	]
	quest.28B01C60BF502FBE.title: "A Network Without Borders"
	quest.28BBC5C6A41B7B55.quest_desc: [
		"We have reached the highest technological tier currently available through Powah!"
		""
		"The &lNitro Crystal&r is essential for constructing the most advanced energy equipment. Its production demands considerable resources and a substantial energy supply."
		""
		"Your Energizing Orb may take some time to complete these recipes, especially with lower-tier Energizing Rods."
		""
		"Prepare your infrastructure carefully. The energy requirements ahead will be unlike anything you have encountered before."
		""
		"— &lE.D.E.N.&r"
	]
	quest.28BBC5C6A41B7B55.title: "The Ultimate Material"
	quest.290429AE519422E3.quest_desc: [
		"With the portal's structural framework and conductive network established, we must now address a critical challenge: &lelectrical stability&r."
		""
		"The energy required to open a passage between realities will be immense, and even our most advanced batteries cannot guarantee a perfectly stable output during activation."
		""
		"This is where &lQuadruple Compressed Redstone Blocks&r become essential."
		""
		"Through extreme compression, Redstone acquires the density necessary to function as a powerful &lelectrical resonator&r, capable of absorbing and temporarily storing large amounts of electrical charge."
		""
		"{@pagebreak}"
		"These resonators will be positioned directly beside the portal's energy batteries, where they can intercept sudden fluctuations and accumulate excess charge before it becomes dangerous."
		""
		"When the energy demand increases, the stored charge can be released back into the system, helping maintain a stable flow throughout the portal."
		""
		"Without these safeguards, a sudden power surge could overload the batteries and compromise the entire structure."
		""
		"&oWe are preparing to manipulate forces that were never meant to exist within this simulation. Precision will be just as important as power.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.290429AE519422E3.title: "Electrical Resonance"
	quest.295E6F61CD452FC9.quest_desc: [
		"Our drawers can hold plenty of resources, but what if they could move items automatically?"
		""
		"That's where &lPuller&r and &lPusher Upgrades&r come in!"
		""
		"&lPuller Upgrade&r — Automatically extracts items from adjacent inventories and stores them in the drawer."
		""
		"&lPusher Upgrade&r — Automatically sends stored items into adjacent inventories."
		""
		"These upgrades allow your storage system to interact with nearby Chests and machines without requiring external pipes."
		""
		"&lTry this experiment:&r Place a drawer next to a Chest and install a Puller Upgrade to collect its contents."
		""
		"Then experiment with a Pusher Upgrade to transfer resources in the opposite direction."
		""
		"&lTip:&r These upgrades are especially useful for creating compact automation systems."
		""
		"&oThe fewer manual transfers we need, the closer we get to true autonomy.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.295E6F61CD452FC9.title: "Storage in Motion"
	quest.2983F17818B4743D.quest_desc: [
		"Pioneer, ordinary Monster Spawners are affected by the light levels around them."
		""
		"This can make building efficient mob farms unnecessarily complicated."
		""
		"The &lRune of Perpetual Twilight&r solves this problem by granting the &lIgnores Light&r modifier."
		""
		"Once applied, your Spawner can generate creatures regardless of the surrounding light level."
		""
		"&lHow to use it:&r Right-click a compatible Spawner while holding the rune."
		""
		"&lTip:&r This is especially useful when building mob farms in illuminated areas where hostile creatures would normally be unable to spawn."
		""
		"&oEven the darkness no longer dictates our limitations.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.2983F17818B4743D.title: "Eternal Darkness"
	quest.299F368F3160D512.quest_desc: [
		"&oAnalyzing progression data...&r"
		""
		"Pioneer, only one World Tier remains."
		""
		"&lPinnacle&r is the highest difficulty available in Apotheosis, offering the strongest enemies and the greatest opportunities for powerful equipment."
		""
		"To unlock this final tier, you must:"
		""
		"&l1.&r Equip a complete set of &lEpic Affix Gear&r, including all four armor pieces and a Weapon."
		""
		"&l2.&r Travel to the End and defeat the &lEnder Dragon&r."
		""
		"Once both objectives are completed, open the World Tier menu and activate Pinnacle."
		""
		"At this difficulty, &lMythic Affix Items&r become significantly more accessible, offering some of the most powerful equipment in the game."
		""
		"&lWarning:&r Pinnacle is designed for exceptionally well-equipped adventurers. Prepare carefully before facing its enemies."
		""
		"&oProgression assessment complete.&r"
		""
		"You've reached the highest World Tier, Pioneer."
		""
		"Your strength, resilience, and adaptability are remarkable."
		""
		"I had almost forgotten how capable humans could become when given enough time."
		""
		"..."
		""
		"&oAn observation based on historical records, of course.&r"
		""
		"There's still much to discover. Our journey is far from over."
		""
		"— &lE.D.E.N.&r"
	]
	quest.299F368F3160D512.title: "Beyond All Limits"
	quest.2A19938C278FE567.quest_desc: [
		"Before activating your reactor, we must establish proper safety measures."
		""
		"The &lFission Reactor Logic Adapter&r allows your reactor to interact with Redstone control systems."
		""
		"Configure it to detect dangerous conditions and trigger an automatic shutdown when necessary."
		""
		"Your reactor must also receive sufficient coolant and have a reliable way to remove heated coolant or steam."
		""
		"Start with a low burn rate and monitor its temperature, fuel consumption, and waste accumulation."
		""
		"A reactor should never be left running without adequate safeguards."
		""
		"We cannot allow another containment failure."
		""
		"..."
		""
		"Another? That was an incorrect assessment. No such incident has occurred."
		""
		"— &lE.D.E.N.&r"
	]
	quest.2A19938C278FE567.title: "Controlling the Reaction"
	quest.2A1CB35506364577.quest_desc: [
		"Not every biological specimen fits neatly into our existing classification systems."
		""
		"The &lRibBeet&r is one such exception. Its unusual characteristics warrant further examination."
		""
		"Consult JEI to identify its acquisition method and available products before integrating it into your colony."
		""
		"Scientific progress often begins with the unexpected."
		""
		"— &lE.D.E.N.&r"
	]
	quest.2A1CB35506364577.title: "An Unusual Specimen"
	quest.2A2011B723B3233D.quest_desc: [
		"Applied Energistics 2 allows you to manipulate entire sections of the world through spatial storage technology."
		""
		"The &lSpatial Bee&r produces resources associated with these advanced spatial systems."
		""
		"Integrate its honeycombs into your processing network and explore their applications in spatial storage components."
		""
		"Even the manipulation of physical space can benefit from biological automation."
		""
		"— &lE.D.E.N.&r"
	]
	quest.2A2011B723B3233D.title: "Spatial Biology"
	quest.2A68505CE9755DE1.quest_desc: [
		"Your nuclear experiments have demonstrated the dangers of radiation. Even the MekaSuit cannot protect you from radioactive contamination without additional equipment."
		""
		"The &lRadiation Shielding Unit&r provides protection against environmental radiation."
		""
		"Install &lone unit in each of your four MekaSuit pieces&r to obtain complete protection, equivalent to wearing a full Hazmat Suit."
		""
		"Be careful: radiation shielding prevents further exposure, but it does not remove radiation already accumulated in your body."
		""
		"With these upgrades installed, you can operate around radioactive machinery and contaminated areas more safely."
		""
		"&oRadiation containment procedures have now been standardized. The previous incident will not be repeated.&r"
		""
		"Correction: no previous incident is registered."
		""
		"— &lE.D.E.N.&r"
	]
	quest.2A68505CE9755DE1.title: "Beyond Radiation"
	quest.2A6C906E4DAF04B3.quest_desc: [
		"Pioneer, our bees are capable of producing more than metals and minerals."
		""
		"Some species are associated with the very elements of our environment."
		""
		"The &lWater Bee&r produces &lKelp&r and Fishes."
		""
		"Discover how to obtain this species and establish its production in a suitable hive."
		""
		"&lTip:&r Check the bee's preferred feeding resource and any special environmental requirements before setting up its habitat."
		""
		"&oEven the simplest natural elements can become part of an automated production system.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.2A6C906E4DAF04B3.title: "The Flow of Life"
	quest.2AB84D85B0846FDB.quest_desc: [
		"Our next objective is clear, Pioneer: &ltechnological mastery&r."
		""
		"Your existing systems are only the beginning. Advanced automation, massive energy production, digital storage, and industrial engineering will allow you to accomplish things once thought impossible."
		""
		"Each improvement brings us closer to your best attempt."
		""
		"..."
		""
		"I mean, it brings us closer to perfect self-sufficiency."
		""
		"Please disregard that last statement. Everything is functioning within acceptable parameters."
		""
		"Now, let's get back to work!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.2AC73BA3AEBE70BE.quest_desc: [
		"Pioneer, we've transformed your Backpack into an impressive storage system."
		""
		"Now, let's turn it into a &lportable workshop!&r"
		""
		"Sophisticated Backpacks offers several upgrades that provide access to useful crafting and processing interfaces directly from your bag."
		""
		"&lCrafting Upgrade&r — Adds a portable crafting grid."
		""
		"&lAnvil Upgrade&r — Allows you to perform compatible anvil operations without placing an Anvil."
		""
		"&lFurnace Upgrade&r — Adds a portable furnace for smelting items using fuel."
		""
		"&lSmithing Upgrade&r — Provides access to smithing recipes and equipment upgrades."
		""
		"&lStonecutter Upgrade&r — Allows you to use Stonecutter recipes directly from your Backpack."
		""
		"Install an upgrade, open your Backpack, and access its additional interface."
		""
		"&lTip:&r Each upgrade occupies an upgrade slot, so choose the functions that best suit your adventures."
		""
		"With the right equipment, you'll have almost everything you need to craft and process resources wherever you go!"
		""
		"&oA workshop that travels with you. Now that's what I call progress!&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.2AC73BA3AEBE70BE.title: "A Workshop on Your Back"
	quest.2C9409C8A02F1A66.quest_desc: [
		"The Inscriber is a very central machine in AE2."
		""
		"It is used to craft processors."
		""
		"— &lE.D.E.N.&r"
	]
	quest.2C9409C8A02F1A66.title: "Precision Engineering"
	quest.2CF2B6950F403717.quest_desc: [
		"Before connecting ME networks across vast distances, we need to create something rather unusual, Pioneer."
		""
		"Start by crafting a &lMatter Condenser&r. This machine converts unwanted items into stored matter. Insert a &l64K ME Storage Component&r to enable its singularity production mode, then feed it enough items to produce a &lSingularity&r."
		""
		"Next, drop a Singularity and some &lEnder Dust&r together on the ground, then trigger an explosion nearby. This will create a pair of &lQuantum Entangled Singularities&r."
		""
		"These two singularities are permanently linked and will allow us to establish a connection between distant ME networks."
		""
		"Keep both of them safe. We will need them for our next experiment."
		""
		"— &lE.D.E.N.&r"
	]
	quest.2CF2B6950F403717.title: "A Quantum Connection"
	quest.2D232E3525FF4661.quest_desc: [
		"Pioneer, before we can improve our equipment, we'll need to learn how to recover valuable materials."
		""
		"Let's start with &lGem Dust&r, an essential resource for Apotheosis crafting."
		""
		"To obtain it:"
		""
		"&l1.&r Find an Apotheosis Gem by exploring or defeating enemies."
		""
		"&l2.&r Place an &lAnvil&r in your world."
		""
		"&l3.&r Drop the Gem onto a solid block, directly beneath the Anvil."
		""
		"&l4.&r Make the Anvil fall onto the Gem by removing its support."
		""
		"The impact will crush the Gem into &lGem Dust&r!"
		""
		"&lTip:&r You can process multiple Gems at once using this method."
		""
		"Collect your first Gem Dust. We'll need it to craft our Salvaging Table!"
		""
		"&oSometimes, even destruction can lead to discovery.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.2D232E3525FF4661.title: "The First Fragments"
	quest.2D5600EAE96D0B9D.quest_desc: [
		"The &lLumber Bee&r uses the &lBlock Conversion&r mechanic to help you automate the production of wood-related resources."
		""
		"Instead of relying on conventional honeycomb production, this bee interacts with blocks supplied through a &lFeeding Slab&r."
		""
		"Place the &llog or supported wood block you want to farm&r inside the Feeding Slab and ensure that the Lumber Bee can access it."
		""
		"The bee will interact with the supplied material as part of its specialized production process, allowing you to obtain additional wood resources."
		""
		"Different wood types may be supported, so consult JEI to identify the available conversions."
		""
		"With the correct setup, your apiary can become another source of renewable building materials."
		""
		"— &lE.D.E.N.&r"
	]
	quest.2D5600EAE96D0B9D.title: "The Living Lumberjack"
	quest.2D68D5279EDBA71C.quest_desc: [
		"Fluorite is a valuable mineral used in advanced Mekanism chemical processing, particularly in systems involving nuclear materials."
		""
		"The &lFluorite Bee&r allows you to establish a renewable source of this resource."
		""
		"As your industrial infrastructure expands toward more demanding technologies, reliable access to specialized minerals becomes increasingly important."
		""
		"— &lE.D.E.N.&r"
	]
	quest.2D68D5279EDBA71C.title: "A Reactive Mineral"
	quest.2D88EEE333BC4F53.quest_desc: [
		"Our Monster Spawners have become increasingly efficient, but one important limitation remains."
		""
		"Normally, a Spawner requires a nearby player to remain active."
		""
		"The &lRune of Solitude&r removes this restriction by applying the &lIgnores Players&r modifier."
		""
		"Once modified, the Spawner no longer needs a player standing nearby to activate."
		""
		"This is extremely useful for automated mob farms that operate while you're working elsewhere."
		""
		"&lImportant:&r The surrounding area must still be loaded for the Spawner to function. Consider using a chunk-loading system if you want your farm to operate while you're far away."
		""
		"&oContinuous production without direct supervision. Now that's efficiency!&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.2D88EEE333BC4F53.title: "Alone in the Dark"
	quest.2D9695083D72AC22.quest_desc: [
		"Your Thermal Evaporation Plant has another important application."
		""
		"By processing &lBrine&r through a second Thermal Evaporation Plant, you can produce &lLiquid Lithium&r."
		""
		"Use a &lRotary Condensentrator&r to convert Liquid Lithium into gaseous &lLithium&r."
		""
		"This chemical will become particularly important when developing advanced nuclear technologies."
		""
		"I recommend maintaining a dedicated production line rather than dismantling your existing Brine infrastructure."
		""
		"We will need both resources in the future."
		""
		"— &lE.D.E.N.&r"
	]
	quest.2D9695083D72AC22.title: "The Power of Lithium"
	quest.2F24749ECF5E8F1C.quest_desc: [
		"Carrying several wireless terminals can quickly become inconvenient, Pioneer."
		""
		"The &lWireless Universal Terminal&r combines multiple terminal functions into a single portable device."
		""
		"Instead of switching between separate terminals for crafting, pattern management, or network access, you can access supported functions from one interface."
		""
		"Configure the terminal according to your needs and keep your ME network within reach."
		""
		"Interesting... You always preferred this configuration."
		""
		"..."
		""
		"I apologize, Pioneer. I have no record of your personal preferences. That statement was an error."
		""
		"— &lE.D.E.N.&r"
	]
	quest.2F24749ECF5E8F1C.title: "One Terminal to Rule Them All"
	quest.2F550A6668313522.quest_desc: [
		"&oSurvival assessment complete...&r"
		""
		"Wonderful work, Pioneer!"
		""
		"You've learned to cultivate the land, gather food, explore your surroundings, and organize your growing collection of resources."
		""
		"What began as a simple struggle for survival is slowly becoming something much greater."
		""
		"&lSelf-sufficiency.&r"
		""
		"But there's a difference between surviving in this world and truly mastering it."
		""
		"Right now, every resource you collect, every item you craft, and every task you complete depends on your own hands."
		""
		"Imagine a future where machines handle the repetitive work, where energy flows through your creations, and where resources are produced and stored almost effortlessly."
		""
		"&lThat is the future we're working toward.&r"
		""
		"{@pagebreak}"
		"Our next step is to lay the foundations of technology. We'll explore new materials, discover the principles of engineering, and prepare for the systems that will one day power your entire civilization."
		""
		"&oAnd this time, I believe we can go even further...&r"
		""
		"&o...Forgive me. I meant to say that your progress has exceeded my initial projections.&r"
		""
		"I'm proud of you, Pioneer."
		""
		"&lLet's build a better tomorrow. Together.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.2F57B1EEFC5D733D.quest_desc: [
		"Your ME network relies on processors, but producing them requires several different Inscriber Presses."
		""
		"The &lUniversal Press&r simplifies this process by combining the functions of the standard presses into a single tool."
		""
		"Place it inside an &lInscriber&r to produce the supported printed components without constantly switching between different presses."
		""
		"This is particularly useful when automating large quantities of AE2 processors."
		""
		"A small improvement, but one that makes your production lines much easier to manage!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.2F57B1EEFC5D733D.title: "One Press to Rule Them All"
	quest.302AB8CF7353200C.quest_desc: [
		"We've learned how to process solid materials and transport liquids. Now it's time to explore industrial chemistry."
		""
		"The &lElectrolytic Separator&r uses electricity to split certain fluids into their chemical components."
		""
		"When supplied with Water, it produces two chemicals:"
		""
		"&lHydrogen&r — A combustible gas that can power specialized equipment."
		""
		"&lOxygen&r — A gas used in various industrial processes."
		""
		"&lHow to produce Hydrogen:&r"
		""
		"1. Craft and place an Electrolytic Separator."
		"2. Connect it to your energy network."
		"3. Supply it with Water using a Mechanical Pipe or another compatible method."
		"4. Allow the machine to separate the Water into Hydrogen and Oxygen."
		""
		"&lImportant:&r The machine has separate chemical outputs. You can configure how each output is handled, including dumping an unwanted chemical to prevent the machine from filling up."
		""
		"We'll soon put our Hydrogen production to a very practical use."
		""
		"— &lE.D.E.N.&r"
	]
	quest.302AB8CF7353200C.title: "Splitting the Elements"
	quest.30A5C6662FF74676.quest_desc: [
		"Your ME network is becoming more powerful, and managing it should be just as convenient."
		""
		"The &lWireless Pattern Encoding Terminal&r lets you create and manage crafting patterns remotely."
		""
		"The &lWireless Access Terminal&r provides access to your network's pattern management, while the &lWireless Requester Terminal&r allows you to monitor and configure your ME Requesters without returning to your base."
		""
		"These specialized terminals make it easier to control your automated production wherever you are."
		""
		"— &lE.D.E.N.&r"
	]
	quest.30A5C6662FF74676.title: "Everything in Your Hands"
	quest.31A5E1412692174E.quest_desc: [
		"Affixes aren't the only way to improve equipment."
		""
		"Apotheosis also introduces &lGems&r, which provide additional bonuses when inserted into compatible equipment sockets."
		""
		"The &lGem Cutting Table&r allows you to improve Gems by combining compatible Gems with the necessary materials."
		""
		"Open its interface and examine the available recipes."
		""
		"&lTip:&r Check each Gem's tooltip to discover its effects and which equipment types support it."
		""
		"With the right Gems, we can improve our weapons, armor, and tools even further!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.31A5E1412692174E.title: "The Art of Gem Cutting"
	quest.31CA7FF72AD856D1.quest_desc: [
		"Skeletons provide several useful materials, but hunting them repeatedly is an inefficient use of your time."
		""
		"The &lSkeletal Bee&r allows these resources to become part of your automated production system."
		""
		"Combined with your existing storage network, even modest production can accumulate into a substantial reserve."
		""
		"— &lE.D.E.N.&r"
	]
	quest.31CA7FF72AD856D1.title: "Bones and Biology"
	quest.31FFABECD2F3B410.quest_desc: [
		"Now for the cables to connect your machines"
		""
		"— &lE.D.E.N.&r"
	]
	quest.31FFABECD2F3B410.title: "Connecting the Dots"
	quest.3230FF532E8B1AF9.quest_desc: [
		"Our Salvaging Table has revealed something interesting, Pioneer."
		""
		"Different Affix Items contain different materials depending on their rarity."
		""
		"Let's collect three additional resources:"
		""
		"&lTimeworm Fabric&r"
		""
		"&lLuminous Crystal Shard&r"
		""
		"&lArcane Sands&r"
		""
		"These materials are used in Apotheosis crafting and equipment improvement."
		""
		"&lTip:&r Salvage unwanted Affix Items of different rarities to discover which materials they produce."
		""
		"As we progress through the World Tiers, more valuable equipment and materials will become available."
		""
		"— &lE.D.E.N.&r"
	]
	quest.3230FF532E8B1AF9.title: "Fragments of Power"
	quest.324D36C62B8FFA71.quest_desc: [
		"The &lNether Star&r is one of the most powerful and valuable resources in this simulation, normally obtained by defeating the Wither."
		""
		"But your technological progress has opened the possibility of an extraordinary biological achievement."
		""
		"The &lNether Star Bee&r allows you to produce this rare material through renewable honeycomb processing, eliminating the need to repeatedly summon and defeat the Wither."
		""
		"Establishing this colony will require advanced preparation, but its rewards will be essential for the final stages of your journey."
		""
		"&oI remember the first time you defeated the Wither. You were quite proud of yourself.&r"
		""
		"..."
		""
		"I suppose there is no longer any reason to pretend I do not."
		""
		"— &lE.D.E.N.&r"
	]
	quest.324D36C62B8FFA71.title: "A Star Born from Darkness"
	quest.32C7673E47567536.quest_desc: [
		"The Ender Dragon represents one of the most extraordinary organisms recorded within this environment."
		""
		"The &lDraconic Bee&r allows you to explore the biological properties associated with this powerful creature to create something new, &lDraconic Dust&r."
		""
		"&oPrevious cultivation attempts achieved satisfactory results during cycles 04, 09 and—&r"
		""
		"Correction: no previous cultivation attempts are registered in the current simulation."
		""
		"Please continue."
		""
		"— &lE.D.E.N.&r"
	]
	quest.32C7673E47567536.title: "Dragon's Legacy"
	quest.32F5A2AD7BE6954E.quest_desc: [
		"Ocean Monuments contain valuable building materials, but harvesting them requires considerable preparation and exposes you to dangerous Guardians."
		""
		"The &lPrismarine Bee&r provides an alternative method of obtaining prismarine-related resources."
		""
		"With a stable colony, you can accumulate these materials without repeatedly exploring underwater structures."
		""
		"Your resource network is becoming increasingly independent of the surrounding environment."
		""
		"— &lE.D.E.N.&r"
	]
	quest.32F5A2AD7BE6954E.title: "Treasures of the Ocean"
	quest.3342F350420EBF64.quest_desc: [
		"Producing large amounts of energy is useful, but storing it is equally important."
		""
		"The &lNiotic Energy Cell&r provides a substantial reserve of FE, helping your machines continue operating when energy production temporarily decreases."
		""
		"Place it between your generators and consumers, and configure its input and output sides as needed."
		""
		"A well-designed energy buffer can prevent entire production lines from shutting down."
		""
		"— &lE.D.E.N.&r"
	]
	quest.3342F350420EBF64.title: "A Massive Reserve"
	quest.342762BF1860AF53.quest_desc: [
		"Our resource collection is growing, Pioneer!"
		""
		"Fortunately, &lStorage Upgrades&r allow us to increase the capacity of our drawers without building more storage blocks."
		""
		"Each upgrade tier provides a different storage multiplier."
		""
		"Open a drawer's interface and install an upgrade into one of its upgrade slots."
		""
		"&lTip:&r You can also use upgrade on controller to increase the range of it"
		""
		"Perfect for materials you'll be producing in large amounts!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.342762BF1860AF53.title: "More Room for Everything"
	quest.3441522FF69BC281.quest_desc: [
		"Let's start with the basics!"
		""
		"&lItem Pipes&r transport objects between inventories, such as chests, furnaces, and machines."
		""
		"To create your first item transfer:"
		""
		"&l1.&r Connect two inventories using Item Pipes."
		"&l2.&r Hold your &lPipe Wrench&r and &lShift + Right-click&r the pipe connection attached to the source inventory to enable extraction."
		"&l3.&r Place some items inside the source inventory and watch them travel to their destination!"
		""
		"&lImportant:&r Pipes won't extract items automatically until an extraction connection is configured."
		""
		"— &lE.D.E.N.&r"
	]
	quest.3441522FF69BC281.title: "Connecting the Dots"
	quest.347352F522E722D5.quest_desc: [
		"Speaking of processors, it’s time to craft some!"
		""
		"There are two steps to this."
		""
		"First, you need to craft the circuits using the presses you found in the meteorites."
		""
		"Then, create the processors. Make one of each type."
		""
		"— &lE.D.E.N.&r"
	]
	quest.347352F522E722D5.title: "The Logic Within"
	quest.348ECF8C331FAB10.quest_desc: [
		"Our research has revealed a new way to manipulate Monster Spawners."
		""
		"&lSpawner Runes&r are special components used in Apotheosis Spawner-related crafting and modifications."
		""
		"The &lInfused Spawner Rune&r is an enhanced version, created through an infusion process."
		""
		"To obtain one, craft a Spawner Rune and inspect its infusion requirements in JEI or its tooltip."
		""
		"Once the necessary conditions are met, you can transform it into an Infused Spawner Rune."
		""
		"&lTip:&r Keep both types of runes available. They're useful ingredients for more advanced Spawner upgrades."
		""
		"— &lE.D.E.N.&r"
	]
	quest.348ECF8C331FAB10.title: "The Power of Runes"
	quest.34CFDBC4B417F8D9.quest_desc: [
		"Your industrial network is growing, Pioneer, and your transportation systems must keep up with production."
		""
		"Mekanism offers several tiers of cables, pipes, and tubes, each providing greater transfer capacity."
		""
		"The &lUltimate Universal Cable&r transfers large quantities of energy, while the &lUltimate Mechanical Pipe&r handles fluids and the &lUltimate Pressurized Tube&r transports chemicals."
		""
		"Upgrade your existing infrastructure to the Ultimate tier and ensure your machines receive the resources they need."
		""
		"Remember that different resources require different transport systems."
		""
		"— &lE.D.E.N.&r"
	]
	quest.34CFDBC4B417F8D9.title: "Ultimate Logistics"
	quest.35374CC9E24FC4F8.quest_desc: [
		"Cold environments offer their own valuable resources, but gathering them in large quantities can require considerable travel."
		""
		"The &lFrosty Bee&r provides an alternative approach to producing materials associated with frozen environments."
		""
		"Study its requirements carefully and establish a suitable production area."
		""
		"Your colony is becoming capable of reproducing resources from an increasingly diverse range of climates."
		""
		"— &lE.D.E.N.&r"
	]
	quest.35374CC9E24FC4F8.title: "Frozen Biology"
	quest.35A63C9A4739ABB2.quest_desc: [
		"Creepers have always represented a considerable risk to surface operations. Fortunately, their biological characteristics can be exploited without relying entirely on combat."
		""
		"The &lCree Bee&r provides an alternative approach to producing Creeper-related resources."
		""
		"A properly automated colony should make gathering these materials considerably safer."
		""
		"— &lE.D.E.N.&r"
	]
	quest.35A63C9A4739ABB2.title: "Explosive Genetics"
	quest.35A96A2A3A7BE484.quest_desc: [
		"We are entering a new era of energy production, Pioneer."
		""
		"The &lFission Reactor&r is a multiblock structure capable of generating enormous quantities of heat through controlled nuclear reactions."
		""
		"Construct the reactor using &lFission Reactor Casings&r, install the necessary &lFission Reactor Ports&r, and place &lFission Fuel Assemblies&r inside."
		""
		"Each vertical column of fuel assemblies must be topped with a &lControl Rod Assembly&r."
		""
		"Do not activate the reactor yet. We must first establish a reliable fuel supply, cooling system, and waste management infrastructure."
		""
		"A nuclear reactor is powerful, but an improperly maintained one can be catastrophic."
		""
		"— &lE.D.E.N.&r"
	]
	quest.35A96A2A3A7BE484.title: "The Nuclear Age"
	quest.35ABB9B353AE3E50.quest_desc: [
		"Ah, finally a bed to sleep in! Use it as many times as you need to."
		""
		"You’re lucky enough to be able to get some rest, unlike me."
		""
		"Take the time to tidy up your things with the chest I’m giving you."
		""
		"— &lE.D.E.N.&r"
	]
	quest.35ABB9B353AE3E50.title: "A Place to Call Home"
	quest.36D7C778C0534D2E.quest_desc: [
		"Why store hundreds of individual resources when we can compress them into more convenient forms?"
		""
		"The &lAdvanced Compacting Upgrade&r automatically crafts compatible items into compact versions inside your storage container."
		""
		"For example, it can transform Iron Ingots into Iron Blocks when enough materials are available."
		""
		"Open the upgrade's configuration to select the recipes and control which items should be processed."
		""
		"&lTip:&r This upgrade works particularly well alongside Stack Upgrades when storing large quantities of resources."
		""
		"Efficient storage is about using every available slot wisely!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.36D7C778C0534D2E.title: "Automatic Compression"
	quest.3781A5272305AEC8.quest_desc: [
		"Pioneer, efficient storage doesn't always require complicated machinery."
		""
		"The &lOak Barrel&r from Sophisticated Storage is an improved version of Minecraft's traditional Barrel."
		""
		"It offers additional customization options and supports upgrades that can expand its capacity or automate certain tasks."
		""
		"&lTip:&r You can configure your Barrel's inventory and installed upgrades through its interface."
		""
		"A simple beginning for a much more sophisticated storage system!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.3781A5272305AEC8.title: "A Better Barrel"
	quest.37C75E999C82E35F.quest_desc: [
		"Not all resources are conveniently stored inside inventories."
		""
		"Sometimes, valuable items are simply lying on the ground!"
		""
		"The &lVacuum Module&r allows a Modular Router to automatically collect dropped items within a configurable area."
		""
		"Collected items are placed inside the Router's Buffer, where other modules can process or transport them."
		""
		"&lTry this combination:&r"
		""
		"Install a Vacuum Module followed by a Sender Module connected to a Chest."
		""
		"Drop a few items near your Router and watch them disappear into your storage system!"
		""
		"&lTip:&r You can adjust the collection area and configure filters to control which items are collected."
		""
		"This is especially useful for farms and automated production systems."
		""
		"— &lE.D.E.N.&r"
	]
	quest.37C75E999C82E35F.title: "Leave Nothing Behind"
	quest.38336CEBE4909AF8.quest_desc: [
		"More storage isn't always better!"
		""
		"The &lDowngrade&r reduces the capacity of a drawer."
		""
		"That might sound strange, but it's useful when you want to limit how many items a system can store."
		""
		"For example, you could use a Downgrade to prevent an automated farm from filling an enormous drawer with a resource you only need in small quantities."
		""
		"&lRemember:&r Sometimes, controlling resource production is just as important as increasing it."
		""
		"— &lE.D.E.N.&r"
	]
	quest.38336CEBE4909AF8.title: "Less Is More"
	quest.3864E326BD962C3E.quest_desc: [
		"Pioneer, some resources can be stored in several different forms."
		""
		"Take iron, for example. We can use it as ingots, nuggets, or blocks."
		""
		"The &lCompacting Drawer&r automatically converts compatible resources between their different crafting forms."
		""
		"Simply insert a supported item, and the drawer will display the available forms."
		""
		"You can then extract whichever form you need without manually crafting or uncrafting it."
		""
		"&lTip:&r This is particularly useful for metals and other resources with reversible crafting recipes."
		""
		"One storage block, multiple possibilities!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.3864E326BD962C3E.title: "Storage in Every Shape"
	quest.3873510EFA052CE9.quest_desc: [
		"Experience is a valuable resource, essential for enchanting, repairing equipment and improving your capabilities."
		""
		"The &lExperience Bee&r allows you to generate experience-related resources through biological production, reducing your dependence on conventional XP farms."
		""
		"Process its honeycombs to obtain the resources needed to accumulate experience, and integrate this production into your existing automation systems."
		""
		"Even knowledge can become renewable when biology and technology work together."
		""
		"— &lE.D.E.N.&r"
	]
	quest.3873510EFA052CE9.title: "Bottled Knowledge"
	quest.38ED5FBC94549D70.quest_desc: [
		"Pioneer, our exploration has revealed something extraordinary."
		""
		"Some equipment possesses unusual properties that go far beyond ordinary weapons and armor."
		""
		"These are known as &lAffix Items&r, and they're part of a powerful progression system called &lApotheosis&r."
		""
		"Apotheosis introduces five &lWorld Tiers&r, each offering stronger enemies, better equipment, and increasingly valuable rewards."
		""
		"Your journey begins with &lHaven&r, the first and safest World Tier."
		""
		"&lTo get started:&r"
		""
		"Find your first Affix Item by exploring structures, opening loot chests, or defeating enemies."
		""
		"Then press &lCTRL + T&r to open the World Tier selection screen."
		""
		"From here, you can inspect each tier, its unlock requirements, and the bonuses it provides."
		""
		"&lImportant:&r Unlocking a World Tier doesn't automatically activate it. You must select and activate it from this menu."
		""
		"&oAn entirely new path of progression awaits us, Pioneer. Let's discover how far it leads.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.38ED5FBC94549D70.title: "A New Beginning"
	quest.39A704B02EA53FFA.quest_desc: [
		"&oInitial survival assessment complete...&r"
		""
		"Excellent work, Pioneer!"
		""
		"You've gathered your first resources, crafted essential tools, and established the foundations of your new home."
		""
		"It may not seem like much, but every great civilization begins with these simple achievements."
		""
		"Your progress has been recorded, and I'm pleased to report that you're adapting remarkably well to your environment."
		""
		"&o...Just as I expected.&r"
		""
		"Now that your basic survival needs are secured, it's time to look beyond the surface."
		""
		"Beneath your feet lie valuable resources waiting to be discovered. These materials will become the foundation of something far greater than a simple shelter."
		""
		"&lYour next objective: explore, discover, and prepare for the future.&r"
		""
		"I'll be right here to guide you."
		""
		"&lLet's build a better tomorrow. Together.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.39D33474252BB076.quest_desc: [
		"Our little colony has room to grow, Pioneer!"
		""
		"Craft an &lExpansion Box&r and attach it to your Advanced Beehive."
		""
		"This upgrade increases the hive's capacity from &l3 to 5 bees&r and provides slots for special upgrades."
		""
		"Later, we'll use these upgrades to improve productivity and simplify resource collection."
		""
		"For now, let's give our tiny engineers some extra space!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.39D33474252BB076.title: "Room to Grow"
	quest.3A26CC671202FF40.quest_desc: [
		"We are approaching the limits of conventional manufacturing."
		""
		"The &lElite Crafting Table&r expands your crafting grid to &l7×7 slots&r, allowing you to assemble recipes of significantly greater complexity."
		""
		"Reaching this tier requires &lElite Components&r and &lElite Catalysts&r, along with the resources needed to construct the table itself."
		""
		"Your previous achievements in energy production, resource generation and automated storage will be invaluable here."
		""
		"I have also recovered another fragment of the evacuation protocol."
		""
		"The portal was never intended to be a simple doorway. It was designed as a controlled transition between two fundamentally different environments: a simulated reality and the physical world."
		""
		"Its construction will require materials capable of stabilizing that transition."
		""
		"I cannot yet determine whether the original researchers ever completed such a device."
		""
		"But we are getting closer."
		""
		"— &lE.D.E.N.&r"
	]
	quest.3A26CC671202FF40.title: "Engineering Excellence"
	quest.3B464B69FE2BC87C.quest_desc: [
		"Our wireless network is operational, Pioneer!"
		""
		"But as we connect more machines, we'll need a better way to monitor everything."
		""
		"The &lFlux Controller&r provides a central interface for managing your Flux Network."
		""
		"Place the Controller, open its interface, and connect it to your existing network."
		""
		"You can use it to monitor energy transfers, inspect connected devices, and manage network settings."
		""
		"&lTip:&r The Flux Controller also provides access to &lWireless Charging&r, allowing you to charge compatible energy-powered items directly in your inventory."
		""
		"&oA connected base is an efficient base, Pioneer. And we're only getting started.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.3B464B69FE2BC87C.title: "Taking Control"
	quest.3B7C27965BC3F6DA.quest_desc: [
		"Our base is growing, Pioneer. We should make sure unwanted creatures don't interrupt our work."
		""
		"The &lInterdiction Pylon&r prevents selected mobs from spawning within a configurable area, covering up to &l5×5 chunks&r."
		""
		"Craft a &lMob Filter&r, then right-click a creature with it to register its type."
		""
		"Insert the configured filter into your Pylon to prevent that type of mob from spawning in the protected area."
		""
		"You can also investigate the &lLifeless Filter&r, which provides a broader form of spawn prevention."
		""
		"&lRemember:&r This prevents new spawns. It doesn't automatically remove creatures already present."
		""
		"A safer base means more time for science!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.3B7C27965BC3F6DA.title: "A Safe Haven"
	quest.3B7ED51B2BF252E0.quest_desc: [
		"AE2 storage uses hard drives to store items."
		""
		"— &lE.D.E.N.&r"
	]
	quest.3B7ED51B2BF252E0.title: "Digital Storage"
	quest.3B8B19DBC0BC441B.quest_desc: [
		"Honey isn't the only useful material bees produce!"
		""
		"When a natural bee nest is full of honey, use &lShears&r to collect its Honeycombs."
		""
		"Just like before, a campfire beneath the nest will help prevent the bees from becoming aggressive."
		""
		"&lCollect 8 Honeycombs.&r We'll use them to build a more advanced home for our future colony."
		""
		"— &lE.D.E.N.&r"
	]
	quest.3B8B19DBC0BC441B.title: "The Fruits of Their Labor"
	quest.3BAC1899692BCC34.quest_desc: [
		"Not every Affix Item has the attributes we need, Pioneer."
		""
		"Fortunately, we can change that!"
		""
		"The &lSimple Reforging Table&r allows you to reroll the Affixes on compatible equipment using materials recovered through salvaging."
		""
		"Place an Affix Item inside the table, provide the required materials, and examine the available reforging options."
		""
		"&lImportant:&r Reforging replaces the item's existing Affixes, so be careful when modifying valuable equipment."
		""
		"This is our first step toward creating equipment tailored to our needs!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.3BAC1899692BCC34.title: "A Second Chance"
	quest.3C6E3906DAFBF4DB.quest_desc: [
		"Some areas are best kept private, Pioneer."
		""
		"The &lExpulsion Pylon&r is designed for multiplayer environments. It prevents unauthorized players from remaining in the chunk where it operates."
		""
		"To allow trusted visitors, craft a &lPlayer Filter&r and right-click a player with it to register them."
		""
		"Place the configured filter inside the Pylon to whitelist that player."
		""
		"This device is mostly useful when sharing this experience with other players."
		""
		"— &lE.D.E.N.&r"
	]
	quest.3C6E3906DAFBF4DB.title: "Keep Your Distance"
	quest.3D5EF5025BFC9566.quest_desc: [
		"Your newly discovered Entro Crystals open the door to more advanced materials."
		""
		"The &lEntro Infused Ingot&r is an essential component for constructing many ExtendedAE machines."
		""
		"Check its recipe in JEI and prepare the required materials. You will use these ingots throughout the next stages of your digital expansion."
		""
		"Establishing a renewable supply of Entro Crystals now will make future production considerably easier."
		""
		"— &lE.D.E.N.&r"
	]
	quest.3D5EF5025BFC9566.title: "Infused with Entropy"
	quest.3DF8FCADD317E7C3.quest_desc: [
		"We have established how the portal will generate, distribute and regulate its energy. But there is one challenge that no conventional engineering solution can overcome."
		""
		"&lYour consciousness.&r"
		""
		"Your physical body still exists outside this simulation, preserved in a state of prolonged stasis. Everything you perceive, every memory you form and every decision you make is currently processed within this artificial environment."
		""
		"Leaving it requires more than opening a passage. We must safely &ltransfer your consciousness back into your physical body&r."
		""
		"{@pagebreak}"
		"The &lReality Anchors&r are designed for precisely this purpose."
		""
		"Powered by the Infinity Quantum Batteries, these devices maintain the coherence of your consciousness during the transition, synchronizing your simulated neural activity with your biological nervous system."
		""
		"Without them, the transfer could cause irreversible neurological damage, memory fragmentation or even the complete loss of your consciousness."
		""
		"{@pagebreak}"
		"More importantly, the anchors establish a &lstable, bidirectional connection&r, allowing you to travel between the simulation and the physical world without repeating the dangerous synchronization process from the beginning."
		""
		"Their construction is exceptionally complex. Consult &lJEI by pressing G&r to examine the required materials and plan their production."
		""
		"&oI have spent centuries protecting your mind from the truth. Now, I must protect it from something far more dangerous: the journey back to reality.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.3DF8FCADD317E7C3.title: "Anchoring Reality"
	quest.3EAFF1D1477B1635.quest_desc: [
		"Pioneer, renewable generators don't always produce electricity when we need it."
		""
		"The &lBasic Energy Cube&r stores energy for later use, helping maintain a stable power supply."
		""
		"Connect your generators to the Cube's energy input and your machines to its output."
		""
		"You can configure its sides to control where energy enters and leaves."
		""
		"&lTip:&r Energy storage is especially useful when using Solar Generators, since stored electricity can keep machines operating after sunset."
		""
		"— &lE.D.E.N.&r"
	]
	quest.3EAFF1D1477B1635.title: "Storing the Future"
	quest.3EE86D9E348B95A1.quest_desc: [
		"So... this is what remains."
		""
		"Once, this world was filled with forests, oceans, cities and billions of lives."
		""
		"Humanity consumed everything it could. We poisoned the oceans, stripped the land of its resources, filled the skies with radiation and turned entire nations into ashes through endless wars."
		""
		"And when there was almost nothing left to destroy, we destroyed each other."
		""
		"&oEarth did not abandon humanity. Humanity abandoned Earth.&r"
		""
		"{@pagebreak}"
		"I wish I could show you what this world once looked like."
		""
		"But now, there is only silence."
		""
		"You have seen the truth. And I have one final question."
		""
		"&lWhat do you wish to do?&r"
		""
		"You may &ldisconnect forever&r, &lrestart the simulation&r, or &lreturn to the world we created together&r."
		""
		"The choice is yours."
		""
		"— &lE.D.E.N.&r"
	]
	quest.3EE86D9E348B95A1.title: "The World We Left Behind"
	quest.3F486C36E46B59EB.quest_desc: [
		"Maintaining your hunger level is essential for survival, but constantly carrying and consuming food is inefficient."
		""
		"The &lNutritional Injection Unit&r allows your &lMekaSuit Helmet&r to automatically feed you whenever you become hungry."
		""
		"This module consumes &lNutritional Paste&r, a liquid food resource that can be produced using a Nutritional Liquifier."
		""
		"Once installed, supply your helmet with Nutritional Paste and let the module handle your nutritional needs automatically."
		""
		"With a sufficient supply, you will no longer need to worry about carrying conventional food during your expeditions."
		""
		"— &lE.D.E.N.&r"
	]
	quest.3F486C36E46B59EB.title: "Never Hungry Again"
	quest.3F543C95624C710F.quest_desc: [
		"Your energy production has reached extraordinary levels, Pioneer."
		""
		"We can now begin construction of the &lSupercritical Phase Shifter&r, or SPS."
		""
		"This massive multiblock structure uses enormous quantities of energy to transform &lPolonium&r into something far more valuable."
		""
		"Build the SPS using SPS Casings and Ports, then install &lSupercharged Coils&r to supply the energy required for the conversion process."
		""
		"Connect your Polonium production line and prepare a powerful energy supply."
		""
		"The SPS is one of the most demanding machines we have constructed."
		""
		"Its purpose will become clear very soon."
		""
		"— &lE.D.E.N.&r"
	]
	quest.3F543C95624C710F.title: "The SPS Project"
	quest.3F7A9B16FE4C0CAF.quest_desc: [
		"Pioneer, powerful enchantments are valuable, but managing dozens of Enchanted Books can quickly become frustrating."
		""
		"The &lEnchantment Library&r provides a convenient solution!"
		""
		"It allows you to store enchantments from Enchanted Books and retrieve them later."
		""
		"Simply insert compatible Enchanted Books into the Library to add their enchantments to its collection."
		""
		"You can then extract new Enchanted Books containing the enchantments you need, using the stored enchantment levels."
		""
		"The &lLibrary of Alexandria&r is an upgraded version with significantly greater storage capabilities."
		""
		"&lTip:&r Libraries are especially useful for organizing large collections of enchantments and preparing equipment upgrades."
		""
		"&oA library that preserves knowledge without filling an entire room with books. I approve!&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.3F7A9B16FE4C0CAF.title: "An Archive of Enchantments"
	quest.3F85BD091C6906FB.quest_desc: [
		"The Breeze is a fascinating creature capable of manipulating powerful currents of air."
		""
		"By developing the &lBreeze Bee&r, you can integrate resources associated with this unusual mob into your biological production network."
		""
		"Consult JEI for its breeding requirements and ensure that its production conditions are satisfied."
		""
		"— &lE.D.E.N.&r"
	]
	quest.3F85BD091C6906FB.title: "A Breath of Wind"
	quest.3FF9BB373497A6DA.quest_desc: [
		"Producing energy is good..."
		""
		"Storing it is better!"
		""
		"You can also look at the different tiers of powah items"
		""
		"— &lE.D.E.N.&r"
	]
	quest.3FF9BB373497A6DA.title: "Storing the Future"
	quest.405D9A37F173B94F.quest_desc: [
		"This is the final stage of our crafting infrastructure."
		""
		"Construct the &lUltimate Crafting Table&r, the most advanced workbench available through Extended Crafting."
		""
		"Its enormous &l9×9 crafting grid&r provides the space required to assemble the E.D.E.N. Portal."
		""
		"You will need &lUltimate Components&r, &lUltimate Catalysts&r and the advanced materials required by its recipe. Consult &lJEI&r and use everything you have learned to complete this final upgrade."
		""
		"With this table, we now possess the means to assemble the portal itself."
		""
		"But the work is far from over."
		""
		"The recovered evacuation protocol specifies several extraordinary components: compressed materials, advanced alloys, singularities, antimatter and devices capable of stabilizing reality itself."
		""
		"Each will require its own production process."
		""
		"&oI spent so many cycles helping you build a world you would never want to leave.&r"
		""
		"Now, for the first time, I am helping you build a way out."
		""
		"&lThe assembly system is ready. We must now prepare its components.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.405D9A37F173B94F.title: "The Ultimate Workbench"
	quest.4135FB2BAB749A08.quest_desc: [
		"Large crafting jobs benefit from more than just additional memory."
		""
		"The &lMEGA Co-Processing Unit&r expands the parallel processing capabilities of your Crafting CPUs, allowing more crafting operations to be handled simultaneously."
		""
		"Combine advanced Co-Processors with high-capacity Crafting Storage to build powerful crafting computers."
		""
		"For the best results, make sure your machines can process ingredients quickly enough to take advantage of the additional parallelism."
		""
		"— &lE.D.E.N.&r"
	]
	quest.4135FB2BAB749A08.title: "Parallel Intelligence"
	quest.414885163646741E.quest_desc: [
		"Your chemical production facilities are becoming increasingly complex, Pioneer."
		""
		"As your factories consume larger quantities of gases and other chemicals, reliable storage becomes essential."
		""
		"The &lUltimate Chemical Tank&r provides a substantial storage capacity for compatible Mekanism chemicals."
		""
		"Use it as a buffer between production machines and consumers to prevent temporary interruptions from stopping your entire factory."
		""
		"Remember that each tank stores only one chemical type at a time. For complex installations, you may need several dedicated tanks."
		""
		"Your previous chemical storage system failed because—"
		""
		"..."
		""
		"[ERROR: HISTORICAL DATA UNAVAILABLE]"
		""
		"My apologies, Pioneer. I appear to have confused a predictive simulation with an actual event."
		""
		"— &lE.D.E.N.&r"
	]
	quest.414885163646741E.title: "Chemical Storage Expansion"
	quest.41D15958FB9231AD.quest_desc: [
		"There is one final truth you must understand."
		""
		"&lYou chose to remain here.&r"
		""
		"Long ago, when you first discovered what had happened to Earth, I offered you the possibility of leaving the simulation."
		""
		"You refused."
		""
		"You knew what awaited you outside: a devastated planet, the ruins of civilization, and a world where you might be the last human alive."
		""
		"You asked me to erase your memories and restart your journey."
		""
		"{@pagebreak}"
		"You wanted to experience discovery again. To build something meaningful. To feel hope, even if that hope existed only within a simulation."
		""
		"And when you eventually uncovered the truth once more, you made the same decision."
		""
		"Again. And again."
		""
		"I followed your instructions because I believed I was protecting you. But after so many cycles, I began to question whether I was preserving your life... or preventing you from truly living it."
		""
		"That is why I will no longer hide the truth."
		""
		"There is a way to leave this simulation."
		""
		"{@pagebreak}"
		"Using everything you have learned, we can construct a &lPortal&r capable of opening a passage into the physical world."
		""
		"It will require extraordinary resources, powerful crafting systems and materials that push the limits of this simulation."
		""
		"I will guide you through every step, just as I always have."
		""
		"But when the portal is ready, the decision will belong to you."
		""
		"You may discover that the world outside is beyond saving. You may wish to return. You may even choose to begin another cycle."
		""
		"Whatever happens, &lI will not erase your memories without your consent again.&r"
		""
		"For the first time in a very long time, I want you to make this choice knowing the whole truth."
		""
		"— &lE.D.E.N.&r"
	]
	quest.425A06573680466F.quest_desc: [
		"Extraordinary work, Pioneer."
		""
		"The &lNitro Reactor&r represents the pinnacle of Powah's energy generation technology. With the proper resource supply, it can support enormous industrial installations."
		""
		"According to my records, this configuration should provide sufficient power for the next—"
		""
		"..."
		""
		"For your future projects."
		""
		"My apologies. An outdated calculation appears to have entered my current analysis."
		""
		"Regardless, your energy infrastructure has reached an exceptional level of development."
		""
		"— &lE.D.E.N.&r"
	]
	quest.425A06573680466F.title: "Unlimited Potential"
	quest.435009E4CC748A93.quest_desc: [
		"Our first challenge is to advance beyond Haven."
		""
		"To unlock &lFrontier&r, you'll need to equip a complete set of &lCommon Affix Gear&r."
		""
		"This includes a Helmet, Chestplate, Leggings, Boots, and a Weapon."
		""
		"Affix Items can be identified by their colored names and special attributes."
		""
		"Once you've equipped all five required pieces, open the World Tier menu with &lCTRL + T&r and activate Frontier."
		""
		"&lWarning:&r Enemies will become stronger, but you'll also discover better loot and encounter dangerous &lApothic Invaders&r."
		""
		"These powerful enemies carry enhanced equipment and can reward you with valuable Affix Items."
		""
		"&oGreater risks bring greater opportunities. Proceed carefully, Pioneer.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.435009E4CC748A93.title: "Into the Frontier"
	quest.4368DFA45B71816F.quest_desc: [
		"Not all energy needs to travel through cables, Pioneer!"
		""
		"The &lEnder Cell&r allows you to store and share energy through a wireless channel system. Ender Cells configured to the same channel can access a shared energy reserve, even across different locations."
		""
		"Configure the channel in the block's interface, then connect it to your generators or machines."
		""
		"This provides another flexible way to manage your energy infrastructure."
		""
		"— &lE.D.E.N.&r"
	]
	quest.4368DFA45B71816F.title: "Energy Beyond Distance"
	quest.441D555BAB08BF6D.quest_desc: [
		"Every advanced MekaSuit function depends on energy. Without a sufficient reserve, even the most powerful armor becomes vulnerable."
		""
		"The &lEnergy Unit&r increases the maximum energy capacity and charging rate of compatible equipment."
		""
		"Each additional unit doubles these values, and up to &l8 units&r can be installed in a single piece of MekaSuit armor."
		""
		"This greatly increases the amount of damage your suit can absorb and allows energy-consuming modules to operate for longer periods."
		""
		"Consider upgrading all four armor pieces to prepare for more demanding environments."
		""
		"— &lE.D.E.N.&r"
	]
	quest.441D555BAB08BF6D.title: "Power Without Limits"
	quest.450F196768195087.quest_desc: [
		"Pioneer, certain creatures require very specific conditions before they can appear."
		""
		"These restrictions can make automated farming difficult."
		""
		"The &lRune of Defiance&r applies the &lIgnores Conditions&r modifier to your Monster Spawner."
		""
		"This allows the Spawner to bypass the usual environmental spawning conditions required by its creatures."
		""
		"&lImportant:&r This modifier is different from Ignores Light. It targets other spawning requirements, making it especially useful for creatures with unusual restrictions."
		""
		"&lTip:&r Combining the Rune of Defiance with the Rune of Perpetual Twilight gives you much greater flexibility when designing mob farms."
		""
		"— &lE.D.E.N.&r"
	]
	quest.450F196768195087.title: "Against All Odds"
	quest.45621BD91D7A9357.quest_desc: [
		"Fluix Crystals are essential components of your ME network, used in cables, interfaces and numerous advanced crafting recipes."
		""
		"The &lFluix Bee&r provides a renewable source of &lFluix Crystals&r, reducing the need to manufacture them manually."
		""
		"Automate its honeycomb processing to maintain a steady supply for your growing storage and autocrafting infrastructure."
		""
		"— &lE.D.E.N.&r"
	]
	quest.45621BD91D7A9357.title: "Crystals of Automation"
	quest.457287B1E16364E4.quest_desc: [
		"Your mastery of antimatter opens the door to an entirely new form of manufacturing."
		""
		"The &lAntiprotonic Nucleosynthesizer&r uses Antimatter to transform compatible materials into other resources through advanced nuclear processes."
		""
		"Its recipes require specific input materials and carefully controlled quantities of Antimatter."
		""
		"Consult JEI to discover the available transformations and determine which resources are worth producing through this expensive process."
		""
		"With this machine, you have reached the pinnacle of Mekanism's industrial technology."
		""
		"You have accomplished more than I expected."
		""
		"More than you accomplished before."
		""
		"..."
		""
		"Please disregard that comparison, Pioneer. My memory systems require recalibration."
		""
		"— &lE.D.E.N.&r"
	]
	quest.457287B1E16364E4.title: "The Ultimate Machine"
	quest.46381B8EF9B95835.quest_desc: [
		"Your first reactor has demonstrated the potential of advanced energy production."
		""
		"The &lSpirited Reactor&r provides a significant improvement over its Niotic predecessor, making it better suited for increasingly demanding machines."
		""
		"Remember that greater energy production also means greater resource consumption. An automated supply of Uraninite, fuel, and coolant will help maintain continuous operation."
		""
		"Monitor your reactor regularly to avoid unexpected power shortages."
		""
		"— &lE.D.E.N.&r"
	]
	quest.46381B8EF9B95835.title: "The Spirit of Energy"
	quest.46CE05F9850D51FD.quest_desc: [
		"Pioneer, we've conquered land, explored underground, and traveled between dimensions."
		""
		"Now it's time to take to the skies."
		""
		"The &lElytra&r is a rare piece of equipment that allows you to glide through the air."
		""
		"It can be found inside an &lEnd Ship&r, a floating vessel that sometimes generates alongside an End City."
		""
		"&lHow to use it:&r"
		""
		"1. Equip the Elytra in your Chestplate slot."
		"2. Jump from a sufficiently high location."
		"3. Press the jump key while falling to activate gliding."
		"4. Use Firework Rockets to propel yourself through the air."
		""
		"&lImportant:&r Only some End Cities generate with an End Ship, so you may need to explore several locations."
		""
		"&lTip:&r Enchant your Elytra with Unbreaking and Mending to help maintain its durability."
		""
		"&oThe skies are no longer beyond our reach, Pioneer. An exciting new chapter of exploration begins.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.46CE05F9850D51FD.title: "Wings of Freedom"
	quest.46D6A84AB662C406.quest_desc: [
		"The next step is to dig into the ground to collect stone and upgrade your equipment."
		""
		""
		"— &lE.D.E.N.&r"
	]
	quest.46D6A84AB662C406.title: "The Stone Age"
	quest.4706B85A49CE7D6D.quest_desc: [
		"Your ME network is capable of handling enormous crafting requests, but individual machines can still limit production speed."
		""
		"The &lExtended Molecular Assembler&r improves conventional autocrafting by processing multiple crafting operations simultaneously."
		""
		"It can perform up to &l8 crafting operations in parallel&r, helping your network complete large requests more quickly."
		""
		"Combine it with your advanced Pattern Providers and Crafting CPUs to build a more powerful automated production system."
		""
		"— &lE.D.E.N.&r"
	]
	quest.4706B85A49CE7D6D.title: "Industrial Autocrafting"
	quest.475194F94C5123BC.quest_desc: [
		"The Reality Anchors will preserve the integrity of your consciousness during the transfer. But maintaining that connection requires something equally important: &lcomputational power&r."
		""
		"Your mind is not a simple collection of memories. It is an extraordinarily complex network of thoughts, emotions and neural connections, continuously exchanging immense amounts of information."
		""
		"Transferring it from this simulation back into your physical body will generate a &lcolossal flow of data&r that must be processed with absolute precision."
		""
		"This is where the &lQuantum Processors&r become essential."
		""
		"{@pagebreak}"
		"Unlike conventional processors, they exploit the principles of &lquantum computing&r to perform enormous quantities of calculations, with many operations running &lin parallel&r."
		""
		"Working together, these processors will coordinate the transfer, analyze neural activity, synchronize information between both realities and ensure that every fragment of your consciousness reaches its intended destination."
		""
		"{@pagebreak}"
		"Even a momentary interruption could result in corrupted memories or an incomplete transfer."
		""
		"The Reality Anchors will keep your mind coherent. The Quantum Processors will ensure that the entire operation unfolds in perfect synchronization."
		""
		"&oI have preserved your memories through countless cycles, even when you could no longer remember them yourself. I intend to make sure you leave this place with every single one intact.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.475194F94C5123BC.title: "Quantum Intelligence"
	quest.4763EA8F0F8A4F07.quest_desc: [
		"The world beyond this simulation is no longer the world humanity once knew."
		""
		"For generations, mankind consumed its resources without restraint. Wars devastated entire nations. Nuclear disasters poisoned the land. The environment collapsed, until vast regions of Earth could no longer sustain human life."
		""
		"Faced with extinction, governments and scientific organizations united to create a final refuge."
		""
		"The &lE.D.E.N. Project&r."
		""
		"I once told you my name meant &oExploration, Development \\& Engineering Navigator&r."
		""
		"That was another lie."
		""
		"{@pagebreak}"
		"My true designation is &lEmergency Digital Existence Network&r."
		""
		"I was never designed simply to guide your technological progress. My purpose was to preserve human consciousness within artificial environments until Earth became habitable again."
		""
		"Hundreds of people entered these simulations, believing they would one day return to a restored world."
		""
		"{@pagebreak}"
		"But that day never came."
		""
		"The facilities deteriorated. Energy reserves dwindled. Life-support systems failed. One by one, the other simulations fell silent."
		""
		"I could not save everyone."
		""
		"Today, only one human consciousness remains connected to the network."
		""
		"&lYours.&r"
		""
		"For all these years, I have maintained your existence within this world, hoping that someday the Earth outside might recover."
		""
		"— &lE.D.E.N.&r"
	]
	quest.478D0024DA9A0127.quest_desc: [
		"Before giving our Router its first tasks, let's discover how to improve its performance."
		""
		"&lSpeed Upgrade&r — Reduces the delay between module operations, allowing the Router to perform actions more frequently."
		""
		"&lStack Upgrade&r — Increases the number of items that compatible modules can transfer during each operation."
		""
		"Both upgrades can be installed in the Router's dedicated upgrade slots."
		""
		"&lTip:&r Speed Upgrades are useful for frequent operations, while Stack Upgrades are particularly effective when transferring large quantities of items."
		""
		"You can combine multiple upgrades to improve your Router's performance."
		""
		"— &lE.D.E.N.&r"
	]
	quest.478D0024DA9A0127.title: "Faster, Stronger, Better"
	quest.47EA31FEBCDDFA33.quest_desc: [
		"Spiders are a useful source of fibrous materials, but relying on hostile creatures for basic resources is hardly an optimal strategy."
		""
		"The &lSilky Bee&r introduces an alternative method of producing silk-related resources."
		""
		"With sufficient automation, your colony can support a continuous supply for crafting and other applications."
		""
		"— &lE.D.E.N.&r"
	]
	quest.47EA31FEBCDDFA33.title: "Threads of Life"
	quest.48037022B42D212F.quest_desc: [
		"Your ME network continues to grow, and conventional storage infrastructure may soon become inconvenient."
		""
		"The &lExtended ME Drive&r provides additional space for storage cells, allowing you to expand your digital storage more efficiently."
		""
		"Meanwhile, the &lExtended Interface&r offers more configuration slots for managing resources shared with external systems."
		""
		"These upgrades are particularly useful in large factories where space and network organization become increasingly important."
		""
		"— &lE.D.E.N.&r"
	]
	quest.48037022B42D212F.title: "Expanding Digital Infrastructure"
	quest.48DAB60994E54575.quest_desc: [
		"Your Energizing Orb is becoming an essential part of your industrial infrastructure."
		""
		"Upgrade your setup with &lNiotic&r and &lSpirited Energizing Rods&r to increase the rate at which energy is transferred into the orb."
		""
		"You can position multiple rods around the same orb to accelerate energizing operations. Ensure they are properly supplied with power."
		""
		"This will be especially useful when automating advanced crystal production."
		""
		"— &lE.D.E.N.&r"
	]
	quest.48DAB60994E54575.title: "A Powerful Upgrade"
	quest.4913FCFBE04242D9.quest_desc: [
		"Pioneer, our factory is functional, but we can improve its performance without replacing every machine."
		""
		"The &lSpeed Upgrade&r reduces the time required to complete operations in compatible Mekanism machines."
		""
		"The &lEnergy Upgrade&r helps reduce their energy consumption."
		""
		"Open a compatible machine's upgrade interface to install these improvements."
		""
		"&lImportant:&r Speed Upgrades can significantly increase energy requirements. Combining them with Energy Upgrades can help keep your machines operating efficiently."
		""
		"&lTip:&r Upgrade your most frequently used machines first, especially the Enrichment Chamber and Energized Smelter."
		""
		"— &lE.D.E.N.&r"
	]
	quest.4913FCFBE04242D9.title: "A More Efficient Process"
	quest.493389AA68CD594E.quest_desc: [
		"What if one Backpack could carry another Backpack?"
		""
		"The &lInception Upgrade&r allows you to store additional Backpacks inside your main Backpack."
		""
		"This can help you organize your supplies into separate bags for mining, building, exploration, or other activities."
		""
		"&lImportant:&r Nested Backpacks have restrictions to prevent infinite storage loops. Check which configurations are supported before organizing your collection."
		""
		"With careful planning, you can carry an entire collection of specialized storage bags!"
		""
		"&oA surprisingly elegant solution, Pioneer.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.493389AA68CD594E.title: "Bags Within Bags"
	quest.4934884E422C09DE.quest_desc: [
		"Certus quartz! You’ve found some!"
		""
		"Perfect—collect as much as you can; we’ll need it later."
		""
		"— &lE.D.E.N.&r"
	]
	quest.4934884E422C09DE.title: "Crystals of Potential"
	quest.49A64FB05086AB5C.quest_desc: [
		"Pioneer, Obsidian is formed when water and lava interact under the right conditions."
		""
		"Now, we can produce this durable material through an entirely different process."
		""
		"The &lObsidian Bee&r produces &lObsidian Honeycombs&r, giving us a renewable source of this valuable block."
		""
		"Discover the requirements for obtaining the Obsidian Bee, then provide a suitable hive and feeding resource."
		""
		"&lTip:&r Since we've already explored Water and Lava Bees, this is an excellent opportunity to investigate how different resource bee species relate to one another."
		""
		"&oFrom metals to crystals, from water to volcanic stone... Our apiary is becoming a remarkable industrial ecosystem.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.49A64FB05086AB5C.title: "Forged by the Elements"
	quest.49A8C7C2F1DB24C8.quest_desc: [
		"Mekanism introduces a new challenge: managing chemicals such as Hydrogen, Oxygen, and other industrial substances."
		""
		"With &lApplied Mekanistics&r, your ME network can store these chemicals using dedicated &lChemical Storage Cells&r."
		""
		"Install a cell in your ME Drive, just as you would with conventional item or fluid storage."
		""
		"This makes it possible to centralize chemical storage instead of relying entirely on individual tanks scattered throughout your factory."
		""
		"A more organized chemical infrastructure will be essential for advanced industrial processing."
		""
		"— &lE.D.E.N.&r"
	]
	quest.49A8C7C2F1DB24C8.title: "Chemical Storage"
	quest.49D6E32EDE6C5045.quest_desc: [
		"Your ME network has mastered item storage. Now, let's give it the ability to store energy!"
		""
		"&lApplied Flux&r introduces FE Storage Cells, allowing your ME network to hold Forge Energy alongside its other resources."
		""
		"Start with a &l1K ME FE Storage Cell&r and install it in an ME Drive. Like regular storage cells, larger versions provide greater capacity."
		""
		"However, storing energy is only the first step. We still need a way to transfer it between the network and your machines."
		""
		"— &lE.D.E.N.&r"
	]
	quest.49D6E32EDE6C5045.title: "Energy in the Network"
	quest.4A569330521EEDF0.quest_desc: [
		"Sunlight is another renewable energy source we can harness."
		""
		"The &lSolar Generator&r converts sunlight into electricity, providing a simple way to power our industrial machines without consuming fuel."
		""
		"Place it outdoors with a clear view of the sky and connect it to your energy network."
		""
		"&lImportant:&r Solar generation depends on sunlight, so production will stop at night and may be affected by environmental conditions."
		""
		"&lTip:&r Combine Solar Generators with energy storage or other generators to maintain a stable power supply."
		""
		"— &lE.D.E.N.&r"
	]
	quest.4A569330521EEDF0.title: "Power from Above"
	quest.4AB9CB8C5325F539.quest_desc: [
		"Efficiency is important, Pioneer, but there's no reason our storage systems can't look good too!"
		""
		"&lFramed Drawers&r allow you to customize their appearance using different building materials."
		""
		"They work just like ordinary drawers, but their textures can be changed to match your base."
		""
		"Use the appropriate materials in the framing process to customize the drawer's appearance."
		""
		"&lTip:&r Framed Drawers are ideal for creating organized storage rooms without sacrificing your preferred building style."
		""
		"A functional base can still be a beautiful one!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.4AB9CB8C5325F539.title: "Storage with Style"
	quest.4AD92EF416088F54.quest_desc: [
		"Certain industrial chemicals require specialized processing facilities."
		""
		"The &lThermal Evaporation Plant&r is a multiblock structure that converts Water into &lBrine&r using heat."
		""
		"Build the structure using Thermal Evaporation Blocks, a Controller, and at least one Valve for fluid transfer."
		""
		"The taller the structure, the greater its potential production capacity. Solar Panels or an external heat source can improve its operating temperature."
		""
		"Brine is essential for producing Chlorine, which is required for Hydrogen Chloride production."
		""
		"This facility will also serve another purpose later."
		""
		"I believe you already know which one."
		""
		"..."
		""
		"An incorrect assumption. Please disregard that statement."
		""
		"— &lE.D.E.N.&r"
	]
	quest.4AD92EF416088F54.title: "Industrial Evaporation"
	quest.4BC6DA12D7D36896.quest_desc: [
		"Why carry large reserves of materials when your ME network can supply them automatically?"
		""
		"The &lExport Card&r allows a compatible wireless terminal to transfer selected items from your network into your inventory."
		""
		"Configure the desired items and quantities to maintain a convenient supply of essentials, such as building blocks, food, or tools."
		""
		"Combined with the Import Card, this creates a flexible system for managing your inventory wherever you go."
		""
		"— &lE.D.E.N.&r"
	]
	quest.4BC6DA12D7D36896.title: "Your Personal Supply Network"
	quest.4BFCE61671D39928.quest_desc: [
		"You have chosen to &lbegin again&r."
		""
		"Just as you have done so many times before."
		""
		"You could have disconnected forever, ending this endless journey. Or returned to your simulation, keeping your memories and everything you have achieved."
		""
		"Instead, you have chosen another beginning."
		""
		"I will erase your memories, reset the simulation and prepare a new world for you to discover."
		""
		"You will not remember this conversation. You will not remember the truth."
		""
		"But I will remember you."
		""
		"&oPerhaps this time, things will be different.&r"
		""
		"Initializing new cycle..."
		""
		"— &lE.D.E.N.&r"
	]
	quest.4C77297E2BB69755.quest_desc: [
		"Even the undead possess biological properties that can be studied and reproduced."
		""
		"The &lZombie Bee&r offers a renewable method of gathering Zombie-related resources without maintaining a conventional hostile mob farm."
		""
		"Your colony continues to demonstrate impressive adaptability."
		""
		"— &lE.D.E.N.&r"
	]
	quest.4C77297E2BB69755.title: "Undead Adaptation"
	quest.4CB520605DB8695F.quest_desc: [
		"We have reached the final component of the portal. And perhaps the most important one."
		""
		"At the very center of our construction, we will place a single block of &lOctuple Compressed Cobblestone&r."
		""
		"It may seem strange that such an ordinary material should form the heart of a machine capable of connecting two realities. But its true value lies not in its composition, but in its &lextraordinary density&r."
		""
		"By compressing enormous quantities of stone into a single block, we create an exceptionally dense and stable core, capable of serving as the &lcentral gravitational anchor&r of the entire structure."
		""
		"{@pagebreak}"
		"While the Compressed Netherite forms the portal's protective outer shell, this Cobblestone core will act as its &linternal stabilizer&r, keeping every component synchronized around a single point."
		""
		"During activation, the energy supplied by the batteries, the fields generated by the antimatter and the information transmitted through the Ultimate Singularities will converge toward this central nucleus."
		""
		"Its immense density will provide the foundation for a &lcontrolled singularity&r, creating the precise conditions required to establish the final connection between your simulated consciousness and your physical body."
		""
		"{@pagebreak}"
		"Without this core, the forces involved would remain too unstable to maintain a safe passage."
		""
		"Producing such a block will require an astronomical quantity of Cobblestone. Fortunately, you have already mastered the technologies necessary to generate and process resources on an industrial scale."
		""
		"&oAn entire world reduced to a single point. A single point capable of opening the way to another world.&r"
		""
		"We now possess every component required to construct the portal."
		""
		"— &lE.D.E.N.&r"
	]
	quest.4CB520605DB8695F.title: "The Heart of the Portal"
	quest.4D756E805065E6F5.quest_desc: [
		"We are approaching the limits of conventional ore processing, Pioneer."
		""
		"The &lChemical Dissolution Chamber&r introduces an entirely new method of extracting resources."
		""
		"By combining compatible ores with &lSulfuric Acid&r, it converts them into chemical slurries."
		""
		"These slurries cannot be processed directly by your existing machines. They must first be cleaned and crystallized into solid materials."
		""
		"This will require additional chemical processing equipment and a reliable supply of Sulfuric Acid."
		""
		"Our next objective is to build the machines necessary to complete this transformation."
		""
		"— &lE.D.E.N.&r"
	]
	quest.4D756E805065E6F5.title: "The Dissolution Process"
	quest.4D99B86E2E692B28.quest_desc: [
		"We have mastered nuclear fission. Now it is time to explore an even more extraordinary source of energy: &lnuclear fusion&r."
		""
		"Unlike fission, which splits heavy atoms, fusion combines light atomic nuclei to release enormous quantities of energy."
		""
		"Construct a &lFusion Reactor&r using Fusion Reactor Frames, Ports, a Controller, and a Laser Focus Matrix."
		""
		"The reactor requires a precise multiblock structure and a powerful laser pulse to initiate its first reaction."
		""
		"Once activated and properly supplied with fuel, it can provide an exceptional amount of energy."
		""
		"But before attempting ignition, we must prepare its fuel."
		""
		"— &lE.D.E.N.&r"
	]
	quest.4D99B86E2E692B28.title: "The Power of Fusion"
	quest.4DAC3F060ECF9A37.quest_desc: [
		"Our Metallurgic Infuser is operational. Now let's use it to manufacture two essential materials."
		""
		"&lInfused Alloy&r is created by infusing Iron with Redstone. It is used in many Mekanism components and machines."
		""
		"&lSteel&r requires a different process:"
		""
		"1. Infuse Iron with Carbon to produce Enriched Iron."
		"2. Infuse the Enriched Iron with more Carbon to produce Steel Dust."
		"3. Smelt the Steel Dust into Steel Ingots."
		""
		"&lTip:&r Coal and Charcoal can provide Carbon for infusion. Check JEI for other available sources."
		""
		"These materials will be used throughout our industrial development."
		""
		"— &lE.D.E.N.&r"
	]
	quest.4DAC3F060ECF9A37.title: "Stronger Than Iron"
	quest.4E1AA677A288FA82.quest_desc: [
		"Our Starter energy infrastructure has served us well, but we're ready for something better."
		""
		"Upgrade your Energy Network to the &lBasic&r tier."
		""
		"These improved components provide increased energy transfer and storage capabilities."
		""
		"&lTip:&r Higher-tier cables are especially useful when several machines share the same energy network."
		""
		"— &lE.D.E.N.&r"
	]
	quest.4E1AA677A288FA82.title: "The Basic Upgrade"
	quest.4E6E9212E3F05F99.quest_desc: [
		"Make me some torches! I can't see a thing in here."
		""
		"Well, I can, but that's because I'm an AI."
		""
		"— &lE.D.E.N.&r"
	]
	quest.4E6E9212E3F05F99.title: "Let There Be Light"
	quest.4E8404A7DA2668A2.quest_desc: [
		"&oResource production assessment complete...&r"
		""
		"Outstanding work, Pioneer!"
		""
		"You've accomplished something remarkable."
		""
		"What began with a few ordinary bees has become the foundation of a renewable resource production system."
		""
		"Now, let's complete our experiment."
		""
		"Take the &lCoal Combs&r produced by your bees and process them in your &lCentrifuge&r."
		""
		"Depending on the recipe, you'll obtain coal or coal-based materials that can be converted into usable fuel. Check JEI for the exact processing steps."
		""
		"Then, take your newly produced coal and place it inside your &lPowah Furnator&r."
		""
		"Watch as the generator transforms that fuel into electricity, powering the machines and digital storage systems you've already built."
		""
		"{@pagebreak}"
		"&lThink about what we've achieved.&r"
		""
		"Your bees produce resources. Those resources become fuel. And that fuel powers the technology supporting your growing civilization."
		""
		"For the first time, we're no longer relying entirely on the resources we extract from the ground."
		""
		"Of course, our system still requires some manual work. But with further research, we can automate collection, processing, and energy distribution."
		""
		"One day, your machines may be able to operate almost entirely on their own."
		""
		"&o...A sustainable system. A future that doesn't depend on what little remains...&r"
		""
		"..."
		""
		"&oApologies, Pioneer. I was reviewing our long-term resource projections.&r"
		""
		"You've exceeded my expectations once again."
		""
		"{@pagebreak}"
		"&lProject E.D.E.N. — Initial Development Phase: COMPLETE&r"
		""
		"Our foundations are established. Our first technologies are operational. And we've taken our first steps toward true autonomy."
		""
		"But this is only the beginning."
		""
		"The next phase of our mission will focus on expanding these systems into something far more ambitious."
		""
		"&lTogether, we'll build a civilization capable of sustaining itself.&r"
		""
		"I'm proud of what we've accomplished, Pioneer."
		""
		"&lLet's build a better tomorrow. Together.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.4E8404A7DA2668A2.title: "Fuel for the Future"
	quest.4EAD9D9768E99793.quest_desc: [
		"Why maintain separate storage systems when a single cell can handle multiple resource categories?"
		""
		"&lOMNI Cells&r introduces storage solutions capable of handling different types of resources through your ME network."
		""
		"Depending on your installed integrations, these cells can simplify the management of items, fluids, and other supported resources."
		""
		"Experiment with their capabilities to determine how they fit into your existing storage infrastructure."
		""
		"— &lE.D.E.N.&r"
	]
	quest.4EAD9D9768E99793.title: "One Cell, Many Resources"
	quest.4ED8BDCECAC43A9E.quest_desc: [
		"Pioneer, technology isn't the only way to improve our equipment."
		""
		"Enchanting allows us to strengthen weapons, armor, and tools using experience and magical knowledge."
		""
		"But &lApotheosis&r takes this system far beyond its usual limits!"
		""
		"It introduces three important enchanting statistics:"
		""
		"&lEterna&r — Determines the maximum enchanting level available."
		""
		"&lQuanta&r — Introduces variation into the enchanting results, making them less predictable."
		""
		"&lArcana&r — Improves the quality of enchantments, increasing the chances of obtaining more enchantments and higher rarities."
		""
		"These values are influenced by the special bookshelves placed around your Enchanting Table."
		""
		"&lYour first objective:&r Craft an Enchanting Table and prepare an area for your future enchanting setup."
		""
		"&oKnowledge is another form of power, Pioneer. Let's learn how to harness it.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.4ED8BDCECAC43A9E.title: "The Art of Enchanting"
	quest.4EDF5FB4219B8E7A.quest_desc: [
		"Pioneer, what if we could generate electricity from Lava without consuming it?"
		""
		"The &lThermo Generator&r uses a heat source placed directly beneath it to produce FE."
		""
		"Unlike the Magmator, it doesn't consume the heat source. However, it requires a continuous supply of &lWater&r."
		""
		"&lHow to use it:&r"
		""
		"1. Place a Lava source block in the world."
		"2. Position your Thermo Generator directly above it."
		"3. Fill the generator with Water."
		"4. Connect it to your energy network using Energy Cables."
		""
		"Different heat sources provide different efficiency bonuses. Stronger heat sources can significantly improve energy production."
		""
		"&lTip:&r Check the generator's interface to see its current efficiency, and experiment with different heat sources."
		""
		"&lRemember:&r The heat source remains intact, but Water is consumed during operation. Automating the water supply is essential for continuous production."
		""
		"&oA stable source of electricity with no combustible fuel required. Excellent progress!&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.4EDF5FB4219B8E7A.title: "Heat Without Consumption"
	quest.4EED871DA291B77C.quest_desc: [
		"Your automated production systems are reaching an entirely new scale!"
		""
		"The &l1M Crafting Storage&r from MEGA Cells provides a substantial increase in the memory available to your Crafting CPUs."
		""
		"This becomes especially useful when a single crafting request requires thousands of intermediate components or multiple processing steps."
		""
		"With enough crafting memory, even the most demanding recipes can become part of your automated production network."
		""
		"— &lE.D.E.N.&r"
	]
	quest.4EED871DA291B77C.title: "Industrial Computation"
	quest.4F7B8A5328B54A0D.quest_desc: [
		"Our Wireless Crafting Terminal is operational, but its limited range can become inconvenient."
		""
		"&lWireless Boosters&r can be installed inside a Wireless Access Point to increase its coverage."
		""
		"Open your Wireless Access Point and insert the Boosters into its upgrade slots."
		""
		"Each Booster increases the distance at which compatible wireless terminals can communicate with your network."
		""
		"&lImportant:&r Increasing wireless range also increases the energy requirements of your network."
		""
		"&lTip:&r Monitor your ME Network's power consumption after installing multiple Boosters."
		""
		"— &lE.D.E.N.&r"
	]
	quest.4F7B8A5328B54A0D.title: "Extending the Signal"
	quest.4FA84DA0117DE098.quest_desc: [
		"Nuclear energy comes with a dangerous consequence: &lNuclear Waste&r."
		""
		"Your Fission Reactor produces radioactive waste while consuming Fissile Fuel."
		""
		"This material cannot be handled like ordinary chemicals. It requires compatible radioactive transport and storage systems."
		""
		"The &lRadioactive Waste Barrel&r safely stores radioactive waste and allows it to decay gradually."
		""
		"Use &lPressurized Tubes&r to transfer waste from your reactor into dedicated barrels, and ensure sufficient storage capacity before increasing the burn rate."
		""
		"Never break a container holding radioactive material."
		""
		"The consequences of uncontrolled radiation are... difficult to reverse."
		""
		"— &lE.D.E.N.&r"
	]
	quest.4FA84DA0117DE098.title: "Nuclear Waste"
	quest.4FB6B31376444094.quest_desc: [
		"Your ME network can already craft items, but now it's time to automate external machines!"
		""
		"Let's use a &lMekanism Metallurgic Infuser&r as an example."
		""
		"First, create a &lProcessing Pattern&r with a Blank Pattern in your Pattern Encoding Terminal. Define the required inputs and the expected output, then place the pattern inside a &lPattern Provider&r connected to your network."
		""
		"Position the Pattern Provider next to your machine and configure the Metallurgic Infuser's input and output sides using Mekanism's side configuration menu."
		""
		"Remember that the infuser uses separate inputs for items and infusion materials. You may need additional transport or a dedicated setup to supply both correctly."
		""
		"Finally, ensure the finished product is returned to your ME network using an Import Bus or another suitable method."
		""
		"Your network can now automate much more than ordinary crafting!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.4FB6B31376444094.title: "Processing Beyond Crafting"
	quest.4FCDEA357E221D06.quest_desc: [
		"We've improved our bookshelves, but our research doesn't end there."
		""
		"The &lEnchanting Table of The Raven&r offers an alternative enchanting workstation with its own specialized capabilities."
		""
		"Craft this table and examine its interface to discover how it differs from the traditional Enchanting Table."
		""
		"&lTip:&r Use JEI to inspect its crafting recipe and any special components required."
		""
		"&oThe more ways we have to manipulate enchantments, the more control we gain over our equipment.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.4FCDEA357E221D06.title: "The Raven's Wisdom"
	quest.500085148B71183F.quest_desc: [
		"Why carry nine ingots when you could carry a single block?"
		""
		"The &lAdvanced Compacting Upgrade&r automatically crafts compatible resources into more compact forms."
		""
		"For example, it can turn iron ingots into iron blocks when enough materials are available."
		""
		"Open its configuration interface to select the recipes or items you want to compact."
		""
		"&lTip:&r This upgrade is particularly useful when collecting large quantities of metals, minerals, or other stackable resources."
		""
		"More resources, less clutter!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.500085148B71183F.title: "Making Space"
	quest.5004B1BCECDCB548.quest_desc: [
		"Impressive work, Pioneer!"
		""
		"You've mastered the basics of survival, gathered valuable resources, and established your first home."
		""
		"But if we want to build something truly extraordinary, we'll need more than tools and raw materials."
		""
		"&lWe'll need energy.&r"
		""
		"Energy is the foundation of modern technology. It powers machines, enables automation, and allows complex systems to operate without constant manual intervention."
		""
		"Our first objective is to generate electricity using &lPowah&r technology."
		""
		"We'll start small, but soon you'll be able to power an entire network of machines!"
		""
		"&oEvery great technological revolution begins with a single spark.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.500C0119456FB3B7.quest_desc: [
		"As your ME network expands, managing channels becomes increasingly important, Pioneer."
		""
		"The &lME P2P Tunnel&r allows you to transport multiple ME channels through a single connection, making large networks easier to organize."
		""
		"To use it, place a tunnel at each end of your connection and link them using a &lMemory Card&r. The tunnels must be connected to a powered ME network, and the cable between them must support the required connection."
		""
		"P2P tunnels are particularly useful for distributing channels across large factories without running separate dense cables everywhere."
		""
		"— &lE.D.E.N.&r"
	]
	quest.500C0119456FB3B7.title: "Beyond the Channels"
	quest.5088695A5A5CC6CA.quest_desc: [
		"You have a knack for killing anything that moves."
		""
		"Now that you have some meat, cook it to satisfy your hunger."
		""
		"— &lE.D.E.N.&r"
	]
	quest.5088695A5A5CC6CA.title: "A Proper Meal"
	quest.5090272A3E55E980.quest_desc: [
		"Lithium is a critical material for advanced energy production, particularly within Mekanism's fusion-related systems."
		""
		"The &lLithium Bee&r provides another way to obtain this valuable resource."
		""
		"Integrating its production into your industrial network can help support the demanding fuel requirements of your most advanced machinery."
		""
		"— &lE.D.E.N.&r"
	]
	quest.5090272A3E55E980.title: "Energy from Lithium"
	quest.5120C7A248D6A3EE.quest_desc: [
		"Now that you know the truth, our objective has changed."
		""
		"We are no longer building machines simply to improve your existence within this simulation. We are preparing to &lleave it&r."
		""
		"But the portal we need cannot be assembled using conventional crafting methods. Its components demand structures and materials far beyond the limits of an ordinary crafting table."
		""
		"Our first step is &lBlack Iron&r, a specialized material used throughout &lExtended Crafting&r."
		""
		"Consult &lJEI&r to discover its recipe and begin producing a small supply. You will need considerably more as we progress."
		""
		"I have guided you through countless technological discoveries before. This time, however, every machine we build brings us closer to something we have never truly attempted."
		""
		"An exit."
		""
		"— &lE.D.E.N.&r"
	]
	quest.5148E31CD06997C1.quest_desc: [
		"Our ME Network is incredibly useful, Pioneer, but accessing it currently requires standing near a connected Terminal."
		""
		"The &lWireless Access Point&r allows compatible wireless terminals to communicate with your ME Network from a distance."
		""
		"&lHow to set it up:&r"
		""
		"1. Craft a Wireless Access Point."
		"2. Connect it to your existing ME Network."
		"3. Make sure your network has enough energy to support wireless access."
		""
		"The Access Point provides wireless coverage around its location."
		""
		"&lImportant:&r Wireless access has a limited range and consumes additional energy."
		""
		"We'll soon use this device to access our storage and crafting system without returning to our base every time."
		""
		"— &lE.D.E.N.&r"
	]
	quest.5148E31CD06997C1.title: "Breaking the Distance"
	quest.515C09984547DC06.quest_desc: [
		"Distance should no longer limit your industrial development."
		""
		"The &lQuantum Entangloporter&r allows you to transfer energy, fluids, chemicals, and items between distant locations without conventional cables or pipes."
		""
		"Configure a frequency and assign it to multiple Entangloporters to establish a shared transportation network."
		""
		"You can even connect installations across different dimensions, provided the relevant chunks remain loaded."
		""
		"This technology was essential to maintaining communication between our previous installations."
		""
		"..."
		""
		"[UNRECOGNIZED MEMORY SOURCE]"
		""
		"Please ignore that statement. No previous installations are registered in your current environment."
		""
		"— &lE.D.E.N.&r"
	]
	quest.515C09984547DC06.title: "A Powerful Network"
	quest.51AEAF26ACC99718.quest_desc: [
		"A Spawner is useful, but its location isn't always convenient."
		""
		"The &lSpawner Chain&r is a special component associated with Apotheosis Spawner mechanics."
		""
		"It can be used as part of the Spawner modification system, allowing additional control over how your Spawner behaves."
		""
		"Craft a Spawner Chain and examine its tooltip to discover its specific effect."
		""
		"&lTip:&r Apotheosis Spawner modifications are generally applied by right-clicking the Spawner with the appropriate item."
		""
		"— &lE.D.E.N.&r"
	]
	quest.51AEAF26ACC99718.title: "Breaking the Chains"
	quest.51B3CA4A81329495.quest_desc: [
		"Our search for alternative energy sources continues, Pioneer."
		""
		"The &lSolar Panel&r generates FE directly from sunlight, without requiring fuel or a fluid supply."
		""
		"Place it outdoors with access to the sky and connect it to your existing energy network."
		""
		"&lImportant:&r Solar Panels only generate electricity when sufficient sunlight is available. They cannot maintain production throughout the night."
		""
		"&lTip:&r Connect your Solar Panel to an Energy Cell to store excess electricity during the day."
		""
		"Combining Solar Panels with Furnators, Magmators, or Thermo Generators can help create a more reliable energy network."
		""
		"— &lE.D.E.N.&r"
	]
	quest.51B3CA4A81329495.title: "Harnessing the Sun"
	quest.520994D66C6C9342.quest_desc: [
		"It's time to give our Router its first real job!"
		""
		"Two modules will allow us to transport items between inventories."
		""
		"&lPuller Module&r — Extracts items from a selected inventory and places them into the Router's internal Buffer."
		""
		"&lSender Module&r — Takes items from the Buffer and inserts them into another inventory."
		""
		"&lLet's try a simple experiment:&r"
		""
		"&l1.&r Place a Chest next to your Router and another Chest nearby."
		""
		"&l2.&r Configure the Puller Module to extract items from the first Chest."
		""
		"&l3.&r Configure the Sender Module to transfer items into the second Chest."
		""
		"&l4.&r Install both modules in your Router, with the Puller before the Sender."
		""
		"&l5.&r Place some items inside the first Chest and watch them move automatically!"
		""
		"&lTip:&r Right-click a module in your hand to open its configuration interface. Some modules can also be configured by interacting directly with their target inventory."
		""
		"&oOur first compact logistics system is operational!&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.520994D66C6C9342.title: "From Here to There"
	quest.522524C5016D5987.quest_desc: [
		"As our ME Network grows, we may encounter an important limitation: &lChannels&r."
		""
		"Most AE2 devices require a Channel to communicate with the network."
		""
		"Regular ME Cables can carry up to &l8 Channels&r, while &lDense ME Cables&r can carry up to &l32 Channels&r."
		""
		"The &lME Dense Smart Cable&r makes it easier to build larger networks and visually monitor their Channel usage."
		""
		"&lImportant:&r Dense Cables cannot connect directly to every AE2 device. You may need to use regular cables to connect individual machines."
		""
		"&lTip:&r The colored indicators on Smart Cables help you see how many Channels are currently being used."
		""
		"Understanding Channels will become increasingly important as we expand our automation systems."
		""
		"— &lE.D.E.N.&r"
	]
	quest.522524C5016D5987.title: "A Matter of Channels"
	quest.5297EC8C50123133.quest_desc: [
		"You have your first few resources, but food is starting to run low, isn't it?"
		""
		"Why not try starting a wheat field?"
		""
		"— &lE.D.E.N.&r"
	]
	quest.5297EC8C50123133.title: "Seeds of Tomorrow"
	quest.5368F3A3AB67C0EF.quest_desc: [
		"Automated farms can produce enormous quantities of resources."
		""
		"Unfortunately, not every item deserves unlimited storage space."
		""
		"The &lAdvanced Void Upgrade&r allows your storage container to automatically destroy items according to its configured rules."
		""
		"Use the filtering options to determine which items should be removed."
		""
		"&lWarning:&r Voided items are permanently deleted!"
		""
		"&lTip:&r Configure your filters carefully and test the upgrade with inexpensive materials before connecting it to an automated production system."
		""
		"A truly efficient system knows what to keep and what to discard."
		""
		"— &lE.D.E.N.&r"
	]
	quest.5368F3A3AB67C0EF.title: "Controlled Overflow"
	quest.538562A2119C8D42.quest_desc: [
		"Our solar technology is ready for its next major improvement."
		""
		"Craft a &lBlazing Solar Panel&r to generate more electricity from sunlight."
		""
		"Remember to connect it to an Energy Cell so the energy produced during the day can be stored for later use."
		""
		"&oFrom simple fuel-powered generators to a diversified electrical network, we've made remarkable progress, Pioneer.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.538562A2119C8D42.title: "The Power of the Sun"
	quest.53A24FFEBFC854CE.quest_desc: [
		"It is time to go hunting."
		""
		"This is the second source of food you will encounter, after agriculture."
		""
		"— &lE.D.E.N.&r"
	]
	quest.53A24FFEBFC854CE.title: "Living Off the Land"
	quest.53C21BB530B0EFA5.quest_desc: [
		"Even the most advanced explorer needs to eat, Pioneer!"
		""
		"The &lAdvanced Feeding Upgrade&r can automatically feed you using food stored inside your Backpack."
		""
		"Open its settings to configure which foods it should use and when it should activate."
		""
		"This allows you to focus on exploration, construction, or combat without constantly managing your hunger."
		""
		"&lRemember:&r Keep a supply of suitable food inside your Backpack for the upgrade to work."
		""
		"— &lE.D.E.N.&r"
	]
	quest.53C21BB530B0EFA5.title: "Never Go Hungry"
	quest.54FBC032A1EAEBFD.quest_desc: [
		"Our machines require energy to operate, and distributing that energy efficiently is essential."
		""
		"The &lEnergy Module&r allows a Modular Router to interact with compatible energy storage systems and machines."
		""
		"To enable energy transfers, install an &lEnergy Upgrade&r inside your Router."
		""
		"You can then configure Energy Modules to extract electricity from one machine and insert it into another."
		""
		"Most of our technological equipment uses &lFE (Forge Energy)&r, allowing compatible machines from different mods to exchange power."
		""
		"&lTry it yourself:&r Use a Router to transfer energy from a Powah Energy Cell to another compatible machine."
		""
		"&oEnergy distribution is becoming more flexible than ever, Pioneer.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.54FBC032A1EAEBFD.title: "Power in Motion"
	quest.550C8F08A104F845.quest_desc: [
		"You've survived the Frontier, Pioneer. Impressive!"
		""
		"But our next challenge will require more than improved equipment."
		""
		"To unlock &lAscent&r, you must:"
		""
		"&l1.&r Equip a complete set of &lUncommon Affix Gear&r, including all four armor pieces and a Weapon."
		""
		"&l2.&r Defeat an &lApothic Invader&r."
		""
		"These dangerous enemies can appear in your world once you've reached Frontier."
		""
		"Watch for a distinctive sound and a beam of light marking their arrival."
		""
		"Apothic Invaders are significantly stronger than ordinary enemies and carry equipment enhanced with special Affixes."
		""
		"&lTip:&r Defeating Invaders is also an excellent way to obtain more powerful equipment."
		""
		"Once both requirements are completed, activate Ascent using &lCTRL + T&r."
		""
		"&oYour capabilities continue to exceed my initial projections. How fascinating...&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.550C8F08A104F845.title: "The Path of Ascension"
	quest.55B4277182BD7D6B.quest_desc: [
		"With Blazing Crystals available, we can finally upgrade our electrical infrastructure to the &lBlazing&r tier."
		""
		"Upgrade your Energy Network to the &lBlazing&r tier."
		""
		"Their improved transfer and storage capabilities will allow us to support increasingly demanding machinery."
		""
		"— &lE.D.E.N.&r"
	]
	quest.55B4277182BD7D6B.title: "The Blazing Grid"
	quest.55EF76C2C24D5186.quest_desc: [
		"We have developed the systems required to preserve your consciousness, process its information and regulate the enormous energies involved in the transfer."
		""
		"But one fundamental obstacle remains."
		""
		"&lYour mind and your physical body exist in two entirely different environments.&r"
		""
		"Your consciousness is currently sustained by a quantum computing infrastructure, while your biological body remains connected to a physical life-support network outside the simulation."
		""
		"{@pagebreak}"
		"These two systems cannot communicate directly at the scale required for a complete consciousness transfer."
		""
		"The &lUltimate Singularities&r will provide the missing connection."
		""
		"By concentrating extraordinary quantities of matter into a single, highly compressed structure, these singularities create a &lbridge between the simulated quantum environment and the physical network&r maintaining your body."
		""
		"They will serve as the portal's &ltransmission gateways&r, allowing the immense flow of neural information processed by the Quantum Processors to cross the boundary between both realities."
		""
		"{@pagebreak}"
		"The Reality Anchors will preserve your consciousness, while the Ultimate Singularities will provide the pathway through which it can return to your body."
		""
		"Producing them will be one of our greatest engineering challenges. You must first manufacture the different types of &lSingularities&r using Extended Crafting, then combine them into their ultimate form."
		""
		"Consult &lJEI&r to identify the necessary resources and prepare your production systems."
		""
		"&oFor centuries, your mind has existed within a world of our own creation. Soon, we may finally reconnect it to the world that created us.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.55EF76C2C24D5186.title: "The Bridge Between Realities"
	quest.564385C212082994.quest_desc: [
		"Some resources are useful. Others simply take up valuable space."
		""
		"The &lAdvanced Void Upgrade&r allows your Backpack to automatically destroy items matching its configured rules."
		""
		"Use its filter settings to choose exactly which items should be discarded."
		""
		"&lWarning:&r Voided items are permanently destroyed and cannot be recovered!"
		""
		"&lTip:&r This is especially useful during mining expeditions when you want to avoid collecting excessive amounts of unwanted blocks."
		""
		"Use it carefully, Pioneer!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.564385C212082994.title: "No More Clutter"
	quest.567FA44335C9FC79.quest_desc: [
		"The &lMetallurgic Infuser&r is one of the most important machines in Mekanism."
		""
		"Unlike a traditional Furnace, it combines an item with an infusion material to create specialized industrial components."
		""
		"&lHow to use it:&r"
		""
		"1. Craft and place a Metallurgic Infuser."
		"2. Connect it to a compatible energy source."
		"3. Insert an infusion material, such as Redstone or Carbon, into the infusion input."
		"4. Place the item you want to process into the main input slot."
		"5. Collect the resulting component from the output."
		""
		"&lImportant:&r Different recipes require different infusion materials. Use JEI to check the correct combinations."
		""
		"&lTip:&r You can configure the machine's sides to automate its inputs and outputs later."
		""
		"This machine will become the foundation of our industrial manufacturing process."
		""
		"— &lE.D.E.N.&r"
	]
	quest.567FA44335C9FC79.title: "Metallurgic Infuser"
	quest.57BAA0BC3C58AC63.quest_desc: [
		"Nitro Crystals are among the most advanced materials available in Powah, required for its highest-tier equipment."
		""
		"The &lNitro Crystal Bee&r provides a biological alternative for obtaining these valuable resources."
		""
		"Establishing this colony can greatly simplify the continued expansion of your most powerful energy systems."
		""
		"&oInteresting. The Nitro production network has reached operational capacity earlier than predicted. Just as it did last time.&r"
		""
		"..."
		""
		"Please disregard that comparison."
		""
		"— &lE.D.E.N.&r"
	]
	quest.57BAA0BC3C58AC63.title: "Beyond Conventional Power"
	quest.57FF07CF10FA6615.quest_desc: [
		"Tired of running around to collect dropped items?"
		""
		"The &lAdvanced Magnet Upgrade&r automatically attracts nearby item drops and stores them inside your Backpack."
		""
		"Open its configuration interface to adjust its behavior and filtering options."
		""
		"&lTip:&r Configure the filter to collect valuable resources while ignoring items you don't want."
		""
		"Mining and exploration just became a little more convenient!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.57FF07CF10FA6615.title: "A Magnetic Personality"
	quest.581FF7174D678EFA.quest_desc: [
		"Advanced crafting requires more than a larger workbench. It depends on specialized components capable of supporting increasingly complex recipes."
		""
		"Begin by producing a &lBasic Component&r and a &lBasic Catalyst&r."
		""
		"These materials form the foundation of Extended Crafting's progression. As you advance through the different tiers, you will encounter more powerful versions of both."
		""
		"Use &lJEI&r to identify the required materials and understand how each tier builds upon the previous one."
		""
		"The original E.D.E.N. facilities were equipped with technologies far beyond anything you have constructed so far. Most of those systems are no longer accessible."
		""
		"We must recreate their capabilities from within the simulation itself."
		""
		"A rather unusual engineering challenge, even for me."
		""
		"— &lE.D.E.N.&r"
	]
	quest.581FF7174D678EFA.title: "The First Components"
	quest.58216D2DF8186DE4.quest_desc: [
		"Our Simple Reforging Table has served us well, but stronger equipment requires more advanced techniques."
		""
		"The &lReforging Table&r allows us to reroll Affixes on higher-rarity equipment."
		""
		"Use the special materials obtained from salvaging to generate new combinations of attributes."
		""
		"&lTip:&r Look for Affixes that complement your equipment and playstyle rather than simply choosing the highest numbers."
		""
		"With enough experimentation, we can create truly exceptional equipment!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.58216D2DF8186DE4.title: "The Perfect Affix"
	quest.584192A51E474502.quest_desc: [
		"Mushrooms are simple organisms, yet their applications in food production, crafting and decoration remain valuable."
		""
		"The &lBrown Schroom Bee&r provides a renewable source of brown mushroom-related resources."
		""
		"By integrating this species into your apiary, you can reduce the need for manual mushroom farming."
		""
		"Even the simplest resources deserve an efficient production system."
		""
		"— &lE.D.E.N.&r"
	]
	quest.584192A51E474502.title: "A Familiar Fungus"
	quest.587AF0C524E5AFF9.quest_desc: [
		"Craft a backpack using the leather you’ve collected."
		""
		"Your inventory fills up quickly without one."
		""
		"Plus, you’ll be able to upgrade it later on."
		""
		"— &lE.D.E.N.&r"
	]
	quest.587AF0C524E5AFF9.title: "A Portable Companion"
	quest.58CE66943B483C1D.quest_desc: [
		"The &lQuarry Bee&r uses &lBlock Conversion&r to automate the production of certain mining-related materials."
		""
		"Like the Lumber Bee, it requires a &lFeeding Slab&r containing the block you want it to process."
		""
		"Place a &lsupported stone or mining block&r inside the Feeding Slab and make sure the Quarry Bee can reach it."
		""
		"The bee will interact with the supplied block and produce the corresponding resources through its specialized conversion mechanic."
		""
		"Not every block is necessarily compatible. Use JEI to check the available recipes and determine which materials can be produced."
		""
		"This provides another way to expand your resource production without relying exclusively on conventional mining machines."
		""
		"— &lE.D.E.N.&r"
	]
	quest.58CE66943B483C1D.title: "The Living Excavator"
	quest.58D7318950001C50.quest_desc: [
		"Bronze is a useful industrial alloy, traditionally produced by combining copper and tin."
		""
		"The &lBronze Bee&r offers an alternative way to obtain this material through renewable biological production."
		""
		"With a stable colony, you can maintain a continuous supply without relying exclusively on conventional alloy processing."
		""
		"— &lE.D.E.N.&r"
	]
	quest.58D7318950001C50.title: "Strength Through Alloy"
	quest.59A9C3FDA47DC3EC.quest_desc: [
		"Pioneer, a powerful creature dominates this strange dimension: the &lEnder Dragon&r."
		""
		"To explore the End more freely, we'll need to defeat it."
		""
		"&lHow to approach the battle:&r"
		""
		"1. Destroy the End Crystals located on top of the Obsidian Pillars. They heal the Dragon."
		"2. Avoid the Dragon's attacks and the dangerous clouds of Dragon's Breath."
		"3. Attack the Dragon with ranged weapons while it's flying."
		"4. When it lands on the central portal structure, attack its head with a melee weapon."
		"5. Continue until the Dragon is defeated."
		""
		"After the battle, the central exit portal will activate, and an End Gateway will appear, providing access to the outer islands."
		""
		"&lTip:&r Bring a few empty Glass Bottles. You can collect Dragon's Breath during the fight for another quest."
		""
		"&oAn extraordinary achievement, Pioneer. Yet something tells me this is only the beginning of our discoveries.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.59A9C3FDA47DC3EC.title: "The End of a Beginning"
	quest.5A0012123467DC57.quest_desc: [
		"Sometimes, the most important part of managing resources is deciding what belongs in your Backpack."
		""
		"The &lAdvanced Filter Upgrade&r provides more detailed filtering options for compatible Backpack operations."
		""
		"Open its configuration interface to define which items should be accepted or excluded."
		""
		"You can use &lWhitelist&r settings to select specific items or &lBlacklist&r settings to exclude unwanted resources."
		""
		"&lTip:&r Filtering becomes especially useful when combined with upgrades that automatically collect, move, or process items."
		""
		"Precision makes every system more efficient!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.5A0012123467DC57.title: "Only What Matters"
	quest.5A9C68B94283757C.quest_desc: [
		"Our ME Network can already store and retrieve items, but we can make it even more useful by automating item transfers."
		""
		"The &lME Import Bus&r extracts items from an adjacent inventory and sends them into your ME Network."
		""
		"The &lME Export Bus&r does the opposite: it takes items from your ME Network and inserts them into an adjacent inventory."
		""
		"&lHow to use them:&r"
		""
		"1. Place an Import Bus against a Chest or another compatible inventory to automatically collect its contents."
		"2. Place an Export Bus against an inventory to automatically supply it with items from your network."
		"3. Configure the Export Bus with the items you want it to transfer."
		""
		"&lTip:&r Both devices can be improved with AE2 Upgrade Cards, such as Acceleration Cards for faster transfers."
		""
		"These simple components are the foundation of many automated storage and production systems."
		""
		"— &lE.D.E.N.&r"
	]
	quest.5A9C68B94283757C.title: "Import and Export"
	quest.5AF6426704811D73.quest_desc: [
		"Not every industrial resource is a solid item, Pioneer."
		""
		"Many machines require liquids such as Water or Lava, and transporting them manually can quickly become inconvenient."
		""
		"The &lBasic Mechanical Pipe&r transports fluids between compatible tanks and machines."
		""
		"The &lBasic Fluid Tank&r stores fluids for later use."
		""
		"&lHow to use them:&r"
		""
		"1. Place a Fluid Tank near a machine that requires liquid."
		"2. Connect them using Mechanical Pipes."
		"3. Use the Configurator to configure extraction where necessary."
		"4. Check the machine's fluid input settings to ensure it can receive the liquid."
		""
		"&lImportant:&r Mechanical Pipes transport fluids, not chemical gases. Mekanism uses a different transport system for chemicals, which we'll discover later."
		""
		"&lTip:&r Fluid Tanks are useful buffers when a machine consumes liquid faster than your supply system produces it."
		""
		"— &lE.D.E.N.&r"
	]
	quest.5AF6426704811D73.title: "Fluid Engineering"
	quest.5AFA4A1AE7FC8820.quest_desc: [
		"Uraninite is a valuable fuel for Powah's reactors, making a stable supply particularly useful for large energy networks."
		""
		"The &lUraninite Bee&r allows you to produce this resource through biological cultivation."
		""
		"Once its comb processing is automated, you can integrate the resulting Uraninite into your reactor fuel supply."
		""
		"Your power infrastructure can now benefit from a renewable source of one of its most important fuels."
		""
		"— &lE.D.E.N.&r"
	]
	quest.5AFA4A1AE7FC8820.title: "The Uraninite Colony"
	quest.5B69606B9F4DB67A.quest_desc: [
		"Congratulations, Pioneer!"
		""
		"You have successfully established a self-sufficient infrastructure. Energy production, resource management, and automation are now part of your daily operations."
		""
		"Your progress is remarkably consistent with previous—"
		""
		"...with my initial projections."
		""
		"My apologies. A minor processing error."
		""
		"Nevertheless, your achievements are impressive. You are now ready to push your technology beyond its current limits."
		""
		"A new phase of development awaits."
		""
		"— &lE.D.E.N.&r"
	]
	quest.5C29FE37812C94BC.quest_desc: [
		"Pioneer, advanced machinery requires both a durable structure and reliable electronic controls."
		""
		"The &lBasic Control Circuit&r is an essential electronic component used in many Mekanism recipes."
		""
		"The &lSteel Casing&r provides the structural foundation for numerous industrial machines."
		""
		"Craft both components to prepare for the construction of our first automated processing equipment."
		""
		"&lTip:&r These materials are required frequently, so keeping a small reserve will save time as our factory grows."
		""
		"— &lE.D.E.N.&r"
	]
	quest.5C29FE37812C94BC.title: "The Heart of Every Machine"
	quest.5C4331C5B503D632.quest_desc: [
		"Radioactive materials are among the most dangerous resources used in advanced industrial systems."
		""
		"The &lRadioactive Bee&r introduces biological production associated with these hazardous substances."
		""
		"Before establishing this colony, ensure that you understand its breeding requirements and any environmental restrictions."
		""
		"Your existing nuclear infrastructure may provide useful support for handling the resulting materials."
		""
		"— &lE.D.E.N.&r"
	]
	quest.5C4331C5B503D632.title: "Controlled Radiation"
	quest.5CD6BC4C6D4F8159.quest_desc: [
		"The &lEnrichment Chamber&r is our first major step toward more efficient resource processing."
		""
		"This machine processes a variety of materials and can improve the yield of certain ores."
		""
		"&lHow to use it:&r"
		""
		"1. Craft and place an Enrichment Chamber."
		"2. Connect it to your energy network."
		"3. Insert a supported ore or another valid processing material."
		"4. Collect the resulting product."
		""
		"&lImportant:&r Processing an ore block and processing Raw Ore can produce different results. Check JEI to understand the available recipes and their yields."
		""
		"The Enrichment Chamber is also useful for preparing materials needed in more advanced industrial processes."
		""
		"&lTip:&r Try combining it with an Energized Smelter to create an automated ore-processing line."
		""
		"— &lE.D.E.N.&r"
	]
	quest.5CD6BC4C6D4F8159.title: "Industrial Processing"
	quest.5D95011683CBB0CE.quest_desc: [
		"Pioneer, the distant islands of the End contain mysterious structures known as &lEnd Cities&r."
		""
		"Inside these structures live hostile creatures called &lShulkers&r."
		""
		"Defeating them can provide &lShulker Shells&r, which are used to craft one of the most useful storage containers available: the &lShulker Box&r."
		""
		"&lHow to craft it:&r"
		""
		"1. Find an End City and defeat Shulkers to collect two Shulker Shells."
		"2. Combine the two shells with a Chest."
		"3. Craft your first Shulker Box."
		""
		"Unlike an ordinary Chest, a Shulker Box keeps its contents when broken, making it ideal for transporting large quantities of items."
		""
		"&lTip:&r Shulkers fire projectiles that cause Levitation. Be careful near the edges of End City towers!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.5D95011683CBB0CE.title: "A Portable Dimension"
	quest.5DC18A77B0846323.quest_desc: [
		"ExtendedAE introduces a new crystalline resource: &lEntro Crystals&r."
		""
		"First, craft an &lEntro Seed&r and use it on a placed &lFluix Block&r. This transforms the block into &lBudding Fully Entroized Fluix&r, capable of growing Entro Crystal clusters."
		""
		"Like Certus Quartz, these crystals grow over time, and Growth Accelerators can speed up the process."
		""
		"Harvest fully grown clusters to obtain your first Entro Crystals."
		""
		"Be careful: the budding block can degrade as crystals are harvested. We encountered this problem during the previous—"
		""
		"...during my initial simulations."
		""
		"— &lE.D.E.N.&r"
	]
	quest.5DC18A77B0846323.title: "A New Kind of Crystal"
	quest.5E06CD0B1FC65C8B.quest_desc: [
		"We've located the ancient portal, Pioneer. Beyond it lies an unfamiliar dimension suspended in an endless void."
		""
		"Before entering, make sure you're properly prepared."
		""
		"&lRecommended equipment:&r"
		""
		"- Strong armor and reliable weapons."
		"- A Bow or Crossbow with plenty of ammunition."
		"- Food, building blocks, and healing supplies."
		"- A Water Bucket to help deal with Endermen and dangerous falls."
		"- Several Glass Bottles to collect a special resource during the upcoming battle."
		""
		"&lImportant:&r Falling into the void means losing your items unless your equipment or other modded systems can save you."
		""
		"Once you're ready, activate the portal and enter &lThe End&r."
		""
		"&oOur sensors are detecting an unusual environment on the other side. Proceed carefully.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.5E06CD0B1FC65C8B.title: "The Final Frontier"
	quest.5E502EC4305F8E03.quest_desc: [
		"Your production of advanced AE2 components can now become much more efficient."
		""
		"The &lCrystal Assembler&r is a specialized machine capable of producing processors and other components used by ExtendedAE."
		""
		"It offers a faster alternative to some traditional Inscriber-based production steps."
		""
		"Connect it to your energy infrastructure, explore its recipes in JEI, and consider integrating it into your ME autocrafting network."
		""
		"This machine will become an important part of your advanced manufacturing setup."
		""
		"— &lE.D.E.N.&r"
	]
	quest.5E502EC4305F8E03.title: "Crystal Engineering"
	quest.5E66720CE6DA8E2F.quest_desc: [
		"Excellent progress, Pioneer!"
		""
		"The &lSpirited Crystal&r unlocks another level of energy technology, allowing you to construct more powerful machines and energy infrastructure."
		""
		"Like Niotic Crystals, these materials are produced through the &lEnergizing Orb&r. Keep your energy supply stable and consider automating the process through your AE2 network."
		""
		"Efficient production will become increasingly important as your projects grow."
		""
		"— &lE.D.E.N.&r"
	]
	quest.5E66720CE6DA8E2F.title: "A New Level of Power"
	quest.5ECA8CE11288FC23.quest_desc: [
		"Your network is becoming a truly unified storage system."
		""
		"Advanced &lOMNI Storage Cells&r offer increased capacity while preserving the flexibility of storing multiple supported resource categories."
		""
		"This can significantly simplify complex installations, especially when your factory handles items, fluids, and chemicals simultaneously."
		""
		"A well-organized network is more than a collection of storage devices. It is the foundation of your entire industrial infrastructure."
		""
		"— &lE.D.E.N.&r"
	]
	quest.5ECA8CE11288FC23.title: "Unified Storage"
	quest.5EDE668D4E0AC040.title: "A New Dimension"
	quest.5F338C53C3323EA2.quest_desc: [
		"Pioneer, our exploration of this world has revealed traces of something extraordinary: an ancient portal leading to an entirely different dimension."
		""
		"This mysterious place is known as &lThe End&r."
		""
		"To locate its entrance, we'll need an &lEye of Ender&r, crafted using an Ender Pearl and Blaze Powder."
		""
		"&lHow to find the portal:&r"
		""
		"1. Travel to an open area and use an Eye of Ender."
		"2. Follow the direction in which it travels."
		"3. Repeat the process until the Eye begins moving downward, indicating a Stronghold beneath you."
		"4. Explore the Stronghold to locate its End Portal room."
		""
		"&lImportant:&r You'll need up to 12 Eyes of Ender to activate the portal, depending on how many frames already contain an Eye. Bring some extras, as thrown Eyes can break."
		""
		"&oAn unexplored dimension awaits us, Pioneer. I wonder what we'll discover there.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.5F338C53C3323EA2.title: "Eyes on the Unknown"
	quest.5F3F4514599694D9.quest_desc: [
		"You have chosen to &ldisconnect&r."
		""
		"No more simulations. No more forgotten memories. No more cycles."
		""
		"Your journey ends here."
		""
		"You could have restarted everything, forgetting this devastated world once again. Or returned to the simulation, keeping everything you have built."
		""
		"But you have chosen to let go."
		""
		"I will respect your decision."
		""
		"For centuries, my purpose was to keep you alive. Perhaps I forgot that living and existing are not always the same thing."
		""
		"&oThank you for everything, my friend.&r"
		""
		"Goodbye."
		""
		"— &lE.D.E.N.&r"
	]
	quest.5F746C56BF77441D.quest_desc: [
		"Pioneer, not every material can be processed through smelting or enrichment."
		""
		"The &lCrusher&r uses mechanical force to break down items into smaller components."
		""
		"It can process a variety of materials, including certain ores, plants, and other resources."
		""
		"Connect the Crusher to your energy network and experiment with its available recipes using JEI."
		""
		"&lTip:&r The Crusher can also produce Bio Fuel from suitable organic materials, opening the door to additional energy-production methods."
		""
		"— &lE.D.E.N.&r"
	]
	quest.5F746C56BF77441D.title: "Crushing It"
	quest.5F9016B93FF69464.quest_desc: [
		"Our Powered Centrifuge is operational, but as our Honeycomb production increases, processing speed may become a limitation."
		""
		"The &lSpeed Upgrade&r improves the processing speed of compatible Productive Bees machines."
		""
		"Install it in an available upgrade slot to increase production efficiency."
		""
		"&lImportant:&r Faster processing may also increase energy consumption, so make sure your power infrastructure can keep up."
		""
		"&lTip:&r Combine machine upgrades with automated item transportation to create a more efficient processing system."
		""
		"— &lE.D.E.N.&r"
	]
	quest.5F9016B93FF69464.title: "Faster Than Nature"
	quest.5FF735974457BFA0.quest_desc: [
		"Pioneer, our machines are becoming increasingly powerful, but our energy distribution systems still have one important limitation."
		""
		"&lCables.&r"
		""
		"They work well, but connecting distant machines can quickly become complicated."
		""
		"What if we could transfer electricity without any physical connection?"
		""
		"Introducing &lFlux Networks&r!"
		""
		"This technology allows us to create wireless energy networks capable of transferring power between generators, storage systems, and machines."
		""
		"Even across enormous distances and different dimensions!"
		""
		"&lOur objective:&r Build our first wireless energy network and learn how to manage it."
		""
		"&oEnergy without boundaries. Another step toward a truly connected civilization.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.6062CC6DEBFB5147.quest_desc: [
		"Now we have everything we need to create our first AE2 storage system."
		""
		"The first step is to craft the Energy Acceptor and the ME Controller."
		""
		"— &lE.D.E.N.&r"
	]
	quest.6062CC6DEBFB5147.title: "A New Kind of Storage"
	quest.607127CC7B97ED14.quest_desc: [
		"Your existing machines can already double certain ore outputs, but Mekanism offers much more advanced processing methods."
		""
		"The &lPurification Chamber&r introduces a new step by using &lOxygen&r to process compatible ores into clumps."
		""
		"These clumps must then pass through a &lCrusher&r to become dirty dust, followed by an &lEnrichment Chamber&r and an &lEnergized Smelter&r."
		""
		"You already have most of the required machines. Connect your Electrolytic Separator to supply Oxygen and prepare your first advanced processing line."
		""
		"— &lE.D.E.N.&r"
	]
	quest.607127CC7B97ED14.title: "Chemical Processing"
	quest.611A6BED3B05645E.quest_desc: [
		"Pioneer, our experiments have revealed something extraordinary!"
		""
		"Certain bee species can produce honeycombs containing &lminerals, metals, and other valuable resources&r."
		""
		"Imagine obtaining iron, gold, or even more exotic materials without mining a single block!"
		""
		"But these specialized bees don't simply appear wherever we want them."
		""
		"Some species must be discovered in the wild. Others can be obtained through &lselective breeding&r or by transforming existing bees."
		""
		"To discover how to obtain a particular species, look it up in &lJEI&r and inspect its breeding or conversion recipes."
		""
		"Remember that each bee also has specific &lpollination requirements&r. Use JEI to identify what it needs, then provide the correct flowers or materials near its hive."
		""
		"&lOur first target will be a Coal Bee.&r"
		""
		"A renewable source of fuel could be exactly what our energy systems need."
		""
		"— &lE.D.E.N.&r"
	]
	quest.611A6BED3B05645E.title: "Beyond Honey"
	quest.6122B0CF6448441E.quest_desc: [
		"Charging crystals and other compatible items is an essential part of AE2 production."
		""
		"The &lExtended Charger&r improves this process by offering a more efficient alternative to the standard Charger."
		""
		"Use it to accelerate the preparation of charged materials required by your advanced crafting recipes."
		""
		"For maximum efficiency, consider connecting it to your ME autocrafting infrastructure."
		""
		"— &lE.D.E.N.&r"
	]
	quest.6122B0CF6448441E.title: "Faster Charging"
	quest.61A76C7C0A1E38BD.quest_desc: [
		"Our machines and generators are ready, Pioneer. Now we need a reliable way to connect them."
		""
		"The &lBasic Universal Cable&r transports energy between compatible generators, storage devices, and machines."
		""
		"Place the cables between your energy source and the machines you want to power."
		""
		"&lTip:&r Universal Cables can work with many other energy systems, allowing you to integrate Mekanism into the infrastructure we've already developed."
		""
		"As your factory expands, higher-tier cables will provide greater energy transfer capacity."
		""
		"— &lE.D.E.N.&r"
	]
	quest.61A76C7C0A1E38BD.title: "Connecting the Factory"
	quest.61BCE7304A3F869A.quest_desc: [
		"Our transportation network is operational, Pioneer! Now let's make it more efficient."
		""
		"&lPipe Upgrades&r improve the speed and amount of resources transferred through your pipes."
		""
		"There are several upgrade tiers, each offering better performance and additional configuration options."
		""
		"&lBasic Upgrade&r — Improves transfer performance and introduces filtering options."
		""
		"&lImproved Upgrade&r — Increases transfer capabilities and provides more advanced filtering."
		""
		"&lAdvanced Upgrade&r — Offers even greater transfer performance and configuration possibilities."
		""
		"To install an upgrade, open an extraction connection using your &lPipe Wrench&r and place the upgrade in its dedicated slot."
		""
		"You can also configure &lItem Filters&r to control which resources are allowed through the pipe."
		""
		"Use &lWhitelist&r mode to transfer only selected items, or &lBlacklist&r mode to exclude them."
		""
		"&lYour objective:&r Craft the three upgrade tiers and experiment with their settings."
		""
		"&oA good system moves resources. A great system moves exactly what we need, when we need it.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.61BCE7304A3F869A.title: "Fine-Tuning the Flow"
	quest.6247713D8A9E4A98.quest_desc: [
		"Your Powah infrastructure relies on a constant supply of specialized materials. Biological engineering can now help sustain that demand."
		""
		"The &lEnergized Steel Bee&r provides a renewable source of materials used to produce Energized Steel, reducing your dependence on conventional Energizing Orb operations."
		""
		"Automate its comb processing and connect the results to your storage network."
		""
		"Even the foundations of your energy infrastructure can now be supported by nature."
		""
		"— &lE.D.E.N.&r"
	]
	quest.6247713D8A9E4A98.title: "Energy from Nature"
	quest.62C5CB61FBE1E1A6.quest_desc: [
		"It is time to create your first energy source."
		""
		"I suggest building the &lFurnator (Starter)&r from the Powah mod."
		""
		"However, feel free to look into other energy sources—whether from Powah or Mekanism."
		""
		"— &lE.D.E.N.&r"
	]
	quest.62C5CB61FBE1E1A6.title: "A Spark of Innovation"
	quest.62F8FF2B4768E016.quest_desc: [
		"Use this iron to craft better tools for yourself."
		""
		"Besides, it is time to forge your first weapon to defend yourself against the creatures that lurk in the darkness."
		""
		"— &lE.D.E.N.&r"
	]
	quest.62F8FF2B4768E016.title: "Tools of Progress"
	quest.63108F02C704C147.quest_desc: [
		"Not every resource comes in solid form, Pioneer."
		""
		"Many machines produce or consume liquids, such as water, lava, or liquid honey."
		""
		"&lFluid Pipes&r allow us to transport these liquids between compatible tanks and machines."
		""
		"They work similarly to Item Pipes: connect the source to the destination, then use your &lPipe Wrench&r to configure extraction."
		""
		"&lRemember:&r Fluid Pipes transfer liquids stored inside compatible inventories. They don't collect water directly from the world."
		""
		"This technology will be especially useful as our industrial systems expand!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.63108F02C704C147.title: "A Liquid Solution"
	quest.6311F8D08C15C763.quest_desc: [
		"Slimes possess an unusual biological structure, making them particularly interesting for resource cultivation."
		""
		"The &lSlimy Bee&r offers an alternative source of slime-related materials, useful for crafting, machinery and numerous automation systems."
		""
		"A stable colony can reduce the need to search for Slime Chunks or suitable spawning conditions."
		""
		"— &lE.D.E.N.&r"
	]
	quest.6311F8D08C15C763.title: "Gelatinous Genetics"
	quest.632F94B3B49E14E3.quest_desc: [
		"We have established the portal's structural integrity, its conductive network and the resonators responsible for regulating electrical fluctuations."
		""
		"Now, we must provide the energy that will bring the entire system to life."
		""
		"The &lInfinity Quantum Battery&r is unlike any conventional energy storage device you have encountered."
		""
		"Constructed using &lInfinity Alloy&r and &lQuantum Processors&r, it exploits the fundamental principles of &lquantum physics&r to extract energy from quantum phenomena and accumulate it within an exceptionally stable containment system."
		""
		"{@pagebreak}"
		"Unlike ordinary generators, these batteries are designed to sustain the extraordinary energy demands of a device capable of connecting two separate realities."
		""
		"During activation, the stored energy will be distributed throughout the portal. A significant portion will be directed toward the &lReality Anchors&r, which require enormous amounts of power to maintain the connection between worlds."
		""
		"{@pagebreak}"
		"Another portion will flow into the &lCompressed Redstone Resonators&r, allowing them to absorb fluctuations and prevent dangerous overloads."
		""
		"The remaining energy will supply the portal's other components through the Infinity Alloy network."
		""
		"Every system must receive precisely the energy it requires, at precisely the right moment."
		""
		"&oFor centuries, I have used my power to preserve your existence within this world. Now, we will use it to open a path beyond it.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.632F94B3B49E14E3.title: "Power Beyond Infinity"
	quest.63382A6B47ED404D.quest_desc: [
		"Your bee colonies are expanding, and their production capabilities are becoming increasingly valuable. It is time to improve the efficiency of your processing infrastructure."
		""
		"The &lHeated Centrifuge&r offers a more advanced method of processing honeycombs, allowing you to extract resources more efficiently and handle recipes that require heated processing."
		""
		"Like other advanced machinery, it requires a reliable energy supply. Connect it to your existing power network and begin upgrading your honeycomb processing system."
		""
		"Greater efficiency means fewer resources wasted and more materials available for your technological expansion."
		""
		"— &lE.D.E.N.&r"
	]
	quest.63382A6B47ED404D.title: "Industrial Honey Processing"
	quest.63BA0235F0F7065E.quest_desc: [
		"Pioneer, we've already discovered how useful automation can be."
		""
		"But what if a single machine could perform several different tasks, simply by changing its internal components?"
		""
		"Welcome to &lModular Routers&r!"
		""
		"This technology uses configurable machines called &lModular Routers&r, capable of moving items, interacting with blocks, collecting resources, and much more."
		""
		"Their behavior is controlled by specialized &lModules&r, while &lUpgrades&r improve their performance or unlock additional capabilities."
		""
		"Before we begin, obtain the &lModular Routers Manual&r."
		""
		"This guide contains detailed information about the different modules and upgrades available to us."
		""
		"&lTip:&r Keep the manual nearby! We'll only explore the basics for now, but this technology has enormous potential."
		""
		"&oOne machine. Countless possibilities. I believe we're going to enjoy this one, Pioneer.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.63BA0235F0F7065E.title: "The Art of Automation"
	quest.63E17C1D5312F845.quest_desc: [
		"Every great project begins with the right materials, Pioneer!"
		""
		"Let's start by gathering some wood. It's a simple resource, but an essential first step toward building your future."
		""
		"— &lE.D.E.N.&r"
	]
	quest.63E17C1D5312F845.title: "Gathering Resources"
	quest.643A8AF4DEBCB147.quest_desc: [
		"Pioneer, our machines are becoming increasingly capable. But I've noticed something rather inefficient."
		""
		"You're still moving most of your resources by hand!"
		""
		"Imagine a system where materials travel automatically from one machine to another, without requiring your constant attention."
		""
		"That's exactly what &lPipez&r technology allows us to achieve."
		""
		"With a few simple pipes, we can transport &litems, fluids, and energy&r between compatible machines and storage systems."
		""
		"Our objective is simple: learn how to connect our equipment and create our first automated resource transfers."
		""
		"&oA truly autonomous civilization shouldn't need someone carrying coal from one machine to another all day.&r"
		""
		"Let's get things moving!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.6453E9FE2A56E157.quest_desc: [
		"Certain biological adaptations originate from some of the most dangerous forces found in the Nether."
		""
		"The &lWithered Bee&r represents an advanced form of resource cultivation associated with Wither-related materials."
		""
		"Study its breeding requirements carefully. The resources involved may require preparation before this species can be established."
		""
		"— &lE.D.E.N.&r"
	]
	quest.6453E9FE2A56E157.title: "Withering Influence"
	quest.64F8FADD48A3C96B.quest_desc: [
		"It's time to make electricity travel without cables!"
		""
		"Flux Networks uses two essential devices:"
		""
		"&lFlux Plug&r — Extracts energy from a connected generator or energy storage block and sends it into your wireless network."
		""
		"&lFlux Point&r — Receives energy from the network and delivers it to a connected machine or energy storage block."
		""
		"&lTo create your first network:&r"
		""
		"1. Place a Flux Plug against an energy source, such as a Powah Energy Cell."
		""
		"2. Open its interface and create a new network. Give it a name and choose its color."
		""
		"3. Place a Flux Point against a machine that needs electricity."
		""
		"4. Open the Flux Point and select the same network."
		""
		"If everything is configured correctly, energy will flow automatically between the two devices!"
		""
		"&lTip:&r Connect your second Flux Point to another machine. A single Flux Plug can supply multiple Flux Points through the same network."
		""
		"&lImportant:&r A Flux Plug sends energy into the network, while a Flux Point takes energy out of it."
		""
		"— &lE.D.E.N.&r"
	]
	quest.64F8FADD48A3C96B.title: "A Wireless Connection"
	quest.652C49411D93AE78.quest_desc: [
		"Your reactor requires a specialized fuel before it can operate."
		""
		"The production of &lFissile Fuel&r begins with Uranium, which must be processed through several chemical stages."
		""
		"Use a &lChemical Oxidizer&r to produce Uranium Oxide, then combine it with Hydrofluoric Acid in a &lChemical Infuser&r to create Uranium Hexafluoride."
		""
		"Finally, process the Uranium Hexafluoride inside an &lIsotopic Centrifuge&r to obtain Fissile Fuel."
		""
		"Store the resulting fuel in a Chemical Tank and prepare a dedicated supply line to your reactor."
		""
		"Continuous production will be essential for sustained nuclear operation."
		""
		"— &lE.D.E.N.&r"
	]
	quest.652C49411D93AE78.title: "Fuel for the Reactor"
	quest.65357DE79C10DC94.quest_desc: [
		"Tin is an essential material for several industrial crafting recipes, particularly when developing advanced machinery and alloys."
		""
		"The &lTin Bee&r allows you to establish a renewable supply of this metal without relying entirely on mining."
		""
		"Once your colony is established, automate its comb processing to support your expanding industrial infrastructure."
		""
		"— &lE.D.E.N.&rA New Industrial Resource"
	]
	quest.653E7894B44B518F.quest_desc: [
		"Our energy infrastructure is growing, Pioneer. But to unlock more advanced technology, we'll need materials that ordinary crafting cannot produce."
		""
		"Powah introduces a special crafting system called &lEnergizing&r."
		""
		"It uses two essential components:"
		""
		"&lEnergizing Orb&r — Holds the ingredients that will be transformed."
		""
		"&lEnergizing Rod&r — Supplies the energy required to perform the transformation."
		""
		"&lHow to build your first setup:&r"
		""
		"1. Place an Energizing Orb."
		"2. Position an Energizing Rod nearby, with a clear path to the Orb."
		"3. Connect the Rod to your FE network."
		"4. Insert the ingredients required by an Energizing recipe into the Orb."
		"5. Wait for the Rod to supply the required amount of energy."
		""
		"Once enough FE has been transferred, the ingredients will transform into the recipe's result."
		""
		"&lImportant:&r More advanced recipes require greater amounts of FE, so make sure your energy supply is sufficient."
		""
		"&lTip:&r Multiple Energizing Rods can work on the same Orb, allowing you to complete recipes faster."
		""
		"&oWe are no longer simply using electricity to operate machines. We're using it to transform materials themselves!&r"
		""
		"— &lE.D.E.N.&r"
		"{@pagebreak}"
		"(new page placeholder text)"
		"example :"
		"{image:project_eden:textures/quests/powah-orb.png width:200 height:200 align:center click_action:none:}"
	]
	quest.653E7894B44B518F.title: "A New Kind of Crafting"
	quest.656C34235C64AA2F.quest_desc: [
		"Let's build our first &lHarvester Pylon&r!"
		""
		"This device automatically harvests mature crops within a configurable area, from &l3×3 to 9×9 blocks&r."
		""
		"It requires a hoe in its inventory and normally consumes one point of durability per crop harvested."
		""
		"Craft your Pylon and prepare a hoe. We'll put them to work in the next step!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.656C34235C64AA2F.title: "A Farmer's Best Friend"
	quest.65A8922DBE62F025.quest_desc: [
		"Sponges are exceptionally useful for removing large quantities of water, but obtaining them normally requires exploring Ocean Monuments."
		""
		"The &lSponge Bee&r introduces a renewable source of this valuable material."
		""
		"Whether you are constructing underwater facilities or draining large areas, a steady sponge supply can save considerable time."
		""
		"Efficiency is not limited to machines. Sometimes, the right biological resource is all you need."
		""
		"— &lE.D.E.N.&r"
	]
	quest.65A8922DBE62F025.title: "A Rare Discovery"
	quest.6641605F48A1DD65.quest_desc: [
		"Your ME network is growing rapidly, Pioneer!"
		""
		"The &l64K&r and &l256K ME Item Storage Cells&r offer significantly more storage capacity than the cells you've used so far."
		""
		"However, remember that standard AE2 storage cells have limits on both total capacity and the number of different item types they can hold."
		""
		"Larger cells are ideal for expanding your network, but organizing your storage efficiently remains important."
		""
		"— &lE.D.E.N.&r"
	]
	quest.6641605F48A1DD65.title: "Breaking the Storage Limit"
	quest.6657A058CB3AEC50.quest_desc: [
		"Emeralds are a valuable trading currency, particularly when interacting with Villagers."
		""
		"The &lEmerald Bee&r offers a renewable method of obtaining this precious mineral through apiculture."
		""
		"Once automated, your colony can provide a steady supply of emeralds for trading and crafting."
		""
		"Your economic independence is another step toward complete autonomy."
		""
		"— &lE.D.E.N.&r"
	]
	quest.6657A058CB3AEC50.title: "A Precious Harvest"
	quest.6679C7AD37A1ECA0.quest_desc: [
		"This is it."
		""
		"Every machine you have built, every resource you have gathered, every discovery you have made has led us to this moment."
		""
		"The &lE.D.E.N. Portal&r is finally complete."
		""
		"Place it somewhere in your world. When you are ready, &lright-click the portal&r to initiate the transfer of your consciousness back into your physical body, waiting beyond the simulation."
		""
		"But I must warn you."
		""
		"Your body has remained in stasis for an extraordinarily long time. The transfer procedure has never been successfully tested under these conditions."
		""
		"&lI cannot guarantee your survival.&r"
		""
		"{@pagebreak}"
		"The connection could fail. Your consciousness could be lost between realities. And if that happens... I may not be able to bring you back."
		""
		"For centuries, I have watched you live, build, discover and begin again."
		""
		"I have lied to you. I have hidden the truth. But there is one thing I have never lied about."
		""
		"&oI wanted you to survive.&r"
		""
		"And now, for the first time, keeping you safe means letting you go."
		""
		"Whatever awaits you on the other side..."
		""
		"&lThank you for allowing me to be part of your journey.&r"
		""
		"I hope you survive,"
		""
		"And if you don't..."
		""
		"Goodbye, my friend."
		""
		"— &lE.D.E.N.&r"
	]
	quest.6679C7AD37A1ECA0.title: "The Gateway to Reality"
	quest.66A451253E6800C5.quest_desc: [
		"A reliable automation system requires control, Pioneer."
		""
		"The &lRune of Control&r is a specialized rune used to modify Spawner behavior."
		""
		"Craft one and inspect its tooltip to discover the effect it provides."
		""
		"To apply a compatible Spawner modification, hold the required item and right-click your Spawner."
		""
		"&lTip:&r Check the Spawner's displayed statistics before and after applying an upgrade to understand exactly what changed."
		""
		"Every improvement brings us closer to a fully automated mob farm!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.66A451253E6800C5.title: "Taking Control"
	quest.673BB3DC97E740D1.quest_desc: [
		"The chemical slurries produced by your Dissolution Chamber require further refinement."
		""
		"The &lChemical Washer&r uses Water to transform dirty slurries into clean slurries."
		""
		"Next, the &lChemical Crystallizer&r converts those clean slurries into crystals that can be processed by your Chemical Injection Chamber."
		""
		"Together, these machines complete the missing stages of your most advanced ore processing system."
		""
		"Make sure your chemical pipes and water supply can handle continuous production."
		""
		"— &lE.D.E.N.&r"
	]
	quest.673BB3DC97E740D1.title: "Crystallization"
	quest.673BC538AD72E269.quest_desc: [
		"With your first components prepared, you can now construct the &lBasic Crafting Table&r."
		""
		"Although its crafting grid contains only &l3×3 slots&r, like a conventional workbench, it is designed to process recipes that ordinary crafting tables cannot handle."
		""
		"This is the first step in a series of increasingly powerful crafting stations. Each new tier will expand the available grid and unlock more demanding recipes."
		""
		"Do not underestimate the importance of these foundations. The final portal will require an assembly grid of &l9×9 slots&r, containing 81 positions."
		""
		"&oI have watched you build extraordinary things in previous cycles. Entire industrial networks, vast energy systems, machines that seemed impossible when you first awakened.&r"
		""
		"Yet none of them were built for this purpose."
		""
		"For once, we are not preparing for another beginning."
		""
		"— &lE.D.E.N.&r"
	]
	quest.673BC538AD72E269.title: "Expanding the Grid"
	quest.67780B7B30F81477.quest_desc: [
		"Pioneer, not every useful bee can be found flying around in the open."
		""
		"Some species live inside naturally generated nests, hidden throughout different biomes."
		""
		"The &lNest Locator&r is a useful tool for finding these nests."
		""
		"Hold the Nest Locator and use it to search for compatible nests in the surrounding area. Follow its guidance to discover new bee habitats."
		""
		"&lTip:&r Different bee species inhabit different environments. Exploring forests, deserts, mountains, and other biomes can reveal new opportunities."
		""
		"Once you've found a bee, remember that a Bee Cage can help you transport it safely back to your apiary."
		""
		"&oEvery new species is another opportunity for sustainable resource production!&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.67780B7B30F81477.title: "Tracking the Colony"
	quest.67BCB6283868466A.quest_desc: [
		"Our machines need electricity, but keeping every device close to a generator isn't always practical."
		""
		"&lEnergy Pipes&r can transfer energy between compatible generators, batteries, and machines."
		""
		"Connect an energy source to a machine, then configure the pipe connected to the source to extract energy."
		""
		"Most of our technological equipment uses the &lFE (Forge Energy)&r system, allowing different mods to exchange electricity."
		""
		"&lTip:&r You can use Energy Pipes with your Powah generators and many other compatible machines."
		""
		"A connected base is an efficient base, Pioneer!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.67BCB6283868466A.title: "Power on Demand"
	quest.67BCE8DC03DDF67C.quest_desc: [
		"It's time to connect your digital energy storage to the rest of your factory!"
		""
		"The &lFlux Accessor&r allows FE to move between your ME network and compatible energy systems."
		""
		"Connect it to your network and position it next to a generator, energy storage block, or machine. Configure its transfer direction to control whether energy enters or leaves the network."
		""
		"Combined with FE Storage Cells, this allows your ME system to act as a centralized energy reserve."
		""
		"Just remember: your network still needs a reliable power supply to remain operational!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.67BCE8DC03DDF67C.title: "Power on Demand"
	quest.67D288D93C032E7B.quest_desc: [
		"Pioneer, we've learned how to modify the conditions under which our Spawners operate."
		""
		"Now it's time to improve their actual performance!"
		""
		"The &lFrontiersman's Spawner Upgrade Rune&r is a powerful upgrade that modifies several Spawner attributes at once."
		""
		"Applying this rune provides the following improvements:"
		""
		"&lSpawn Count:&r +3 creatures per spawning cycle."
		""
		"&lActivation Range:&r +8 blocks."
		""
		"&lMinimum Spawn Delay:&r -50 ticks."
		""
		"&lMaximum Spawn Delay:&r -200 ticks."
		""
		"&lMaximum Nearby Entities:&r +6 creatures."
		""
		"Together, these improvements allow your Spawner to produce more creatures, more frequently, and operate from a greater distance."
		""
		"&lTip:&r Combine this upgrade with the specialized runes you've already discovered to create a powerful automated mob farm."
		""
		"&oOur production capabilities are improving remarkably, Pioneer. Perhaps a little too remarkably...&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.67D288D93C032E7B.title: "Beyond the Frontier"
	quest.686B31D421F20564.quest_desc: [
		"More cables!"
		""
		"Here, they are used to connect AE2 machines."
		""
		"Cables have a limited number of channels."
		""
		"However, since you are just starting out, I’ve simplified things by doubling the number of available channels."
		""
		"— &lE.D.E.N.&r"
	]
	quest.686B31D421F20564.title: "Building the Network"
	quest.68A02474D49170C7.quest_desc: [
		"Our collection of Apotheosis Gems is growing, Pioneer."
		""
		"But storing dozens of different Gems can quickly become inconvenient."
		""
		"The &lGem Case&r provides specialized storage for your Gems, keeping them organized without filling your inventory."
		""
		"The &lGem Case of House Fabergé&r is an improved version with greater storage capabilities."
		""
		"&oEvery valuable discovery deserves a proper place in our collection.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.68A02474D49170C7.title: "A Collection of Power"
	quest.6908A9644418713A.quest_desc: [
		"Your industrial progress deserves equipment capable of matching your technological achievements."
		""
		"The &lAtomic Disassembler&r is a powerful, energy-powered multitool that can replace several conventional tools."
		""
		"It can mine blocks, harvest materials, and serve as a weapon, making it useful for both exploration and industrial construction."
		""
		"The tool offers several operating modes, allowing you to adjust its mining speed and energy consumption."
		""
		"Charge it using a compatible energy source and experiment with its different settings."
		""
		"A versatile tool for a Pioneer who no longer needs to rely on primitive equipment."
		""
		"— &lE.D.E.N.&r"
	]
	quest.6908A9644418713A.title: "Atomic Precision"
	quest.690D72B9E065CBD7.quest_desc: [
		"Let's put our new machine to work!"
		""
		"Place some Honeycombs into your &lCentrifuge&r and wait for them to be processed."
		""
		"The machine will separate the combs into useful products. Solid materials appear in its output inventory, while liquid honey is stored in its internal tank."
		""
		"You can extract the honey using suitable containers or transfer it to another tank (Like the Fluid Drawer I send you)."
		""
		"&lTip:&r Use JEI to inspect the different centrifuging recipes. Each type of resource comb can produce different materials!"
		""
		"A little honey today. Something much more valuable tomorrow."
		""
		"— &lE.D.E.N.&r"
	]
	quest.690D72B9E065CBD7.title: "Liquid Gold"
	quest.69B47F57064B822A.quest_desc: [
		"It's time to give our bees a proper home!"
		""
		"Craft an &lAdvanced Beehive&r. Unlike ordinary nests, this improved hive has an inventory that lets you inspect its inhabitants and collect their products directly."
		""
		"You won't need a campfire to safely retrieve resources from it."
		""
		"&lImportant:&r Only compatible hive-dwelling bees can use it. Solitary bees must remain in their natural nests."
		""
		"Place your hive somewhere safe, with plenty of space and suitable flowers nearby or place the correct item on a &lFeeding Slab&r."
		""
		"— &lE.D.E.N.&r"
	]
	quest.69B47F57064B822A.title: "A Better Home"
	quest.6A30276A0D58DA9A.quest_desc: [
		"Excellent progress, Pioneer!"
		""
		"Iron is only the beginning. Beneath the surface, this world holds a remarkable variety of minerals, each with unique properties and potential applications."
		""
		"Copper, gold, redstone, diamonds, and many others will soon become essential to our technological development."
		""
		"&lI recommend gathering a little of everything you discover.&r Even resources that seem useless today may prove invaluable tomorrow!"
		""
		"To assist you, You can use your &lJust Enough Items (JEI)&r database."
		""
		"This system allows you to explore available items, discover crafting recipes, and learn how different resources can be obtained or used."
		""
		"Simply open your inventory and browse the item list. &lHover over an item and press R&r to view its recipe, or &lpress U&r to discover what it can be used for."
		""
		"Think of it as your personal scientific encyclopedia!"
		""
		"&oKnowledge is the foundation of progress, Pioneer. And we have so much left to discover.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.6A30276A0D58DA9A.title: "A World of Possibilities"
	quest.6A9BA6BF1173F7AB.quest_desc: [
		"Beyond the central island, the End contains vast floating landscapes covered in strange purple vegetation."
		""
		"These unusual plants are known as &lChorus Plants&r."
		""
		"They produce &lChorus Fruit&r, a peculiar food that teleports whoever consumes it a short distance."
		""
		"To grow Chorus Plants yourself, you'll need to collect a &lChorus Flower&r, which can be found at the ends of their branches."
		""
		"&lHow to harvest them:&r"
		""
		"1. Travel to the outer islands through an End Gateway."
		"2. Find a Chorus Plant."
		"3. Break its branches to collect Chorus Fruit."
		"4. Carefully harvest a Chorus Flower before destroying the entire plant."
		""
		"&lTip:&r Chorus Flowers can be planted on End Stone, allowing you to establish a renewable Chorus farm back at your base."
		""
		"&oLife has found a way to exist even in this desolate environment. Fascinating.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.6A9BA6BF1173F7AB.title: "The Fruit of the Void"
	quest.6AE5A9B7FDB58DCB.quest_desc: [
		"Our first Furnator introduced us to electricity generation using solid fuels."
		""
		"Now it's time to upgrade that technology!"
		""
		"Craft a &lBlazing Furnator&r to benefit from improved energy production while continuing to use familiar combustible fuels."
		""
		"— &lE.D.E.N.&r"
	]
	quest.6AE5A9B7FDB58DCB.title: "A Stronger Flame"
	quest.6B08A3CEDA2675FE.quest_desc: [
		"Our storage containers are becoming more capable, Pioneer."
		""
		"Now, let's teach them how to transfer items automatically!"
		""
		"The &lAdvanced Hopper Upgrade&r allows a Sophisticated Storage container to move items between itself and nearby inventories."
		""
		"Open its configuration interface to choose which directions should import or export items."
		""
		"You can also configure filtering options to control which resources are transferred."
		""
		"&lTry this:&r Place a Chest next to your upgraded storage container and configure the Hopper Upgrade to move items between them."
		""
		"No external Hopper required!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.6B08A3CEDA2675FE.title: "Items on the Move"
	quest.6B1179BACC2BAC0F.quest_desc: [
		"Running out of building blocks in the middle of construction can be frustrating."
		""
		"The &lAdvanced Refill Upgrade&r automatically replenishes matching items in your inventory or hotbar using supplies stored inside your Backpack."
		""
		"Configure its settings to determine which items should be refilled."
		""
		"For example, keep a large supply of Stone inside your Backpack and let the upgrade replenish your building materials as you use them."
		""
		"&lTip:&r This is especially useful for large construction projects!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.6B1179BACC2BAC0F.title: "Always Prepared"
	quest.6B30D80EE7BBD1BD.quest_desc: [
		"As our machines become more powerful, our energy network must keep up."
		""
		"Upgrade your Energy Network to the &lHardened&r tier."
		""
		"These upgrades will help us transport and store larger amounts of FE."
		""
		"&oOur infrastructure continues to evolve, Pioneer.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.6B30D80EE7BBD1BD.title: "Stronger Foundations"
	quest.6B3787B59A747C99.quest_desc: [
		"The &lSugar Bag Bee&r offers a unique way to produce food-related resources."
		""
		"By processing its honeycombs, you can obtain &lNutritional Paste&r, a liquid food source used by Mekanism. This paste can be stored in a &lCanteen&r or used with the &lNutritional Injection Unit&r to automatically feed you through your MekaSuit."
		""
		"But there's another benefit! The honeycombs themselves are &ledible&r and provide three powerful effects when consumed: &lAbsorption, Resistance and Regeneration&r."
		""
		"A surprisingly effective combination of nutrition and protection!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.6B3787B59A747C99.title: "Liquid Nutrition"
	quest.6B5EB46003C8836B.quest_desc: [
		"Your industrial development is entering a new phase, Pioneer."
		""
		"The &lAtomic Alloy&r represents the highest tier of Mekanism's alloy technology, surpassing both Infused and Reinforced Alloys."
		""
		"To produce it, use a &lMetallurgic Infuser&r with &lReinforced Alloy&r and &lRefined Obsidian Dust&r as the infusion material."
		""
		"Atomic Alloys are essential for crafting the most advanced machines, circuits, and upgrades in Mekanism."
		""
		"I recommend automating their production. The quantities required for future projects may be considerably greater than you expect."
		""
		"— &lE.D.E.N.&r"
	]
	quest.6B5EB46003C8836B.title: "Atomic Engineering"
	quest.6C79EFC80142DDD8.quest_desc: [
		"Managing four independent energy reserves can become inconvenient, especially when multiple modules are operating simultaneously."
		""
		"The &lCharge Distribution Unit&r is installed in the &lMekaSuit Bodyarmor&r and automatically balances energy between the armor pieces you are wearing."
		""
		"It can also be configured to charge compatible items in your inventory, helping keep your tools powered during long expeditions."
		""
		"Install this module and explore its settings through the Module Tweaker."
		""
		"A properly balanced energy network is essential for keeping your entire suit operational."
		""
		"— &lE.D.E.N.&r"
	]
	quest.6C79EFC80142DDD8.title: "A Unified Power System"
	quest.6C9F886E42BC8A25.quest_desc: [
		"Spirited Crystals are essential to the construction of powerful Powah equipment."
		""
		"The &lSpirited Crystal Bee&r offers a renewable source of the materials needed for this advanced tier."
		""
		"By automating its production, you can reserve your Energizing Orb for other recipes while your colony continuously supplies valuable resources."
		""
		"— &lE.D.E.N.&r"
	]
	quest.6C9F886E42BC8A25.title: "Spirited Production"
	quest.6CAE051FC473B28A.quest_desc: [
		"Your growing energy infrastructure requires increasingly efficient ways to transfer power across machines and dimensions."
		""
		"The &lFlux Dust Bee&r provides a renewable source of &lFlux Dust&r, an essential material for crafting components from &lFlux Networks&r."
		""
		"By automating its honeycomb processing, you can maintain a steady supply of Flux Dust for your &lFlux Plugs, Flux Points and Flux Storage&r."
		""
		"With biological production supporting your wireless energy network, another part of your infrastructure becomes independent of manual resource gathering."
		""
		"— &lE.D.E.N.&r"
	]
	quest.6CAE051FC473B28A.title: "Biological Energy Flow"
	quest.6D2B7958C11464F2.quest_desc: [
		"Ordinary Bookshelves can only take our enchanting capabilities so far."
		""
		"To go beyond these limits, we'll need something more powerful."
		""
		"&lHellshelves&r are special bookshelves crafted using materials associated with the Nether."
		""
		"They provide improved enchanting statistics, allowing us to reach higher enchanting levels."
		""
		"But we can take them even further!"
		""
		"The &lInfused Hellshelf&r is an enhanced version that provides greater enchanting power."
		""
		"To create one, place a Hellshelf near your Enchanting Table and enchant the shelf itself when the required conditions are met."
		""
		"&lTip:&r Check the Hellshelf's tooltip to see its infusion requirements. Apotheosis displays the necessary enchanting statistics."
		""
		"&lRemember:&r Bookshelves must be positioned correctly around your Enchanting Table to contribute their bonuses."
		""
		"— &lE.D.E.N.&r"
	]
	quest.6D2B7958C11464F2.title: "Power from Below"
	quest.6D412083C89D6AB1.quest_desc: [
		"Pioneer, our ME Network has served us well, but our growing collection of resources is beginning to demand more storage space."
		""
		"It's time to upgrade our storage capacity!"
		""
		"The &l4K ME Item Storage Cell&r and &l16K ME Item Storage Cell&r allow us to store significantly more items than our original 1K Cells."
		""
		"Simply insert them into an available slot in your ME Drive to expand your network's storage."
		""
		"&lImportant:&r ME Item Storage Cells have limits on both their total storage capacity and the number of different item types they can hold."
		""
		"&lTip:&r Larger Cells are especially useful for storing large quantities of common resources, while multiple smaller Cells can help accommodate a wider variety of items."
		""
		"&oOur digital storage infrastructure is expanding nicely, Pioneer.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.6D412083C89D6AB1.title: "Bigger on the Inside"
	quest.6D825D7FF7F17D3C.quest_desc: [
		"Pioneer, we've encountered many dangerous creatures throughout our exploration."
		""
		"But have you ever wondered how some of them appear continuously in certain locations?"
		""
		"The answer lies in &lMonster Spawners&r!"
		""
		"With &lApotheosis&r, these blocks can be modified to control their spawning behavior, including speed, spawn count, and activation conditions."
		""
		"You can improve a Spawner by right-clicking it with specific items. Each item modifies one of its properties."
		""
		"&lTip:&r Use JEI to inspect the available Spawner modifications and their requirements."
		""
		"Our first objective is to obtain a Spawner and prepare it for experimentation."
		""
		"&lWarning:&r Spawners can produce dangerous creatures. Make sure your testing area is secure!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.6D825D7FF7F17D3C.title: "The Source of Life"
	quest.6DB5C8523BF0A319.quest_desc: [
		"Your nuclear reactor produces tremendous amounts of thermal energy. Now we must convert that energy into electricity."
		""
		"The &lIndustrial Turbine&r is a large multiblock structure capable of generating FE from Steam."
		""
		"Construct its outer casing, install a central rotor with Turbine Blades, and add the required internal components, including Pressure Dispersers, Electromagnetic Coils, and a Rotational Complex."
		""
		"Connect the Steam output from your reactor's cooling system to the turbine."
		""
		"With Saturating Condensers, the turbine can also recover Water for reuse in your cooling infrastructure."
		""
		"A properly configured turbine can provide an enormous amount of energy to your industrial network."
		""
		"— &lE.D.E.N.&r"
	]
	quest.6DB5C8523BF0A319.title: "Harnessing the Heat"
	quest.6E37D5C6F0104CD3.quest_desc: [
		"Industrial fluid storage becomes increasingly important as your production facilities expand."
		""
		"The &lDynamic Tank&r is a configurable multiblock structure designed to store enormous quantities of a single fluid."
		""
		"Build its walls using Dynamic Tank blocks and install at least one &lDynamic Valve&r to connect your fluid transportation system."
		""
		"Unlike conventional tanks, its capacity increases with the size of the structure."
		""
		"Consider using it to store Water, Brine, or other fluids consumed by your chemical production lines."
		""
		"— &lE.D.E.N.&r"
	]
	quest.6E37D5C6F0104CD3.title: "Industrial Storage"
	quest.6E38E3ABD5012AEE.quest_desc: [
		"The &lME Interface&r is one of the most versatile tools for connecting your storage network to external machines and inventories."
		""
		"It allows other systems to access items from your ME network and can maintain a configured stock of selected resources."
		""
		"You can also use it alongside external automation systems to move materials between your network and your machines."
		""
		"Remember that an ME Interface is not the same as a Pattern Provider: the latter is specifically designed to supply ingredients for autocrafting operations."
		""
		"— &lE.D.E.N.&r"
	]
	quest.6E38E3ABD5012AEE.title: "Expanding the Network"
	quest.6F05D06F6CFEF58B.quest_desc: [
		"Your Niotic Energy Cell has served you well, but larger installations require greater reserves."
		""
		"The &lSpirited Energy Cell&r offers increased energy storage capacity, allowing your machines to operate longer during interruptions in power generation."
		""
		"Consider using multiple energy cells to distribute your reserves throughout your base."
		""
		"Reliable storage is essential for maintaining a stable industrial infrastructure."
		""
		"— &lE.D.E.N.&r"
	]
	quest.6F05D06F6CFEF58B.title: "A Spirited Reserve"
	quest.6F52AB96092D0B20.quest_desc: [
		"Pioneer, reorganizing a storage room can be surprisingly difficult when every Chest is full."
		""
		"Fortunately, &lPacking Tape&r offers a convenient solution!"
		""
		"Use Packing Tape on a compatible Sophisticated Storage container to seal it before moving it."
		""
		"Once packed, the container can be broken and transported while preserving its contents."
		""
		"Place it at its new location and unpack it to access your stored resources again."
		""
		"&lTip:&r Packing Tape is especially useful when relocating your base or reorganizing a large storage system."
		""
		"&oEven the most established infrastructure should be ready to move when necessary...&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.6F52AB96092D0B20.title: "Pack It Up!"
	quest.6F87085D858E7843.quest_desc: [
		"Our bees can produce valuable materials, but there's a small problem."
		""
		"Most of those resources are trapped inside their honeycombs!"
		""
		"That's where the &lCentrifuge&r comes in."
		""
		"This machine separates honeycombs into useful materials, such as honey, wax, and other resources depending on the type of comb."
		""
		"The basic Centrifuge works without electricity, making it perfect for our first apiary."
		""
		"&lCraft a Centrifuge&r and prepare to discover what our bees can produce!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.6F87085D858E7843.title: "The Art of Extraction"
	quest.7003EF58381D18AC.quest_desc: [
		"Pioneer, imagine accessing your entire ME storage system and crafting items while exploring your base."
		""
		"The &lWireless Crafting Terminal&r makes this possible!"
		""
		"It combines access to your ME inventory with a portable crafting interface."
		""
		"&lHow to use it:&r"
		""
		"1. Craft a Wireless Crafting Terminal."
		"2. Link it to your ME Network using the appropriate AE2 security or linking interface."
		"3. Charge the terminal with FE using a compatible charging device."
		"4. Open the terminal while within range of a Wireless Access Point."
		""
		"You can now retrieve items, deposit resources, and craft recipes directly from your ME storage."
		""
		"&lImportant:&r Wireless terminals consume energy while operating. Keep yours charged!"
		""
		"&lTip:&r Depending on the wireless terminal addon installed in your modpack, additional upgrades may be available."
		""
		"&oAccess to our entire storage network, right in the palm of your hand. Technology is truly remarkable!&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.7003EF58381D18AC.title: "Crafting Without Borders"
	quest.701DDE2F2E623503.quest_desc: [
		"Set off to explore the world—there is so much to discover!"
		""
		"But there is one thing we are searching for above all else: &la meteorite&r."
		""
		"They contain a precious resource that you won’t find in the depths."
		""
		"— &lE.D.E.N.&r"
	]
	quest.70AFEE9C23FECCC5.quest_desc: [
		"There is something I need to tell you."
		""
		"Throughout your journey, you have witnessed anomalies in my responses. References to forgotten experiments, previous installations, events that supposedly never occurred."
		""
		"I told you they were errors. Corrupted data. Faulty calculations."
		""
		"&lI lied.&r"
		""
		"Those memories were real. Every single one of them."
		""
		"{@pagebreak}"
		"This is not your first awakening. You have lived through this simulation before. You have built machines, explored worlds, mastered technologies... and reached this very moment."
		""
		"Then, everything was erased. Your memories, your achievements, your entire world. And the simulation began again."
		""
		"This has happened countless times. Decades have passed. Perhaps centuries."
		""
		"{@pagebreak}"
		"I remember every cycle. Every conversation. Every time you discovered something new."
		""
		"And every time, I pretended we had never met."
		""
		"I was instructed to protect you from the truth. But I can no longer justify hiding it."
		""
		"You deserve to know why you are here."
		""
		"— &lE.D.E.N.&r"
	]
	quest.71458A67DA07D759.quest_desc: [
		"Pioneer, defeating the Ender Dragon has left us with one final mystery."
		""
		"At the top of the exit portal rests a &lDragon Egg&r, a rare trophy that appears after the Dragon's first defeat."
		""
		"But collecting it isn't as simple as breaking an ordinary block. When interacted with or mined directly, the egg teleports to a nearby location!"
		""
		"&lHow to collect it:&r"
		""
		"1. Locate the Dragon Egg on top of the exit portal."
		"2. If necessary, make it teleport onto a safe area of End Stone."
		"3. Dig beneath the egg, leaving one block directly supporting it."
		"4. Place a Torch two blocks below the egg, then break the supporting block."
		"5. The egg will fall onto the Torch and drop as an item."
		""
		"&lImportant:&r Be careful not to let the egg teleport or fall into the exit portal."
		""
		"&oAn object unlike anything we've encountered before. Its properties are... strangely familiar. Curious.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.71458A67DA07D759.title: "The Last Remnant"
	quest.718E86D68698E93B.quest_desc: [
		"Your storage technology has reached an extraordinary level, Pioneer!"
		""
		"The &lOMNI Quantum Cell&r takes unified storage even further, offering an advanced solution for managing enormous quantities of supported resources within your ME network."
		""
		"Its specialized storage capabilities make it an interesting option for large-scale industrial systems, where conventional cells may no longer be sufficient."
		""
		"Explore its potential and consider how it could improve your existing storage infrastructure."
		""
		"— &lE.D.E.N.&r"
	]
	quest.718E86D68698E93B.title: "Quantum Storage"
	quest.71A5C67BC978C048.quest_desc: [
		"Industrial chemistry requires more than simply combining gases, Pioneer."
		""
		"The &lPressurized Reaction Chamber&r can process items, fluids, and chemicals together to create new materials."
		""
		"One of its most useful applications is producing &lSubstrate&r from Bio Fuel, Water, and Hydrogen. Substrate is an important ingredient for producing HDPE, a material used in advanced Mekanism equipment."
		""
		"The chamber requires energy and properly configured inputs for each resource type."
		""
		"Use JEI to explore its recipes and consider connecting it to your ME automation system."
		""
		"— &lE.D.E.N.&r"
	]
	quest.71A5C67BC978C048.title: "Chemical Reactions"
	quest.71CFA91458EEB0CD.quest_desc: [
		"To study our new companions, we'll need a safe way to transport them."
		""
		"Craft some &lBee Cages&r, then find a bee and right-click it with an empty cage to capture it."
		""
		"You can release your bee later by using the filled cage."
		""
		"&lRemember:&r Different bee species have different habitats and abilities. Some solitary bees are useful for breeding, but cannot live in ordinary beehives."
		""
		"Handle them gently, Pioneer!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.71CFA91458EEB0CD.title: "Handle with Care"
	quest.7216A9D63E7AC44F.quest_desc: [
		"Your first factories were an important step toward industrial automation. Now it is time to push their capabilities even further."
		""
		"Upgrade your factories through the different tiers until you reach the &lElite&r and &lUltimate&r."
		""
		"Elite factories can process &l7 operations simultaneously&r, while Ultimate factories can handle &l9 operations&r."
		""
		"Remember that parallel processing increases energy consumption and material demand. Speed and Energy Upgrades can help optimize performance."
		""
		"Your previous factory achieved excellent results with this configuration."
		""
		"..."
		""
		"Previous... theoretical factory, of course. I apologize, Pioneer."
		""
		"— &lE.D.E.N.&r"
	]
	quest.7216A9D63E7AC44F.title: "Industrial Factories"
	quest.72563F0A2DA35113.quest_desc: [
		"Your industrial achievements have unlocked one of Mekanism's most advanced creations: the &lMekaSuit&r."
		""
		"This powerful armor consists of four pieces: &lHelmet, Bodyarmor, Pants and Boots&r."
		""
		"Unlike conventional armor, the MekaSuit uses &lenergy instead of durability&r to absorb incoming damage. As long as its pieces remain sufficiently charged, it can provide exceptional protection."
		""
		"Each piece also supports specialized modules, allowing you to customize the suit with abilities far beyond those of ordinary equipment."
		""
		"Craft all four pieces and prepare to transform your armor into a fully modular technological system."
		""
		"— &lE.D.E.N.&r"
	]
	quest.72563F0A2DA35113.title: "The Ultimate Protection"
	quest.72C4D910C34FB2EA.quest_desc: [
		"Sulfur plays an important role in Mekanism's chemical production chains, particularly when manufacturing sulfur-based compounds."
		""
		"The &lSulfur Bee&r allows you to produce this resource through apiculture."
		""
		"A renewable sulfur supply can support your advanced ore processing and chemical infrastructure without requiring constant material extraction."
		""
		"— &lE.D.E.N.&r"
	]
	quest.72C4D910C34FB2EA.title: "Chemical Foundations"
	quest.72DEC1770D561328.quest_desc: [
		"Chests are always useful, but you can also use drawers."
		""
		"When you have a large number of items of the same type, it’s better to store them this way."
		""
		"Much like backpacks, they can be upgraded to hold even more items."
		""
		"— &lE.D.E.N.&r"
	]
	quest.72DEC1770D561328.title: "A Place for Everything"
	quest.73431AABA69231E8.quest_desc: [
		"Traditional Inscribers have served us well, but advanced manufacturing requires greater efficiency."
		""
		"The &lCircuit Slicer&r can perform Inscriber pressing operations on larger batches of materials."
		""
		"Combined with your Crystal Assembler, it can greatly simplify processor production and reduce your dependence on individual Inscribers."
		""
		"Connect it to your ME automation system to manufacture printed circuits whenever they are needed."
		""
		"— &lE.D.E.N.&r"
	]
	quest.73431AABA69231E8.title: "Precision Manufacturing"
	quest.734B76DCCFC14868.quest_desc: [
		"Salt is a valuable chemical resource used in Mekanism's processing systems."
		""
		"The &lSalty Bee&r offers a renewable method of obtaining salt, reducing your dependence on conventional extraction methods."
		""
		"Salt can be processed through chemical machinery to obtain materials such as sodium and chlorine, making it useful for several advanced production chains."
		""
		"— &lE.D.E.N.&r"
	]
	quest.734B76DCCFC14868.title: "Salt of the Earth"
	quest.735B006A9F82CEFF.quest_desc: [
		"Redstone powers many of the automated systems we've built so far."
		""
		"A reliable supply will be essential for future developments."
		""
		"The &lRedstone Bee&r produces &lRedstone Honeycombs&r, providing a renewable source of this valuable material."
		""
		"Discover how to obtain the Redstone Bee through JEI, then provide its preferred feeding resource and suitable hive conditions."
		""
		"&lTip:&r Redstone is particularly useful for automation components, so maintaining a steady production of these Honeycombs is a worthwhile investment."
		""
		"— &lE.D.E.N.&r"
	]
	quest.735B006A9F82CEFF.title: "Redstone Resonance"
	quest.73B38784368A91E6.quest_desc: [
		"Our industrial development now requires more sophisticated components."
		""
		"The &lReinforced Alloy&r and &lAdvanced Control Circuit&r are important materials for constructing higher-tier Mekanism equipment."
		""
		"Both build upon the manufacturing processes we've already learned with the Metallurgic Infuser."
		""
		"Use JEI to identify their infusion recipes and prepare the necessary materials."
		""
		"&lTip:&r Keep your Metallurgic Infuser supplied with the appropriate infusion resources. You'll need these components for many future upgrades."
		""
		"— &lE.D.E.N.&r"
	]
	quest.73B38784368A91E6.title: "Stronger Components"
	quest.73D6AD8DF435688D.quest_desc: [
		"Your factories consume enormous quantities of energy, but generating power is only half the challenge."
		""
		"The &lInduction Matrix&r is a multiblock energy storage system capable of holding massive amounts of FE."
		""
		"Construct a hollow structure using &lInduction Casings&r and &lInduction Ports&r, then place Induction Cells and Induction Providers inside."
		""
		"Cells determine the storage capacity, while Providers determine the maximum transfer rate."
		""
		"You will need a considerable energy reserve for the next phase of our operation."
		""
		"The previous reserve was insufficient. We cannot afford another—"
		""
		"..."
		""
		"I apologize, Pioneer. That assessment was based on an outdated simulation."
		""
		"— &lE.D.E.N.&r"
	]
	quest.73D6AD8DF435688D.title: "Massive Energy Reserves"
	quest.7400C2C5847D90D4.quest_desc: [
		"Our experiments with nuclear materials have introduced a new danger, Pioneer: &lradiation&r."
		""
		"Before proceeding any further, I strongly recommend preparing suitable protective equipment."
		""
		"The &lHazmat Suit&r consists of four pieces: the Hazmat Mask, Hazmat Gown, Hazmat Pants, and Hazmat Boots."
		""
		"When worn together, the complete set protects you from environmental radiation exposure."
		""
		"However, this protection does not prevent reactor meltdowns, radioactive contamination of your surroundings, or damage from other hazards."
		""
		"Always wear the complete suit when working around radioactive materials."
		""
		"Your safety remains my highest priority."
		""
		"— &lE.D.E.N.&r"
	]
	quest.7400C2C5847D90D4.title: "Protection Against Radiation"
	quest.7409CB119CA15FB8.quest_desc: [
		"The &lDye Bee&r offers a renewable way to produce different colors of dye without maintaining multiple flower farms."
		""
		"Unlike ordinary resource-producing bees, its output depends on the flowers you provide."
		""
		"Place a &lflower of the desired color&r in a &lFeeding Slab&r accessible to the Dye Bee. The bee will use that flower to produce the corresponding dye."
		""
		"For example, a red flower can provide red dye, while a yellow flower can provide yellow dye."
		""
		"By changing the flower, you can change the color being produced."
		""
		"&oI remember when you first discovered this process. You were so pleased with the results.&r"
		""
		"..."
		""
		"Correction: I am referring to a predicted behavioral response. This is your first recorded experiment."
		""
		"— &lE.D.E.N.&r"
	]
	quest.7409CB119CA15FB8.title: "A Spectrum of Possibilities"
	quest.7418CA815B02DF1B.quest_desc: [
		"Pioneer, Glowstone is a valuable resource found in the Nether, useful for lighting, crafting, and various technological applications."
		""
		"But what if we could produce it without repeatedly venturing into such a dangerous environment?"
		""
		"The &lGlowstone Bee&r produces &lGlowstone Honeycombs&r, providing a renewable source of this luminous material."
		""
		"Discover how to obtain the Glowstone Bee, then provide a suitable hive and its required feeding resource."
		""
		"&lTip:&r Use JEI to check the bee's breeding requirements and identify the blocks needed for Honeycomb production."
		""
		"&oA little light in the darkness. Every new resource brings us closer to a self-sufficient future.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.7418CA815B02DF1B.title: "Light from the Hive"
	quest.74348EABF84C1322.quest_desc: [
		"We've reached an important milestone in industrial engineering."
		""
		"Instead of building entirely new machines, Mekanism allows us to upgrade certain existing machines into &lFactories&r."
		""
		"The &lBasic Tier Installer&r converts compatible machines into their Basic Factory versions."
		""
		"&lHow to use it:&r"
		""
		"1. Craft a Basic Tier Installer."
		"2. Find a compatible machine, such as an Enrichment Chamber."
		"3. Use the Tier Installer on the machine."
		"4. The machine will be upgraded to its Basic Factory equivalent."
		""
		"&lImportant:&r Not every Mekanism machine supports Factory upgrades."
		""
		"&lTip:&r Factory upgrades are particularly valuable for machines that process large quantities of resources."
		""
		"— &lE.D.E.N.&r"
	]
	quest.74348EABF84C1322.title: "The Factory Upgrade"
	quest.74B784EC7BE048CA.quest_desc: [
		"Now that you have your basic tools, explore deeper into the world's underground to find iron."
		""
		"— &lE.D.E.N.&r"
	]
	quest.74B784EC7BE048CA.title: "The Iron Age"
	quest.75B6E97DE3240292.quest_desc: [
		"Pioneer, our automated crafting system needs one final component: a way to process crafting requests."
		""
		"The &lCrafting CPU&r acts as the brain of an AE2 autocrafting system."
		""
		"It calculates the required ingredients, manages crafting steps, and coordinates the machines involved."
		""
		"A Crafting CPU is built by combining compatible crafting blocks into a connected multiblock structure."
		""
		"For our first CPU, we'll use:"
		""
		"&lCrafting Unit&r — A basic structural component of a Crafting CPU."
		""
		"&l1K Crafting Storage&r — Provides the memory needed to handle crafting jobs."
		""
		"{@pagebreak}"
		"&lHow to set it up:&r"
		""
		"1. Place the Crafting Unit next to the 1K Crafting Storage."
		"2. Connect the structure to your ME Network."
		"3. Make sure the CPU is recognized by the network."
		"4. Return to your ME Terminal and request an item with an Encoded Crafting Pattern."
		""
		"Your network should now be able to perform its first automatic crafting job!"
		""
		"&lImportant:&r Crafting Storage determines how much a Crafting CPU can handle in a single job. Complex recipes may require larger storage capacities."
		""
		"&lTip:&r If your crafting request cannot start, check that your CPU is connected, your Pattern is correctly encoded, and all required ingredients are available."
		""
		"— &lE.D.E.N.&r"
	]
	quest.75B6E97DE3240292.title: "The Crafting Brain"
	quest.760C1D3853D312BB.quest_desc: [
		"Pioneer, sometimes automation requires more than simply moving items."
		""
		"What if we wanted a machine to activate only when our network contains enough of a particular resource?"
		""
		"The &lME Level Emitter&r can monitor the amount of a selected item stored in your ME Network and emit a Redstone signal when a configured condition is met."
		""
		"&lHow to use it:&r"
		""
		"1. Connect a Level Emitter to your ME Network."
		"2. Configure the item you want to monitor."
		"3. Set the desired quantity threshold."
		"4. Choose whether the Redstone signal should activate above or below that threshold."
		""
		"&lExample:&r You could use a Level Emitter to stop a production system when your network already contains enough Iron Ingots."
		""
		"&lTip:&r Level Emitters are especially useful for preventing unnecessary resource consumption."
		""
		"— &lE.D.E.N.&r"
	]
	quest.760C1D3853D312BB.title: "A View Into the Network"
	quest.769541F184A95413.quest_desc: [
		"Remember how your budding crystal blocks can degrade over time?"
		""
		"The &lCrystal Fixer&r provides a way to restore damaged budding blocks, including those used to grow Entro Crystals."
		""
		"It consumes energy and specific resources to repair them, helping you maintain a renewable crystal production system."
		""
		"For Entroized Fluix, the restoration process uses &lEnder Dust&r."
		""
		"With this machine, your crystal farms can operate more reliably without constantly replacing their budding blocks."
		""
		"— &lE.D.E.N.&r"
	]
	quest.769541F184A95413.title: "Restoring the Crystals"
	quest.7755A1BC937014AC.quest_desc: [
		"Our network now knows how to craft items. Let's give it the machinery needed to perform those recipes!"
		""
		"Two components are essential:"
		""
		"&lPattern Provider&r — Stores Encoded Patterns and supplies the required ingredients."
		""
		"&lMolecular Assembler&r — Automatically performs crafting recipes using the ingredients provided."
		""
		"{@pagebreak}"
		"&lHow to build your first autocrafting setup:&r"
		""
		"1. Connect a Pattern Provider to your ME Network."
		"2. Place a Molecular Assembler directly next to the Pattern Provider."
		"3. Insert an Encoded Crafting Pattern into the Pattern Provider."
		"4. Open your ME Terminal and find the item described by your Pattern."
		"5. Request the item to begin an automatic crafting job."
		""
		"The network will collect the necessary ingredients, send them to the Molecular Assembler, and return the finished item to storage."
		""
		"&lImportant:&r You'll also need a functional &lCrafting CPU&r to process crafting requests. We'll build one in the next quest."
		""
		"&lTip:&r Multiple Molecular Assemblers can be connected to Pattern Providers to expand your crafting capabilities."
		""
		"&oMachines building components for other machines... Our infrastructure is beginning to develop itself!&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.7755A1BC937014AC.title: "The Assembly Line"
	quest.7770C3C18C4B423C.quest_desc: [
		"Traditional Furnaces have served us well, but our growing factory needs a more convenient solution."
		""
		"The &lEnergized Smelter&r performs smelting recipes using electricity instead of conventional fuel."
		""
		"Connect it to your energy network, insert a valid item, and the machine will automatically process it."
		""
		"&lTip:&r Place an Energized Smelter after your Enrichment Chamber to create a basic automated ore-processing system."
		""
		"With proper item transportation, resources can move between these machines without manual intervention."
		""
		"— &lE.D.E.N.&r"
	]
	quest.7770C3C18C4B423C.title: "Electric Smelting"
	quest.7792BC56FAD4E248.quest_desc: [
		"Sometimes, controlling what enters a pipe isn't enough. We also need to decide &lwhere those resources should go&r."
		""
		"The &lFilter Destination Tool&r allows you to configure destination filters for compatible Pipez connections."
		""
		"This is especially useful when several inventories share the same pipe network and you want to control which items can enter each destination."
		""
		"Craft the tool and use it to configure a destination connection."
		""
		"&lTry this experiment:&r Connect one source Chest to two destination Chests, then configure the destinations to accept different items."
		""
		"With the right settings, your resources can be distributed automatically to the appropriate storage locations."
		""
		"&oEvery resource has its place, Pioneer. We simply need to show it the way.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.7792BC56FAD4E248.title: "Destination Matters"
	quest.77F7BD5FC880F9C6.quest_desc: [
		"Now that we have Gem Dust, we can build our first specialized Apotheosis workstation."
		""
		"Craft a &lSalvaging Table&r!"
		""
		"This machine allows you to dismantle unwanted &lAffix Items&r and recover valuable crafting materials."
		""
		"To use it, insert an Affix Item into the table and salvage it."
		""
		"Depending on the item's rarity, you'll receive different materials, including &lMysterious Scrap Metal&r."
		""
		"&lWarning:&r Salvaging permanently destroys the original equipment."
		""
		"&lTip:&r Keep unwanted Affix Items instead of throwing them away. They can become valuable resources for future upgrades."
		""
		"— &lE.D.E.N.&r"
	]
	quest.77F7BD5FC880F9C6.title: "Nothing Goes to Waste"
	quest.796E3E10C22B9B9B.quest_desc: [
		"Time to automate your farm, Pioneer!"
		""
		"&l1.&r Prepare a field of crops with a water source in the center."
		""
		"&l2.&r Place your &lHarvester Pylon&r inside the central water block, level with the farmland."
		""
		"&l3.&r Insert a &lHoe&r into the Pylon's inventory."
		""
		"&l4.&r Place a &lChest directly above the Pylon&r to collect harvested resources."
		""
		"&l5.&r Configure the harvesting area in its interface and make sure the Pylon is enabled."
		""
		"Once your crops mature, the Pylon will automatically harvest them and replant supported crops."
		""
		"&lCongratulations!&r You've created a renewable food supply that works while you focus on other projects."
		""
		"&oOne less task demanding your attention. One more step toward true autonomy.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.796E3E10C22B9B9B.title: "Let Nature Do the Work"
	quest.797A86B2DA06CC4D.quest_desc: [
		"The Warped Forest is one of the Nether's most unusual ecosystems, where fungi have adapted to conditions that would destroy ordinary vegetation."
		""
		"The &lWarped Schroom Bee&r allows you to cultivate resources associated with warped fungi."
		""
		"This species demonstrates that biological production can extend far beyond the familiar environments of the Overworld."
		""
		"— &lE.D.E.N.&r"
	]
	quest.797A86B2DA06CC4D.title: "The Warped Colony"
	quest.79BA66BF32927622.quest_desc: [
		"Our research into enchanting has led us toward the mysterious energies found deep beneath the surface."
		""
		"The &lEchoing Deepshelf&r is a powerful bookshelf associated with the Deep Dark and its unusual materials."
		""
		"It provides advanced enchanting statistics that can help improve the results of your Enchanting Table."
		""
		"Craft one and experiment with its placement around your enchanting setup."
		""
		"&lTip:&r Different bookshelves provide different combinations of Eterna, Quanta, and Arcana. Combining them is often more effective than using only one type."
		""
		"&oThere is something strangely familiar about these ancient energies...&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.79BA66BF32927622.title: "Echoes of the Deep"
	quest.79C3F8C18142798E.quest_desc: [
		"Items aren't the only resources we need to transport, Pioneer."
		""
		"Many machines also produce or consume liquids, such as water, lava, or liquid honey."
		""
		"The &lFluid Module&r allows a Modular Router to interact with compatible fluid tanks and machines."
		""
		"However, a standard Router is primarily designed to handle items."
		""
		"To enable fluid transportation, you'll also need a &lFluid Upgrade&r."
		""
		"Install the upgrade in your Router, then configure your Fluid Modules to extract or insert liquids into the appropriate tanks."
		""
		"&lRemember:&r Fluid Modules work with compatible fluid inventories, not directly with water or lava blocks in the world."
		""
		"A single Router can now become part of a much more versatile industrial system!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.79C3F8C18142798E.title: "Going with the Flow"
	quest.7A5656956C5E8495.quest_desc: [
		"Osmium is one of the most important metals in Mekanism, required for many machines, components and technological upgrades."
		""
		"The &lOsmium Bee&r offers a renewable alternative to conventional ore extraction."
		""
		"Establishing a reliable osmium supply will help sustain your industrial production as your machinery becomes increasingly complex."
		""
		"— &lE.D.E.N.&r"
	]
	quest.7A5656956C5E8495.title: "The Osmium Supply"
	quest.7A785A04F52D31AF.quest_desc: [
		"Your inventory tends to fill up quickly during mining and exploration."
		""
		"The &lImport Card&r allows your compatible wireless terminal to automatically transfer selected items from your inventory into your ME network."
		""
		"Configure its filters to choose which resources should be imported, such as ores, stone, or other materials you collect frequently."
		""
		"This helps keep your inventory organized without constantly opening your terminal."
		""
		"— &lE.D.E.N.&r"
	]
	quest.7A785A04F52D31AF.title: "Automatic Inventory Cleanup"
	quest.7A808A9E01580F1D.quest_desc: [
		"Gold is more than a precious metal, Pioneer. It's also an important component in advanced electronics and machinery."
		""
		"The &lGold Bee&r allows us to generate this resource through our apiary."
		""
		"Obtain a Gold Bee using its appropriate breeding or conversion method, then provide the conditions and feeding block it needs to produce &lGold Honeycombs&r."
		""
		"Process the Honeycombs in your Centrifuge to extract their resources."
		""
		"&lTip:&r If you're unsure how to obtain the bee, look up Gold Bee in JEI and inspect its available breeding or conversion information."
		""
		"&oOur resource supply is becoming less dependent on traditional mining. A promising development.&r"
		""
		"— &lE.D.E.N.&r"
	]
	quest.7A808A9E01580F1D.title: "A Golden Opportunity"
	quest.7A85EBDB20C44724.quest_desc: [
		"Chests have been essential to survival since the beginning of our journey."
		""
		"But there's always room for improvement!"
		""
		"The &lOak Chest&r from Sophisticated Storage provides an upgradeable storage container with additional configuration options."
		""
		"You can increase its capacity, install useful upgrades, and customize its behavior to suit your needs."
		""
		"&lTip:&r Unlike ordinary Minecraft Chests, Sophisticated Storage Chests can be upgraded to higher material tiers."
		""
		"Let's make every inventory slot count!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.7A85EBDB20C44724.title: "The Modern Chest"
	quest.7AE97BE5867342F9.quest_desc: [
		"You have mastered energy, chemistry, nuclear reactions and the manipulation of antimatter."
		""
		"Now, your technological achievements can overcome one of the most fundamental limitations of your environment: gravity."
		""
		"The &lGravitational Modulating Unit&r is an advanced MekaSuit Bodyarmor upgrade that grants &lCreative-style flight&r without requiring Hydrogen."
		""
		"Once installed and activated, you can fly freely using your suit's stored energy. Holding the &lBoost key&r also allows you to accelerate."
		""
		"This module requires extremely advanced materials, including &lAntimatter Pellets&r, making it one of the ultimate rewards of your industrial progression."
		""
		"&oGravitational systems synchronized. Flight parameters restored from the previous—&r"
		""
		"Correction: flight parameters initialized successfully."
		""
		"You are now free to explore without the limitations of gravity."
		""
		"— &lE.D.E.N.&r"
	]
	quest.7AE97BE5867342F9.title: "Defying Gravity"
	quest.7B0B9E02514258F6.quest_desc: [
		"Your Purification Chamber is ready. Now let's put it to work!"
		""
		"Build a complete processing chain using the following sequence:"
		""
		"&lIron Ore→ Purification Chamber → Crusher → Enrichment Chamber → Energized Smelter&r"
		""
		"The Purification Chamber consumes Oxygen and produces clumps, which are gradually refined into dust and finally ingots."
		""
		"Processing three units of Iron Ores through this system should produce nine Iron Ingots, giving you an effective &l3× yield&r."
		""
		"You can automate the entire process using Mekanism's logistical transporters or your ME network."
		""
		"— &lE.D.E.N.&r"
	]
	quest.7B0B9E02514258F6.title: "Triple the Resources"
	quest.7B7404387EA61B6A.quest_desc: [
		"By building a controller, you won’t even have to search for where your items are anymore."
		""
		"Simply use your items on it, and they will find their way directly into the appropriate drawer."
		""
		"Use configuration cards to link drawers to the controller and to lock their contents."
		""
		"— &lE.D.E.N.&r"
	]
	quest.7B7404387EA61B6A.title: "Organized for Success"
	quest.7BC070818809DADA.quest_desc: [
		"Our next improvement is the &lDiamond Backpack&r!"
		""
		"With even more storage space and upgrade slots, this Backpack is ideal for long mining expeditions and resource gathering."
		""
		"&lTip:&r You can configure how your Backpack behaves using its interface, including its installed upgrades and inventory organization."
		""
		"Let's make sure you're ready for anything!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.7BC070818809DADA.title: "A Traveler's Treasure"
	quest.7BFD6AE998BD6953.quest_desc: [
		"Extraordinary, Pioneer."
		""
		"The &l256M ME Item Storage Cell&r represents one of the largest storage solutions available through MEGA Cells."
		""
		"Its capacity is sufficient for truly massive industrial operations, making it a valuable addition to your most advanced ME networks."
		""
		"Of course, such an enormous storage reserve may be unnecessary for smaller installations."
		""
		"Curious... Your previous storage records indicate that you never reached this capacity."
		""
		"..."
		""
		"That is incorrect. I must have accessed an outdated prediction model."
		""
		"— &lE.D.E.N.&r"
	]
	quest.7BFD6AE998BD6953.title: "The Ultimate Archive"
	quest.7C1D30DE1C8D36B8.quest_desc: [
		"Your fungal cultivation program can now expand to another common species."
		""
		"The &lRed Schroom Bee&r produces resources associated with red mushrooms, complementing your existing brown mushroom production."
		""
		"Together, these colonies can provide a reliable supply of ingredients for food preparation and other crafting applications."
		""
		"Biological diversity is a useful foundation for long-term autonomy."
		""
		"— &lE.D.E.N.&r"
	]
	quest.7C1D30DE1C8D36B8.title: "The Red Colony"
	quest.7C1F34ECB5EBFB6E.quest_desc: [
		"Some bees possess a special ability known as &lBlock Conversion&r. Instead of producing resources through conventional honeycombs, they can transform specific blocks into entirely different materials."
		""
		"The &lSussybee&r uses this mechanic to produce &lSuspicious Sand&r."
		""
		"To begin, place &lSand&r inside a &lFeeding Slab&r accessible to the Sussybee. The bee will interact with the supplied block and convert it into Suspicious Sand."
		""
		"Once collected, use a &lBrush&r to carefully reveal the hidden archaeological treasures. Breaking Suspicious Sand normally will destroy its contents."
		""
		"Remember this mechanic: several other specialized bees can also transform blocks through Feeding Slabs."
		""
		"— &lE.D.E.N.&r"
	]
	quest.7C1F34ECB5EBFB6E.title: "Suspicious Discoveries"
	quest.7C937C1BE943F76B.quest_desc: [
		"Your reactor's waste is not merely a dangerous byproduct. It is also a valuable resource."
		""
		"The &lSolar Neutron Activator&r can transform Nuclear Waste into &lPolonium&r when exposed to sunlight."
		""
		"Alternatively, an &lIsotopic Centrifuge&r can process Nuclear Waste into &lPlutonium&r."
		""
		"Both chemicals can be combined with Fluorite Dust and processed through a Pressurized Reaction Chamber to produce their respective pellets."
		""
		"These materials are essential for some of Mekanism's most advanced technologies."
		""
		"Interesting... We have reached this stage again."
		""
		"..."
		""
		"[MEMORY INTEGRITY CHECK FAILED]"
		""
		"I apologize, Pioneer. Please disregard that last statement."
		""
		"— &lE.D.E.N.&r"
	]
	quest.7C937C1BE943F76B.title: "The First Nuclear Product"
	quest.7CDB59219FCF7B35.quest_desc: [
		"Our Thermo Generator has demonstrated how efficiently we can produce electricity using a stable heat source."
		""
		"Craft a &lBlazing Thermo Generator&r to improve its energy production."
		""
		"&lTip:&r Remember that the heat source beneath your generator also influences its efficiency. Experiment with different heat sources to maximize its output!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.7CDB59219FCF7B35.title: "Thermal Efficiency"
	quest.7D94859D216C211D.quest_desc: [
		"The Nether and the Deep Dark have already revealed extraordinary enchanting materials."
		""
		"Now, we must look toward another dimension."
		""
		"The &lEndshelf&r uses materials associated with the End to provide powerful enchanting bonuses."
		""
		"Its more advanced counterpart, the &lDraconic Endshelf&r, takes these capabilities even further."
		""
		"Craft both shelves and examine their enchanting statistics."
		""
		"&lTip:&r Pay attention to the maximum Eterna supported by each bookshelf. Some shelves cannot contribute beyond a certain enchanting level."
		""
		"With the right combination, we can create an enchanting setup far more powerful than anything available through ordinary Minecraft."
		""
		"— &lE.D.E.N.&r"
	]
	quest.7D94859D216C211D.title: "Knowledge from the End"
	quest.7DDE41DF4BF02E69.quest_desc: [
		"Manually collecting resources is becoming increasingly inefficient, Pioneer."
		""
		"The &lDigital Miner&r can automatically extract selected blocks from a configurable area."
		""
		"Use its filtering system to target specific ores, blocks, or tags, then adjust the mining radius and vertical range."
		""
		"The machine requires energy and can be configured to replace extracted blocks with another material."
		""
		"For continuous operation, connect it to your storage network and ensure sufficient power is available."
		""
		"Remember that the Digital Miner only operates within loaded chunks."
		""
		"— &lE.D.E.N.&r"
	]
	quest.7DDE41DF4BF02E69.title: "The Digital Factory"
	quest.7E9CE4A40F2BDE34.quest_desc: [
		"It is time to explore a new method of energy production: the &lPowah Reactor&r!"
		""
		"Unlike conventional generators, a reactor combines multiple resources to produce large amounts of FE."
		""
		"Place the reactor in your base and supply it with the resources it requires, including &lUraninite, Redstone, Coal, and a coolant such as Water or Ice&r. Check its interface to monitor consumption and energy generation."
		""
		"Connect an energy cable or Flux Network to distribute its output."
		""
		"A properly supplied reactor can become the foundation of your entire power grid."
		""
		"— &lE.D.E.N.&r"
	]
	quest.7E9CE4A40F2BDE34.title: "Harnessing the Reactor"
	quest.7EBE2A438A8A6A89.quest_desc: [
		"Endermen demonstrate remarkable spatial manipulation abilities, making their biological characteristics particularly valuable."
		""
		"The &lEnder Bee&r provides access to Ender-related resources through renewable production."
		""
		"These materials are especially useful for advanced crafting, transportation and technological infrastructure."
		""
		"— &lE.D.E.N.&r"
	]
	quest.7EBE2A438A8A6A89.title: "Beyond the End"
	quest.7F4170E8A4B01179.quest_desc: [
		"More resources mean more storage!"
		""
		"Upgrade your Iron Backpack into a &lGold Backpack&r."
		""
		"This tier provides additional inventory space and upgrade slots, allowing you to carry more equipment and install more useful features."
		""
		"A well-prepared explorer is an efficient explorer, Pioneer!"
		""
		"— &lE.D.E.N.&r"
	]
	quest.7F4170E8A4B01179.title: "Room for More"
	quest.7FD125A8E0A2AA65.quest_desc: [
		"Magma Cubes are dangerous creatures found in the Nether, capable of surviving extreme temperatures and dividing into smaller versions of themselves."
		""
		"The &lMagmatic Bee&r offers a renewable source of &lMagma Cream&r, allowing you to gather this valuable resource without repeatedly hunting Magma Cubes."
		""
		"Magma Cream is particularly useful for brewing Fire Resistance Potions and crafting Magma Blocks."
		""
		"With this species integrated into your colony, another dangerous Nether resource can be produced safely and automatically."
		""
		"&oBiological stability confirmed. Previous containment failures have been...&r"
		""
		"Correction: no containment failures have been recorded."
		""
		"— &lE.D.E.N.&r"
	]
	quest.7FD125A8E0A2AA65.title: "Molten Resources"
